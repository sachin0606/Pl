<Window x:Class="BroadcastPlayout.Entertainment.EntertainmentManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Entertainment Channel Manager (Music + Movie + VOD)"
        Width="1200" Height="780" MinWidth="950" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14" Foreground="#D4D9DF" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A2230"/>
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="BorderBrush" Value="#2D3B4E"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#121820"/>
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="BorderBrush" Value="#2D3B4E"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#121820"/>
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="BorderBrush" Value="#2D3B4E"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#7033D8"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1B7A3E"/>
            <Setter Property="Foreground" Value="#90FFBA"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9BA8B5"/>
            <Setter Property="Background" Value="#0F141C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#101620" BorderBrush="#222C3A" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎬🎵" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="KASHTRIX ENTERTAINMENT PLAYOUT" FontWeight="Bold" FontSize="15" Foreground="#E2E7EE"/>
                        <TextBlock Text="9X Music / B4U / Sony Mix + Sony Max / Star Gold / Zee Cinema Style Automation" FontSize="11" Foreground="#7C8D9E"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1C2738" CornerRadius="4" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtStatusBadge" Text="● ON-AIR AUTOMATION READY" Foreground="#42D392" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <Button Content="Sync With Main Playout" Style="{StaticResource AccentBtn}" Click="SyncWithMain_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABS -->
        <TabControl Grid.Row="1" Background="#0B0F14" BorderThickness="0" Margin="10,6,10,6">
            <!-- TAB 1: MUSIC CHANNEL -->
            <TabItem Header="🎵 MUSIC CHANNEL (9X / B4U / SONY MIX)">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Music Category & Automation Controls -->
                    <Border Grid.Column="0" Background="#101620" BorderBrush="#1F2A38" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="🎵 SMART MUSIC ROTATION" FontWeight="Bold" FontSize="13" Foreground="#9D71E8" Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Channel Theme / Preset:" Foreground="#7C8D9E" Margin="0,4,0,2" FontSize="11"/>
                                <ComboBox x:Name="CmbMusicTheme">
                                    <ComboBoxItem Content="9X Music Style (Non-Stop Hits)" IsSelected="True"/>
                                    <ComboBoxItem Content="B4U Music Style (Bollywood + Retro)"/>
                                    <ComboBoxItem Content="Sony Mix Style (Melody &amp; Ghazals)"/>
                                    <ComboBoxItem Content="Punjabi Beats (Latest Punjabi Hits)"/>
                                    <ComboBoxItem Content="Devotional Morning (Bhakti Sagar)"/>
                                </ComboBox>

                                <TextBlock Text="Select Language:" Foreground="#7C8D9E" Margin="0,10,0,2" FontSize="11"/>
                                <ComboBox x:Name="CmbMusicLang">
                                    <ComboBoxItem Content="All Languages" IsSelected="True"/>
                                    <ComboBoxItem Content="Hindi"/>
                                    <ComboBoxItem Content="Punjabi"/>
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Tamil / Telugu"/>
                                </ComboBox>

                                <TextBlock Text="Smart Playlist Rotation Policy:" Foreground="#7C8D9E" Margin="0,10,0,2" FontSize="11"/>
                                <ComboBox x:Name="CmbMusicPolicy">
                                    <ComboBoxItem Content="Balanced (Hits + Classics 70/30)" IsSelected="True"/>
                                    <ComboBoxItem Content="Top 50 Chartbusters Only"/>
                                    <ComboBoxItem Content="Artist Repeat Guard (Min 60 min gap)"/>
                                    <ComboBoxItem Content="Golden 90s Nostalgia"/>
                                </ComboBox>

                                <Separator Background="#1F2A38" Margin="0,14,0,14"/>

                                <TextBlock Text="📺 LOWER-THIRD NOW PLAYING CG" FontWeight="Bold" FontSize="12" Foreground="#9D71E8" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkMusicLowerThird" Content="Auto-Show Song Title &amp; Artist on screen" IsChecked="True" Foreground="#D4D9DF" Margin="0,4"/>
                                <CheckBox x:Name="ChkNextSongPreview" Content="Show 'Next Song Coming Up' 15s before end" IsChecked="True" Foreground="#D4D9DF" Margin="0,4"/>
                                <CheckBox x:Name="ChkMusicDedicationTicker" Content="Show Viewer Song Dedication Ticker" IsChecked="True" Foreground="#D4D9DF" Margin="0,4"/>

                                <Separator Background="#1F2A38" Margin="0,14,0,14"/>

                                <Button Content="⚡ Generate Auto Music Lineup (24 Hrs)" Style="{StaticResource AccentBtn}" Height="36" Click="GenerateMusicLineup_Click" Margin="0,4"/>
                                <Button Content="📂 Add Music Video Files (.mp4, .mkv)" Click="AddMusicFiles_Click" Margin="0,4"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: Music Playlist Grid -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#141C28" Padding="12,8" CornerRadius="6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎶 Active Music Queue" FontWeight="Bold" FontSize="13" Foreground="#E0E6ED"/>
                                    <TextBlock x:Name="TxtMusicQueueCount" Text=" (Ready to load)" Foreground="#7C8D9E" Margin="6,0,0,0" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Clear Queue" Click="ClearMusicQueue_Click" Margin="0,0,6,0"/>
                                    <Button Content="▶ Play to Air" Style="{StaticResource GreenBtn}" Click="PlayMusicToAir_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="DgMusicQueue" Grid.Row="1" Background="#0C1116" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>
                                <DataGridTextColumn Header="Song Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Singer / Artist" Binding="{Binding Artist}" Width="160"/>
                                <DataGridTextColumn Header="Album / Movie" Binding="{Binding Album}" Width="140"/>
                                <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="100"/>
                                <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="80"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding DurationText, Mode=OneWay}" Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: MOVIE CHANNEL -->
            <TabItem Header="🎬 MOVIE CHANNEL (SONY MAX / STAR GOLD / ZEE CINEMA)">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Movie Scheduling Controls -->
                    <Border Grid.Column="0" Background="#101620" BorderBrush="#1F2A38" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="🎬 MOVIE CHANNEL AUTOMATION" FontWeight="Bold" FontSize="13" Foreground="#F5A623" Margin="0,0,0,10"/>

                                <TextBlock Text="Channel Branding:" Foreground="#7C8D9E" Margin="0,4,0,2" FontSize="11"/>
                                <ComboBox x:Name="CmbMovieBranding">
                                    <ComboBoxItem Content="Sony Max Style (Deewana Bana De)" IsSelected="True"/>
                                    <ComboBoxItem Content="Star Gold Style (Blockbuster Movies)"/>
                                    <ComboBoxItem Content="Zee Cinema Style (Seene Me Cinema)"/>
                                    <ComboBoxItem Content="Action Cinema (South Hindi Dubbed)"/>
                                </ComboBox>

                                <TextBlock Text="Show Band Programming:" Foreground="#7C8D9E" Margin="0,10,0,2" FontSize="11"/>
                                <ComboBox x:Name="CmbShowBand">
                                    <ComboBoxItem Content="Matinee Show (12:00 PM - Comedy/Drama)" IsSelected="True"/>
                                    <ComboBoxItem Content="Super Prime Time (08:00 PM - Mega Blockbuster)"/>
                                    <ComboBoxItem Content="Late Night Thriller (11:30 PM - Action/Horror)"/>
                                    <ComboBoxItem Content="Sunday Special Premier"/>
                                </ComboBox>

                                <Separator Background="#1F2A38" Margin="0,14,0,14"/>

                                <TextBlock Text="📺 MOVIE LOWER-THIRD &amp; PROMOS" FontWeight="Bold" FontSize="12" Foreground="#F5A623" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkMovieCastTicker" Content="Show Lead Cast &amp; Director Banner" IsChecked="True" Foreground="#D4D9DF" Margin="0,4"/>
                                <CheckBox x:Name="ChkComingNextMovie" Content="Coming Up Next Movie Promo Bug" IsChecked="True" Foreground="#D4D9DF" Margin="0,4"/>
                                <CheckBox x:Name="ChkCommercialBreaks" Content="Auto-insert Ad Break Markers (every 25m)" IsChecked="True" Foreground="#D4D9DF" Margin="0,4"/>

                                <Separator Background="#1F2A38" Margin="0,14,0,14"/>

                                <Button Content="⚡ Auto-Plan Today's 4-Movie Schedule" Style="{StaticResource AccentBtn}" Height="36" Click="AutoScheduleMovies_Click" Margin="0,4"/>
                                <Button Content="📂 Add Movie File to Master Library" Click="AddMovieFile_Click" Margin="0,4"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: Scheduled Movies Grid -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#141C28" Padding="12,8" CornerRadius="6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎥 Scheduled Movies Lineup" FontWeight="Bold" FontSize="13" Foreground="#E0E6ED"/>
                                    <TextBlock x:Name="TxtMovieCount" Text=" (Schedule Active)" Foreground="#7C8D9E" Margin="6,0,0,0" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Preview Movie" Click="PreviewMovie_Click" Margin="0,0,6,0"/>
                                    <Button Content="▶ Cue Movie to Playout" Style="{StaticResource GreenBtn}" Click="CueMovieToPlayout_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="DgMovieLineup" Grid.Row="1" Background="#0C1116" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Show Time" Binding="{Binding ScheduledTimeText}" Width="100"/>
                                <DataGridTextColumn Header="Movie Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Cast &amp; Actors" Binding="{Binding Cast}" Width="180"/>
                                <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="100"/>
                                <DataGridTextColumn Header="Director" Binding="{Binding Director}" Width="120"/>
                                <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="60"/>
                                <DataGridTextColumn Header="Runtime" Binding="{Binding DurationText, Mode=OneWay}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: VIEWER ON-DEMAND & REQUESTS -->
            <TabItem Header="📲 VIEWER REQUESTS &amp; DEDICATIONS">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#141C28" Padding="14,10" CornerRadius="6" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="📲 Audience On-Demand &amp; WhatsApp / SMS Request System" FontWeight="Bold" FontSize="13" Foreground="#42D392"/>
                                <TextBlock Text="Viewers can send song requests &amp; personal dedication messages to show on TV ticker." FontSize="11" Foreground="#7C8D9E" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="+ Add Test Request" Click="AddTestRequest_Click" Margin="0,0,6,0"/>
                                <Button Content="Accept &amp; Push to Ticker" Style="{StaticResource AccentBtn}" Click="PushRequestToAir_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="DgRequests" Grid.Row="1" Background="#0C1116" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding RequestTimeText}" Width="90"/>
                            <DataGridTextColumn Header="Viewer Name" Binding="{Binding SenderName}" Width="130"/>
                            <DataGridTextColumn Header="Requested Song / Movie" Binding="{Binding RequestedTitle}" Width="240"/>
                            <DataGridTextColumn Header="Dedication Message (Ticker Text)" Binding="{Binding Message}" Width="*"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#0A0E13" BorderBrush="#1C2532" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="Kashtrix Broadcast Playout · Entertainment Automation Module · Active" Foreground="#5A6C80" FontSize="11"/>
                <TextBlock HorizontalAlignment="Right" Text="Engine: Kashtrix Playout Core" Foreground="#5A6C80" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>