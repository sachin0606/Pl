<Window x:Class="BroadcastPlayout.Views.AudioMixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Audio Mixer" Width="980" Height="640" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-audiomixer.ico">
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
        <Border Background="#10151B" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Width="30" Height="30" Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-audiomixer.png" Stretch="Uniform" Margin="0,0,9,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="AUDIO MIXER" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Broadcast master fader · program meters · preview routing · channel downmix" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Click="Minimize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button><Button Click="Maximize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button><Button Click="Close_Click" Style="{StaticResource WindowCloseButton}"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PROGRAM OUTPUT" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="L / R · PROGRAM PRE-FADER" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel><CheckBox Grid.Column="1" Content="MUTE" IsChecked="{Binding MasterOutputMuted}" Style="{StaticResource ToggleSwitch}"/></Grid>
                    <Grid Grid.Row="1" Margin="8,16,8,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="52"/><ColumnDefinition Width="54"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="8"/><ColumnDefinition Width="16"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Style="{StaticResource BroadcastBlueAudioMeter}" Minimum="0" Maximum="1" Value="{Binding AudioLeftLevel, Mode=OneWay}" Height="330"/>
                            <ProgressBar Grid.Column="2" Style="{StaticResource BroadcastBlueAudioMeter}" Minimum="0" Maximum="1" Value="{Binding AudioRightLevel, Mode=OneWay}" Height="330"/>
                            <Grid Grid.Column="3" Height="330"><TextBlock Text="0" FontSize="7" Foreground="#89949D" VerticalAlignment="Top"/><TextBlock Text="-6" FontSize="7" Foreground="#89949D" Margin="0,48,0,0" VerticalAlignment="Top"/><TextBlock Text="-18" FontSize="7" Foreground="#89949D" VerticalAlignment="Center"/><TextBlock Text="-36" FontSize="7" Foreground="#89949D" Margin="0,0,0,62" VerticalAlignment="Bottom"/><TextBlock Text="-60" FontSize="7" Foreground="#89949D" VerticalAlignment="Bottom"/></Grid>
                        </Grid>
                        <Grid Grid.Column="1" Margin="0,0,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="FADER" Style="{StaticResource SectionCaption}" HorizontalAlignment="Center"/><Slider Grid.Row="1" Style="{StaticResource BroadcastFaderVertical}" Height="330" Value="{Binding MasterOutputVolumePercent, Mode=TwoWay}"/><TextBlock Grid.Row="2" Text="{Binding MasterOutputVolumeText}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" Foreground="#C89BED"/></Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><Border BorderBrush="#2E343A" BorderThickness="1" Height="75" Margin="4"><TextBlock Text="V" Foreground="#6FA6FF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border BorderBrush="#2E343A" BorderThickness="1" Height="75" Margin="4"><TextBlock Text="A" Foreground="#B78BE7" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="L" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="{Binding AudioLeftDb}" FontSize="8" Foreground="#7F8A93" HorizontalAlignment="Center" Margin="0,5,0,14"/><TextBlock Text="R" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="{Binding AudioRightDb}" FontSize="8" Foreground="#7F8A93" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2"><TextBlock Text="PROGRAM DEVICE" Style="{StaticResource SectionCaption}"/><ComboBox ItemsSource="{Binding AudioDevices}" DisplayMemberPath="Label" SelectedValuePath="DeviceNumber" SelectedValue="{Binding ProgramAudioDeviceNumber}" Margin="0,5,0,0"/></StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="PREVIEW / CHANNEL MAPPING" FontSize="16" FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="PREVIEW DEVICE" Style="{StaticResource SectionCaption}"/><ComboBox ItemsSource="{Binding AudioDevices}" DisplayMemberPath="Label" SelectedValuePath="DeviceNumber" SelectedValue="{Binding PreviewAudioDeviceNumber}" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="DOWNMIX / CHANNEL MAP" Style="{StaticResource SectionCaption}"/><ComboBox ItemsSource="{Binding AudioDownmixPresets}" SelectedItem="{Binding AudioDownmixPreset}" Margin="0,5,0,0"/></StackPanel>
                </Grid>
                <Border Grid.Row="2" Background="#0A0E12" BorderBrush="#252C33" BorderThickness="1" Padding="16"><StackPanel>
                    <TextBlock Text="MONITORING" FontWeight="SemiBold"/><TextBlock Text="Program meters are PRE-MASTER-FADER so source activity remains visible even while Master Mute is ON. The master fader/mute still controls every final Program output. Preview audition remains isolated." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    <Separator Margin="0,16"/>
                    <TextBlock Text="CHANNEL POLICY" FontWeight="SemiBold"/><TextBlock Text="7.1 / 5.1 sources decode to the stereo program bus using the selected mapping preset. Master fader and mute are applied after channel routing so NDI, SDI, local output and virtual output stay level matched." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="AUDITION SELECTED" Click="Audition_Click" Background="#2A1640" BorderBrush="{StaticResource AccentBrush}"/><Button Content="STOP PREVIEW" Click="StopPreview_Click"/></StackPanel>
                    <Separator Margin="0,16"/>
                    <TextBlock Text="ACTIVE / SELECTED ITEM PROCESSING" FontWeight="SemiBold"/>
                    <TextBlock Text="Open the same per-item Audio / Video / Decoder properties used by the playout engine. Changes include mono→stereo, audio track/delay/gain, scale/aspect/interlace and CPU/GPU decoder policy." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="ACTIVE ITEM PROPERTIES" Click="ActiveItemProperties_Click"/><Button Content="SELECTED ITEM PROPERTIES" Click="SelectedItemProperties_Click"/></StackPanel>
                    <TextBlock Text="{Binding CurrentItem.MediaPropertiesSummary, TargetNullValue='No active Program item'}" Foreground="#C89BED" FontSize="9" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel></Border>
            </Grid></Border>
        </Grid>
        <Border Grid.Row="2" Background="#0E1318" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><TextBlock Text="Audio changes apply immediately and are shared with the Playout master bus." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0"/></Border>
    </Grid>
</Window>
