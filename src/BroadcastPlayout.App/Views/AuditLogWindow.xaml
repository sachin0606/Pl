<Window x:Class="BroadcastPlayout.Views.AuditLogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Audit Log" Width="1180" Height="720" MinWidth="860" MinHeight="540" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip" Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-audit.ico">
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Background="#0B1016" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="AUDIT LOG · ALL OPERATOR / AUTOMATION RECORDS" VerticalAlignment="Center" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource WindowControlButton}" Click="Minimize_Click"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button><Button Style="{StaticResource WindowControlButton}" Click="Maximize_Click"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button><Button Style="{StaticResource WindowCloseButton}" Click="Close_Click"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button></StackPanel></Grid></Border>
        <Grid Grid.Row="1" Margin="10,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Filter action, item, details, user or machine"/><Button Grid.Column="1" Content="REFRESH" Click="Refresh_Click"/><Button Grid.Column="2" Content="EXPORT CSV" Click="Export_Click"/><Button Grid.Column="3" Content="OPEN LOG FOLDER" Click="OpenFolder_Click"/></Grid>
        <DataGrid x:Name="AuditGrid" Grid.Row="2" Margin="10,0,10,8" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Rows}" RowHeight="28"><DataGrid.Columns><DataGridTextColumn Header="TIME (UTC)" Binding="{Binding TimestampUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}" Width="170"/><DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="150"/><DataGridTextColumn Header="SUBJECT" Binding="{Binding Subject}" Width="220"/><DataGridTextColumn Header="DETAILS" Binding="{Binding Details}" Width="3*"/><DataGridTextColumn Header="USER" Binding="{Binding User}" Width="110"/><DataGridTextColumn Header="MACHINE" Binding="{Binding Machine}" Width="130"/></DataGrid.Columns></DataGrid>
        <Border Grid.Row="3" Background="#0B1016" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></Border>
    </Grid>
</Window>
