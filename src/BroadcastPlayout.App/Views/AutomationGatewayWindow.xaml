<Window x:Class="BroadcastPlayout.Views.AutomationGatewayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Automation / MOS / Signals" Width="920" Height="680" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" Background="#090D11">
    <Border BorderBrush="Transparent" BorderThickness="0" Background="#090D11">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#0C1116" BorderBrush="#20272E" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="K" Foreground="#C34BD6" FontSize="20" FontWeight="Bold" Margin="0,0,8,0"/><TextBlock Text="AUTOMATION · MOS · TCP · SIGNALS" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    <Button Grid.Column="1" Content="✕" Click="Close_Click" Width="32" Height="25" Padding="0"/>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Margin="12" Background="Transparent" BorderThickness="0">
                <TabItem Header="GATEWAY">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4">
                        <Border Style="{StaticResource PanelBorder}" Padding="14"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TCP CONTROL LISTENER" FontWeight="SemiBold" Foreground="#DAB7F5"/>
                                <TextBlock Text="PORT" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/>
                                <TextBox x:Name="CommandPortBox" Text="9101"/>
                                <TextBlock Text="Line-oriented commands: PLAY, PAUSE, STOP, NEXT, TAKE n, CUE, CG SHOW/HIDE, LOGO ON/OFF." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MOS 2.8.x LEGACY SOCKET" FontWeight="SemiBold" Foreground="#DAB7F5"/>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="LOWER / NCS TARGET" Style="{StaticResource SectionCaption}"/><TextBox x:Name="MosLowerPortBox" Text="10540" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="UPPER / KASHTRIX LISTEN" Style="{StaticResource SectionCaption}"/><TextBox x:Name="MosUpperPortBox" Text="10541" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Legacy MOS convention: 10540 = NCS media-object/metadata port; 10541 = MOS running-order listener; 10542 is the corresponding top port where required by a profile." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid></Border>

                        <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="MOS DEVICE ID" Style="{StaticResource SectionCaption}"/><TextBox x:Name="MosIdBox" Text="KASHTRIX.PLAYOUT" Margin="0,4,0,10"/><TextBlock Text="NCS ID" Style="{StaticResource SectionCaption}"/><TextBox x:Name="NcsIdBox" Text="KASHTRIX.NCS" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="NCS HOST / OUTBOUND MOS TARGET" Style="{StaticResource SectionCaption}"/><TextBox x:Name="NcsHostBox" Text="127.0.0.1" Margin="0,4,0,10"/><CheckBox x:Name="AutoStartCheckBox" Content="Start automation gateway with Playout" Margin="0,0,0,8"/><TextBlock x:Name="GatewayStatusText" Text="STOPPED" Foreground="#FFB84D" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="START / APPLY" Click="Start_Click" BorderBrush="{StaticResource GoodBrush}"/><Button Content="STOP" Click="Stop_Click"/><Button Content="SAVE PROFILE" Click="SaveProfile_Click"/></StackPanel></StackPanel>
                        </Grid></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>

                <TabItem Header="TCP CONTROL">
                    <StackPanel Margin="4">
                        <Border Style="{StaticResource PanelBorder}" Padding="14"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="REMOTE HOST" Style="{StaticResource SectionCaption}"/><TextBox x:Name="TcpHostBox" Text="127.0.0.1" Margin="0,4,0,10"/><TextBlock Text="COMMAND" Style="{StaticResource SectionCaption}"/><TextBox x:Name="TestCommandBox" Text="PLAY" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="REMOTE PORT" Style="{StaticResource SectionCaption}"/><TextBox x:Name="TcpTargetPortBox" Text="9101" Margin="0,4,0,10"/><Button Content="SEND TCP" Click="SendTcp_Click"/><Button Content="EXECUTE LOCAL" Click="Execute_Click"/></StackPanel>
                        </Grid></Border>
                        <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock Text="COMMAND REFERENCE" FontWeight="SemiBold"/><TextBlock Text="PLAY · PAUSE · STOP · NEXT · TAKE 1..n · CUE · CG SHOW · CG HIDE · LOGO ON · LOGO OFF" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="TCP is intentionally a simple operator/API transport; use MOS for newsroom running-order/object exchange." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="MOS TEST">
                    <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource PanelBorder}" Padding="12"><StackPanel><TextBlock Text="MOS SOCKET TEST / NRCS INTEGRATION" FontWeight="SemiBold"/><TextBlock Text="Kashtrix listens for running-order traffic on the configured upper port and can send test/object traffic to the NCS lower port. Vendor-specific MOS profiles still need interoperability testing with the target NRCS." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,8"/><StackPanel Orientation="Horizontal"><Button Content="LOAD roCreate SAMPLE" Click="LoadMosSample_Click"/><Button Content="SEND TO NCS LOWER PORT" Click="SendMos_Click"/></StackPanel></StackPanel></Border>
                        <TextBox x:Name="MosXmlBox" Grid.Row="1" Margin="0,10,0,0" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"/>
                    </Grid>
                </TabItem>

                <TabItem Header="DTMF / TONES">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PanelBorder}" Padding="14"><StackPanel>
                            <TextBlock Text="DTMF KEYPAD" FontWeight="SemiBold" Foreground="#DAB7F5"/>
                            <UniformGrid Columns="4" Rows="4" Margin="0,12,0,10">
                                <Button Content="1" Click="DtmfKey_Click"/><Button Content="2" Click="DtmfKey_Click"/><Button Content="3" Click="DtmfKey_Click"/><Button Content="A" Click="DtmfKey_Click"/>
                                <Button Content="4" Click="DtmfKey_Click"/><Button Content="5" Click="DtmfKey_Click"/><Button Content="6" Click="DtmfKey_Click"/><Button Content="B" Click="DtmfKey_Click"/>
                                <Button Content="7" Click="DtmfKey_Click"/><Button Content="8" Click="DtmfKey_Click"/><Button Content="9" Click="DtmfKey_Click"/><Button Content="C" Click="DtmfKey_Click"/>
                                <Button Content="*" Click="DtmfKey_Click"/><Button Content="0" Click="DtmfKey_Click"/><Button Content="#" Click="DtmfKey_Click"/><Button Content="D" Click="DtmfKey_Click"/>
                            </UniformGrid>
                            <TextBlock Text="SEQUENCE" Style="{StaticResource SectionCaption}"/><TextBox x:Name="DtmfSequenceBox" Text="1234#" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal"><Button Content="TEST DTMF" Click="TestDtmf_Click" BorderBrush="#A96AE8"/><Button Content="CLEAR" Click="ClearDtmf_Click"/></StackPanel>
                        </StackPanel></Border>
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource PanelBorder}" Padding="14"><StackPanel>
                                <TextBlock Text="DTMF TIMING / LEVEL" FontWeight="SemiBold"/>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="TONE ms" Style="{StaticResource SectionCaption}"/><TextBox x:Name="DtmfToneMsBox" Text="120" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="GAP ms" Style="{StaticResource SectionCaption}"/><TextBox x:Name="DtmfGapMsBox" Text="55" Margin="0,4,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="LEVEL %" Style="{StaticResource SectionCaption}"/><TextBox x:Name="DtmfLevelBox" Text="72" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                                <TextBlock Text="DTMF uses the standard 4×4 low/high tone matrix: 697/770/852/941 Hz × 1209/1336/1477/1633 Hz. A–D are included for control/legacy applications." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0"><StackPanel>
                                <TextBlock Text="LINE / DIAL TONE TEST" FontWeight="SemiBold"/>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DURATION ms" Style="{StaticResource SectionCaption}"/><TextBox x:Name="DialDurationBox" Text="2500" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="LEVEL %" Style="{StaticResource SectionCaption}"/><TextBox x:Name="DialLevelBox" Text="55" Margin="0,4,0,0"/></StackPanel></Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="DIAL 350+440" Click="TestDialTone_Click"/><Button Content="1 kHz LINE-UP" Click="TestLineTone_Click"/></StackPanel>
                                <TextBlock Text="Tone tests pass through the same Program audio meter/output routing as playout, so they also verify the L/R/M meters." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel></Border>
                        </StackPanel>
                    </Grid></ScrollViewer>
                </TabItem>

                <TabItem Header="LIVE LOG">
                    <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="GATEWAY / SIGNAL ACTIVITY" Foreground="#DAB7F5" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="CLEAR" Click="ClearLog_Click" Height="24" MinHeight="24"/></Grid><ListBox x:Name="LogList" Grid.Row="1" Background="#070B10" FontFamily="Consolas" FontSize="10" Margin="0,5,0,0"/></Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" BorderBrush="#20272E" BorderThickness="0,1,0,0" Background="#0B1015"><TextBlock Text="Kashtrix automation signaling · saved profile: %LOCALAPPDATA%\KashtrixPlayout\automation-gateway.json" Foreground="#66727B" FontSize="9" Margin="12,0" VerticalAlignment="Center"/></Border>
        </Grid>
    </Border>
</Window>
