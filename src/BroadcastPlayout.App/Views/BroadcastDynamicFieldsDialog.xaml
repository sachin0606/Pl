<Window x:Class="BroadcastPlayout.Views.BroadcastDynamicFieldsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BROADCAST DYNAMIC FIELDS"
        Width="680" Height="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="FieldCheckStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#B78BE7"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DayRadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- Chrome Header Bar with Tab Buttons -->
            <Border Grid.Row="0" Background="#181122" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="DYNAMIC BROADCAST FIELDS" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <!-- Tab Switcher -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="TabNowNextBtn" Content="NOW / NEXT FIELDS" Click="TabNowNext_Click"
                                Background="#3E2359" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="12,6" Margin="0,0,6,0" Cursor="Hand"/>
                        <Button x:Name="TabWeatherBtn" Content="WEATHER FIELDS" Click="TabWeather_Click"
                                Background="#251B31" BorderThickness="0" Foreground="#B78BE7" FontWeight="SemiBold" FontSize="11" Padding="12,6" Cursor="Hand"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="✕" Width="28" Height="26" Click="Close_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Main Content Area with Tab Controls -->
            <Grid Grid.Row="1" Margin="20,14">
                <!-- TAB 1: NOW / NEXT FIELDS -->
                <Grid x:Name="NowNextPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- NOW COLUMN -->
                        <StackPanel Grid.Column="0" Margin="10,0">
                            <TextBlock Text="NOW PLAYING FIELDS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14"/>
                            <CheckBox x:Name="NowPlayingCheck" Content="Now Playing Item" IsChecked="True" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="NowDescriptionCheck" Content="Now Item Description" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="NowGenreCheck" Content="Now Item Genre" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="NowYearCheck" Content="Now Item Year" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="NowPosterCheck" Content="Now Item Poster (Image)" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="NowVideoCheck" Content="Now Item Video" Style="{StaticResource FieldCheckStyle}"/>
                        </StackPanel>

                        <!-- Center Divider -->
                        <Border Grid.Column="1" Background="{StaticResource LineBrush}"/>

                        <!-- NEXT COLUMN -->
                        <StackPanel Grid.Column="2" Margin="20,0,10,0">
                            <TextBlock Text="NEXT PROGRAM FIELDS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14"/>
                            <CheckBox x:Name="NextItemCheck" Content="Next Item" IsChecked="True" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="NextStartTimeCheck" Content="Start Time Of Next Item" IsChecked="True" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="NextDescriptionCheck" Content="Next Item Description" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="NextGenreCheck" Content="Next Item Genre" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="NextYearCheck" Content="Next Item Year" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="NextPosterCheck" Content="Next Item Poster (Image)" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="NextVideoCheck" Content="Next Item Video" Style="{StaticResource FieldCheckStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Now/Next Quick Sync Buttons -->
                    <Border Grid.Row="1" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="SELECT ALL NOW" Click="SelectAllNow_Click" Width="125" Height="26" Margin="0,0,8,0"
                                        Background="#251B31" BorderBrush="{StaticResource AccentBrush}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="10.5" Cursor="Hand"/>
                                <Button Content="COPY TO NEXT" Click="SameInNext_Click" Width="120" Height="26"
                                        Background="#251B31" BorderBrush="{StaticResource AccentBrush}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="10.5" Cursor="Hand"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource LineBrush}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="COPY TO NOW" Click="SameInCurrent_Click" Width="120" Height="26" Margin="0,0,8,0"
                                        Background="#251B31" BorderBrush="{StaticResource AccentBrush}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="10.5" Cursor="Hand"/>
                                <Button Content="SELECT ALL NEXT" Click="SelectAllNext_Click" Width="125" Height="26"
                                        Background="#251B31" BorderBrush="{StaticResource AccentBrush}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="10.5" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 2: WEATHER FIELDS -->
                <Grid x:Name="WeatherPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Weather Column 1 -->
                        <StackPanel Grid.Column="0" Margin="10,0">
                            <TextBlock Text="METEOROLOGICAL FIELDS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14"/>
                            <CheckBox x:Name="TemperatureCheck" Content="Temperature" IsChecked="True" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="TempMinCheck" Content="Temp Min" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="TempMaxCheck" Content="Temp Max" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="FeelsLikeCheck" Content="Feels Like" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="WindSpeedCheck" Content="Wind Speed" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="CityNameCheck" Content="City Name" Style="{StaticResource FieldCheckStyle}"/>
                        </StackPanel>

                        <!-- Center Divider -->
                        <Border Grid.Column="1" Background="{StaticResource LineBrush}"/>

                        <!-- Weather Column 2 -->
                        <StackPanel Grid.Column="2" Margin="20,0,10,0">
                            <TextBlock Text="CONDITIONS &amp; DATES" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14"/>
                            <CheckBox x:Name="ConditionCheck" Content="Condition" IsChecked="True" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="PressureCheck" Content="Pressure" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="HumidityCheck" Content="Humidity" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="CloudsCheck" Content="Clouds (%)" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="WeatherImageCheck" Content="Weather Image" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="DateCheck" Content="Date" Style="{StaticResource FieldCheckStyle}"/>
                            <CheckBox x:Name="DayCheck" Content="Day" Style="{StaticResource FieldCheckStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Multi-Day Section & Weather Select All -->
                    <Border Grid.Row="1" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox x:Name="MultiDayCheck" Content="Add Multiple Days Weather Single City" IsChecked="True"
                                          Style="{StaticResource FieldCheckStyle}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="Days2Radio" Content="2" GroupName="WeatherDaysGroup" Style="{StaticResource DayRadioStyle}"/>
                                    <RadioButton x:Name="Days3Radio" Content="3" GroupName="WeatherDaysGroup" IsChecked="True" Style="{StaticResource DayRadioStyle}"/>
                                    <RadioButton x:Name="Days4Radio" Content="4" GroupName="WeatherDaysGroup" Style="{StaticResource DayRadioStyle}"/>
                                    <RadioButton x:Name="Days5Radio" Content="5" GroupName="WeatherDaysGroup" Style="{StaticResource DayRadioStyle}"/>
                                    <TextBlock Text="days" Foreground="{StaticResource MutedBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="-6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="SELECT ALL WEATHER" Click="SelectAllWeather_Click" Width="150" Height="28"
                                    Background="#251B31" BorderBrush="{StaticResource AccentBrush}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom Action Footer -->
            <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Changes apply live to CG and playout dynamic text bindings." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="CANCEL" Click="Cancel_Click" Width="90" Height="32" Margin="0,0,8,0"
                                Background="#251B31" BorderBrush="{StaticResource LineBrush}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Cursor="Hand"/>
                        <Button Content="APPLY &amp; SAVE" Click="ApplySave_Click" Width="125" Height="32"
                                Background="#3E2359" BorderBrush="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
