<Window x:Class="BroadcastPlayout.Views.CgControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix CG Controller" Width="1360" Height="820" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True" Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-cgcontroller.ico">
    <Window.Resources>
        <Style x:Key="BusButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="42"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="11.5"/><Setter Property="Margin" Value="2"/></Style>
        <Style x:Key="BusPanel" TargetType="Border" BasedOn="{StaticResource PanelBorder}"><Setter Property="Padding" Value="6"/><Setter Property="CornerRadius" Value="3"/></Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Bg0Brush}">
    <Grid x:Name="ControllerShellGrid" Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition x:Name="ControllerWorkspaceRow" Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0E1115" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-cgcontroller.png" Width="34" Height="34" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="KASHTRIX CG CONTROLLER" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Multi-overlay graphics playback · dynamic layers · live broadcast switcher" Foreground="{StaticResource MutedBrush}" FontSize="9.5"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Menu Background="Transparent" Foreground="White" Margin="0,0,8,0"><MenuItem Header="PANELS"><MenuItem x:Name="PreviewPanelMenu" Header="Preview Bus" IsCheckable="True" IsChecked="True" Tag="Preview" Click="ToggleControllerPanel_Click"/><MenuItem x:Name="SwitcherPanelMenu" Header="Switcher" IsCheckable="True" IsChecked="True" Tag="Switcher" Click="ToggleControllerPanel_Click"/><MenuItem x:Name="ProgramPanelMenu" Header="Program Bus" IsCheckable="True" IsChecked="True" Tag="Program" Click="ToggleControllerPanel_Click"/><Separator/><MenuItem x:Name="CatalogPanelMenu" Header="CG Catalog" IsCheckable="True" IsChecked="True" Tag="Catalog" Click="ToggleControllerPanel_Click"/><MenuItem x:Name="LayersPanelMenu" Header="Layers" IsCheckable="True" IsChecked="True" Tag="Layers" Click="ToggleControllerPanel_Click"/><MenuItem x:Name="TargetsPanelMenu" Header="Targets / Output" IsCheckable="True" IsChecked="True" Tag="Targets" Click="ToggleControllerPanel_Click"/><Separator/><MenuItem Header="Restore All Panels" Click="RestoreControllerPanels_Click"/></MenuItem></Menu><TextBlock x:Name="ClockText" Style="{StaticResource DigitalClockText}" FontSize="22" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/><Button Content="CONNECT" Click="Connect_Click"/><Button Content="REFRESH" Click="Refresh_Click"/><Button Click="Minimize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button><Button Click="Maximize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button><Button Click="Close_Click" Style="{StaticResource WindowCloseButton}"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button></StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ControllerWorkspaceGrid" Grid.Row="1" Margin="8,6">
            <Grid.RowDefinitions><RowDefinition x:Name="SwitcherRow" Height="1.35*" MinHeight="380"/><RowDefinition x:Name="ControllerRowSplitter" Height="8"/><RowDefinition x:Name="LowerRow" Height="*" MinHeight="260"/></Grid.RowDefinitions>
            <Grid x:Name="SwitcherGrid" Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewColumn"/><ColumnDefinition x:Name="SwitcherColumn" Width="245"/><ColumnDefinition x:Name="ProgramColumn"/></Grid.ColumnDefinitions>
                <Border x:Name="PreviewBusPanel" Grid.Column="0" Style="{StaticResource BusPanel}" BorderBrush="#6E45A1" Margin="0,0,6,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PREVIEW BUS" FontSize="15" FontWeight="Bold" Foreground="#C89BED" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding PreviewProjectName}" Foreground="#B7C0C8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/></Grid>
                        <Grid Grid.Row="1" Background="#05070A" ClipToBounds="True"><Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="640" Height="360" Background="Black" BorderBrush="#31204A" BorderThickness="1" CornerRadius="2"><Grid Width="640" Height="360" Background="#05070A"><Image x:Name="PreviewCgImage" Stretch="Uniform"/><Border BorderBrush="#47305F" BorderThickness="2" Margin="8" IsHitTestVisible="False"/></Grid></Border></Viewbox></Grid>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="PLAY PREVIEW" Click="PreviewPlay_Click" Style="{StaticResource BusButton}" Background="#2B1740" BorderBrush="#7445A8"/><Button Grid.Column="1" Content="STOP" Click="PreviewStop_Click" Style="{StaticResource BusButton}" Background="#352618" BorderBrush="#9E682B" ToolTip="Play out-animation and stop"/><Button Grid.Column="2" Content="CLEAR" Click="PreviewClear_Click" Style="{StaticResource BusButton}"/></Grid>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="0" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="#1B222C" ShowsPreview="True" Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>

                <Border x:Name="SwitcherPanel" Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="6,0" Padding="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SWITCHER" HorizontalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#DCC7F0" Margin="0,0,0,8"/>
                        <Button Content="AUTO" Click="AutoToProgram_Click" Style="{StaticResource BusButton}" Background="#28394D" BorderBrush="#4D85B9" ToolTip="TAKE using selected transition; Fade if None"/>
                        <Button Content="CUT" Click="CutToProgram_Click" Style="{StaticResource BusButton}" Background="#31373D" BorderBrush="#77828C" ToolTip="Immediate TAKE with no transition"/>
                        <Button Content="TAKE" Click="TakeToProgram_Click" Style="{StaticResource BusButton}" Background="#522B70" BorderBrush="#B06FE2" ToolTip="TAKE PREVIEW TO PROGRAM using selected optional transition"/>
                        <TextBlock Text="TAKE TRANSITION" Style="{StaticResource SectionCaption}" Margin="0,10,0,3"/>
                        <ComboBox ItemsSource="{Binding TakeTransitions}" SelectedItem="{Binding TakeTransition, Mode=TwoWay}"/>
                        <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions><TextBlock Text="DURATION SEC" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding TakeTransitionSeconds, UpdateSourceTrigger=LostFocus}"/></Grid>
                        <TextBlock Text="None keeps current direct/additive TAKE." Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="#1B222C" ShowsPreview="True" Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>

                <Border x:Name="ProgramBusPanel" Grid.Column="2" Style="{StaticResource BusPanel}" BorderBrush="#A7434E" Margin="6,0,0,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PROGRAM BUS" FontSize="15" FontWeight="Bold" Foreground="#FF7777" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ProgramProjectName}" Foreground="#E0B5B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/></Grid>
                        <Grid Grid.Row="1" Background="#05070A" ClipToBounds="True"><Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="640" Height="360" Background="Black" BorderBrush="#4A282D" BorderThickness="1" CornerRadius="2"><Grid Width="640" Height="360" Background="#05070A"><Image x:Name="ProgramCgImage" Stretch="Uniform"/><Border BorderBrush="#6B3036" BorderThickness="2" Margin="8" IsHitTestVisible="False"/></Grid></Border></Viewbox></Grid>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="PLAY PROGRAM" Click="ProgramPlay_Click" Style="{StaticResource BusButton}" Background="#3A1417" BorderBrush="#A7434E"/><Button Grid.Column="1" Content="STOP" Click="ProgramStop_Click" Style="{StaticResource BusButton}" Background="#3D2111" BorderBrush="#C76E2A" ToolTip="Animate OUT gracefully and stop"/><Button Grid.Column="2" Content="UPDATE" Click="ProgramUpdate_Click" Style="{StaticResource BusButton}"/><Button Grid.Column="3" Content="CLEAR" Click="ProgramClear_Click" Style="{StaticResource BusButton}"/></Grid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#1B222C" ShowsPreview="True" Cursor="SizeNS"/>

            <Grid x:Name="LowerPanelsGrid" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition x:Name="CatalogColumn" Width="1.35*"/><ColumnDefinition x:Name="CatalogLayerGap" Width="8"/><ColumnDefinition x:Name="LayersColumn" Width="1.1*"/><ColumnDefinition x:Name="LayersTargetsGap" Width="8"/><ColumnDefinition x:Name="TargetsColumn" Width="1.3*"/></Grid.ColumnDefinitions>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#1B222C" ShowsPreview="True" Cursor="SizeWE"/>
                <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#1B222C" ShowsPreview="True" Cursor="SizeWE"/>
                <Border x:Name="CatalogPanel" Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="9">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="CG CATALOG" FontWeight="SemiBold"/><TextBlock Text="  ·  complete projects" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="LIST" Click="CatalogList_Click" Height="24" MinWidth="50" Padding="8,0"/><Button Content="GRID" Click="CatalogGrid_Click" Height="24" MinWidth="50" Padding="8,0"/></StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TreeView x:Name="CatalogTree" Visibility="{Binding CatalogListVisibility}" ItemsSource="{Binding CatalogGroups}" SelectedItemChanged="CatalogTree_SelectedItemChanged" Background="#080C10" BorderBrush="#303842" BorderThickness="1">
                                <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Projects}"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></HierarchicalDataTemplate></TreeView.ItemTemplate>
                            </TreeView>
                            <ListBox x:Name="CatalogGrid" Visibility="{Binding CatalogGridVisibility}" ItemsSource="{Binding CatalogCards}" SelectedItem="{Binding SelectedCatalogCard, Mode=TwoWay}" Background="#080C10" BorderBrush="#303842" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate><DataTemplate><Border Width="176" Margin="5" Padding="6" Background="#0D131A" BorderBrush="#34404C" BorderThickness="1" CornerRadius="3"><StackPanel><Border Width="162" Height="91" Background="Black"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Border><TextBlock Text="{Binding Project.Name}" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Foreground="{StaticResource MutedBrush}" FontSize="8.5"><Run Text="{Binding Category, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Details, Mode=OneWay}"/></TextBlock></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="IMPORT CG" Click="ImportCg_Click" Margin="0,0,3,0" ToolTip="Import external CG template or project file (.json, .cgproj, .kcg)"/>
                            <Button Grid.Column="1" Content="RELOAD" Click="ReloadCatalog_Click" Margin="3,0,3,0" ToolTip="Reload all CG templates from database and factory defaults"/>
                            <Button Grid.Column="2" Content="DESIGNER" Click="OpenDesigner_Click" Margin="3,0,0,0" ToolTip="Launch standalone CG Editor"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="LayersPanel" Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="6">
                    <TabControl x:Name="MiddlePanelTabs" Background="Transparent" BorderThickness="0">
                        <TabItem Header="LAYERS · SELECTED CG">
                            <Grid Margin="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
                                <ListBox Grid.Row="0" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer, Mode=TwoWay}" Background="#080C10" BorderBrush="#303842" BorderThickness="1">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#16222E" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StartSeconds, StringFormat={}{0:0.00}s}" Foreground="#7EE787" FontSize="8.5" FontFamily="Consolas"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Type}" Foreground="{StaticResource MutedBrush}" FontSize="8.5"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="#261A3A" BorderBrush="#503070" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EndSeconds, StringFormat={}{0:0.00}s}" Foreground="#B98CF1" FontSize="8.5" FontFamily="Consolas"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="1" Background="#0A0E13" BorderBrush="#28313A" BorderThickness="1" Padding="7" Margin="0,6,0,0"><StackPanel><TextBlock Text="{Binding SelectedLayer.Name, TargetNullValue='No layer selected'}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedLayer.Text}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="42"/><TextBlock Text="PLAY routes the complete selected CG project as one composition; this list is for layer inspection." Foreground="#7B8894" FontSize="9"/></StackPanel></Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="OVERLAYS">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="6">
                                    <TextBlock Text="MULTI-OVERLAY MANAGER" FontWeight="SemiBold" FontSize="13" Foreground="#DCC7F0" Margin="0,0,0,3"/>
                                    <TextBlock Text="Select, add, and clear dynamic graphic overlays." Foreground="{StaticResource MutedBrush}" FontSize="9.5" Margin="0,0,0,8"/>
                                    <Border Background="#1C1428" BorderBrush="#7445A8" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding CurrentOverlayTitle}" Foreground="#DCC7F0" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                    <TextBlock Text="SELECT ACTIVE OVERLAY CHANNEL:" Style="{StaticResource SectionCaption}" Margin="0,2,0,4"/>
                                    <ItemsControl ItemsSource="{Binding ActiveOverlayLayers}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding StringFormat='OVERLAY {0}'}" Tag="{Binding}" Click="SelectOverlayLayer_Click" Width="110" Height="32" Margin="3" Padding="0" Background="#251B31" BorderBrush="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ ADD OVERLAY CHANNEL" Click="AddOverlayLayer_Click" Width="190" Height="32" Margin="3,8,0,0" HorizontalAlignment="Left" Background="#3E2359" BorderBrush="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                    <Separator Margin="0,10"/>
                                    <Button Content="CLEAR CURRENT OVERLAY" Click="ProgramClear_Click" Height="32" Margin="0,2" Background="#251B31" BorderBrush="{StaticResource LineBrush}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                    <Button Content="CLEAR ALL OVERLAYS" Click="ClearAllOverlays_Click" Height="32" Margin="0,3" Background="#3E2359" BorderBrush="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="QUICK EDIT">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="6">
                                    <TextBlock Text="QUICK EDIT &amp; PROPERTIES" FontWeight="SemiBold" FontSize="13" Foreground="#DCC7F0" Margin="0,0,0,2"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding SelectedLayer.Name, TargetNullValue='No layer selected'}" Foreground="#B98CF1" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                        <TextBlock Text="{Binding SelectedLayerTypeBadge}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Placeholder when no layer is selected -->
                                    <Border Visibility="{Binding NoLayerSelectedVisibility}" Background="#121822" BorderBrush="#253242" BorderThickness="1" CornerRadius="3" Padding="14" Margin="0,8">
                                        <TextBlock Text="Select a layer from the LAYERS tab to edit its context-sensitive properties." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="10"/>
                                    </Border>

                                    <!-- Properties panel when a layer is selected -->
                                    <StackPanel Visibility="{Binding LayerSelectedVisibility}">
                                        <!-- 1. TEXT LAYER CONTROLS -->
                                        <StackPanel Visibility="{Binding TextSectionVisibility}">
                                            <TextBlock Text="TEXT / TITLE CONTENT" Style="{StaticResource SectionCaption}" Margin="0,2,0,2"/>
                                            <TextBox Text="{Binding QuickEditTextValue, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" Margin="0,0,0,5"/>

                                            <TextBlock Text="TEXT COLOR (FILL HEX)" Style="{StaticResource SectionCaption}" Margin="0,2,0,2"/>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding QuickEditFillValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="WHITE" Tag="#FFFFFFFF" Click="QuickColorSwatch_Click" Height="22" Padding="5,0" Margin="1,0"/>
                                                    <Button Content="YELLOW" Tag="#FFFFD700" Click="QuickColorSwatch_Click" Height="22" Padding="5,0" Margin="1,0"/>
                                                    <Button Content="RED" Tag="#FFFF3333" Click="QuickColorSwatch_Click" Height="22" Padding="5,0" Margin="1,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="BACKGROUND / PLATE COLOR (HEX)" Style="{StaticResource SectionCaption}" Margin="0,2,0,2"/>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding QuickEditBgValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="NAVY" Tag="#FF0B1728" Click="QuickBgSwatch_Click" Height="22" Padding="5,0" Margin="1,0"/>
                                                    <Button Content="DARK RED" Tag="#FF4A0E13" Click="QuickBgSwatch_Click" Height="22" Padding="5,0" Margin="1,0"/>
                                                    <Button Content="GOLD" Tag="#FF9C7118" Click="QuickBgSwatch_Click" Height="22" Padding="5,0" Margin="1,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,2,0,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="FONT SIZE" Style="{StaticResource SectionCaption}" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding QuickEditFontSizeValue, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="OPACITY (0-1)" Style="{StaticResource SectionCaption}" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding QuickEditOpacityValue, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- 2. SHAPE LAYER CONTROLS -->
                                        <StackPanel Visibility="{Binding ShapeSectionVisibility}">
                                            <TextBlock Text="SHAPE FILL COLOR (HEX)" Style="{StaticResource SectionCaption}" Margin="0,2,0,2"/>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding QuickEditBgValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="NAVY" Tag="#FF0B1728" Click="QuickBgSwatch_Click" Height="22" Padding="5,0" Margin="1,0"/>
                                                    <Button Content="DARK RED" Tag="#FF4A0E13" Click="QuickBgSwatch_Click" Height="22" Padding="5,0" Margin="1,0"/>
                                                    <Button Content="GOLD" Tag="#FF9C7118" Click="QuickBgSwatch_Click" Height="22" Padding="5,0" Margin="1,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="STROKE / BORDER COLOR (HEX)" Style="{StaticResource SectionCaption}" Margin="0,2,0,2"/>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding QuickEditBorderColorValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="ACCENT" Tag="#FF8055B3" Click="QuickBgSwatch_Click" Height="22" Padding="5,0" Margin="1,0"/>
                                                    <Button Content="WHITE" Tag="#FFFFFFFF" Click="QuickBgSwatch_Click" Height="22" Padding="5,0" Margin="1,0"/>
                                                    <Button Content="CLEAR" Tag="#00000000" Click="QuickBgSwatch_Click" Height="22" Padding="5,0" Margin="1,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,2,0,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="BORDER WIDTH" Style="{StaticResource SectionCaption}" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding QuickEditBorderWidthValue, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="CORNER RADIUS" Style="{StaticResource SectionCaption}" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding QuickEditCornerRadiusValue, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- 3. MEDIA LAYER CONTROLS -->
                                        <StackPanel Visibility="{Binding MediaSectionVisibility}">
                                            <TextBlock Text="MEDIA FILE / SEQUENCE FOLDER" Style="{StaticResource SectionCaption}" Margin="0,2,0,2"/>
                                            <TextBox Text="{Binding QuickEditSourceValue, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="36" Margin="0,0,0,5"/>
                                        </StackPanel>

                                        <!-- 4. COMMON GEOMETRY & TRANSFORM CONTROLS -->
                                        <TextBlock Text="DIMENSIONS &amp; POSITION" Foreground="#B78BE7" FontWeight="SemiBold" FontSize="10" Margin="0,4,0,2"/>
                                        <Grid Margin="0,2,0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="WIDTH" Style="{StaticResource SectionCaption}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding QuickEditWidthValue, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="HEIGHT" Style="{StaticResource SectionCaption}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding QuickEditHeightValue, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,2,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="POS X" Style="{StaticResource SectionCaption}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding QuickEditXValue, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="POS Y" Style="{StaticResource SectionCaption}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding QuickEditYValue, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="OPACITY" Style="{StaticResource SectionCaption}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding QuickEditOpacityValue, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Separator Margin="0,4,0,6"/>
                                        <Button Content="SAVE CHANGES" Click="QuickEditSave_Click" Style="{StaticResource BusButton}" Height="30" Margin="0,2" Background="#1D2A3A" BorderBrush="#3B6998" ToolTip="Save edits to the project in memory"/>
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="SAVE &amp; PREVIEW" Click="QuickEditSaveAndPreview_Click" Style="{StaticResource BusButton}" Height="32" Background="#2B1740" BorderBrush="#7445A8" ToolTip="Save changes and immediately render onto Preview Bus"/>
                                            <Button Grid.Column="2" Content="SAVE &amp; PLAY PROGRAM" Click="QuickEditSaveAndProgram_Click" Style="{StaticResource BusButton}" Height="32" Background="#3A1417" BorderBrush="#A7434E" ToolTip="Save changes and immediately update/play on Program Bus"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="CG SCHEDULER">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="DYNAMIC CG BROADCAST SCHEDULER" FontWeight="SemiBold" FontSize="12" Foreground="#DCC7F0"/>
                                    <TextBlock Text="Set daily or timed automated graphic play &amp; clear triggers (e.g. 9:00 PM to 10:00 PM)." Foreground="{StaticResource MutedBrush}" FontSize="9.5" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Add Schedule Form -->
                                <Border Grid.Row="1" Background="#121822" BorderBrush="#253242" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="ADD NEW SCHEDULED EVENT" Style="{StaticResource SectionCaption}" Margin="0,0,0,4"/>
                                        <TextBlock Text="GRAPHIC TEMPLATE" FontSize="9" Foreground="#8FA3B8"/>
                                        <ComboBox ItemsSource="{Binding Projects}" DisplayMemberPath="Name" SelectedValuePath="Name" SelectedValue="{Binding NewScheduleProjectName, Mode=TwoWay}" Margin="0,2,0,4"/>
                                        
                                        <Grid Margin="0,2,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="START TIME" FontSize="9" Foreground="#8FA3B8"/>
                                                <TextBox Text="{Binding NewScheduleStartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Start time format: HH:mm:ss (e.g. 21:00:00 for 9 PM)"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="STOP TIME" FontSize="9" Foreground="#8FA3B8"/>
                                                <TextBox Text="{Binding NewScheduleStopTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Stop time format: HH:mm:ss (e.g. 22:00:00 for 10 PM)"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="LAYER" FontSize="9" Foreground="#8FA3B8"/>
                                                <TextBox Text="{Binding NewScheduleLayer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Overlay channel layer index (0, 1, 2, ...)"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,2,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="RECURRENCE" FontSize="9" Foreground="#8FA3B8"/>
                                                <ComboBox ItemsSource="{Binding ScheduleDaysOptions}" SelectedItem="{Binding NewScheduleDays, Mode=TwoWay}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="+ ADD SCHEDULE" Click="AddSchedule_Click" Padding="14,6" Height="30" VerticalAlignment="Bottom" Background="#3E2359" BorderBrush="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Schedule List -->
                                <ListBox Grid.Row="2" ItemsSource="{Binding Schedules}" x:Name="ScheduleListBox" Background="#0A0E13" BorderBrush="#253242" BorderThickness="1">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#161222" BorderBrush="#352646" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Enable/Disable event"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding StartTime, StringFormat='⏱ {0}'}" FontSize="9.5" Foreground="#B78BE7" FontFamily="Consolas"/>
                                                            <TextBlock Text=" ➔ " FontSize="9" Foreground="#7B8894"/>
                                                            <TextBlock Text="{Binding StopTime}" FontSize="9.5" Foreground="#E0D0F5" FontFamily="Consolas"/>
                                                            <TextBlock Text="{Binding Days, StringFormat=' • {0}'}" FontSize="9" Foreground="#B98CF1"/>
                                                            <TextBlock Text="{Binding OverlayLayer, StringFormat=' • L{0}'}" FontSize="9" Foreground="#8055B3"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Status}" FontSize="8.5" Foreground="#55C878" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                        <Button Content="▶" Tag="{Binding}" Click="TriggerScheduleNow_Click" ToolTip="Trigger PLAY now" Padding="6,2" Margin="2,0" FontSize="9"/>
                                                        <Button Content="⏹" Tag="{Binding}" Click="StopScheduleNow_Click" ToolTip="Trigger STOP now" Padding="6,2" Margin="2,0" FontSize="9"/>
                                                        <Button Content="✕" Tag="{Binding}" Click="DeleteSchedule_Click" ToolTip="Delete schedule" Padding="6,2" Margin="2,0" Background="#251B31" BorderBrush="{StaticResource LineBrush}" Foreground="#FFFFFF" FontSize="9"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Bottom Status Bar -->
                                <Border Grid.Row="3" Background="#0A0E13" BorderBrush="#253242" BorderThickness="1" Padding="6,4" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="SCHEDULER ENGINE:" FontSize="9" Foreground="#7B8894"/>
                                        <TextBlock Text=" ACTIVE (1s LOOP)" FontSize="9" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <Border x:Name="TargetsPanel" Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="8">
                    <TabControl>
                        <TabItem Header="TARGETS"><Grid Margin="5"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions><ListBox ItemsSource="{Binding Channels}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding ChannelName}" FontWeight="SemiBold"/><TextBlock Text="{Binding ChannelId}" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{StaticResource GoodBrush}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="SELECT ALL" Click="SelectAll_Click"/><Button Grid.Column="1" Content="CLEAR" Click="Clear_Click"/></Grid></Grid></TabItem>
                        <TabItem Header="OUTPUT"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="7">
                            <TextBlock Text="CG PROGRAM BUS" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                            <TextBlock Text="This controller publishes a separate transparent CG Program bus. Route it to DeckLink fill/key, NDI, or streaming destinations from Kashtrix Output Engine." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,8"/>
                            <TextBlock Text="DIRECT CG OUTPUTS (LIVE)" Style="{StaticResource SectionCaption}" Margin="0,2,0,4"/>
                            <CheckBox Content="NDI ALPHA OUT" IsChecked="{Binding EnableCgNdiAlphaOutput, Mode=TwoWay}"/>
                            <TextBox Text="{Binding CgNdiAlphaSourceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,7"/>
                            <CheckBox Content="DECKLINK FILL + KEY" IsChecked="{Binding EnableCgDeckLinkKeyFill, Mode=TwoWay}"/>
                            <TextBlock Text="DECKLINK CARD / PORT" Style="{StaticResource SectionCaption}" Margin="0,6,0,2"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding CgDeckLinkDevices}" DisplayMemberPath="Label" SelectedValuePath="Index" SelectedValue="{Binding CgDeckLinkDeviceIndex, Mode=TwoWay}"/><Button Grid.Column="1" Content="REFRESH" Click="RefreshDeckLinkCards_Click"/></Grid>
                            <TextBlock Text="KEYER MODE" Style="{StaticResource SectionCaption}" Margin="0,6,0,2"/>
                            <ComboBox ItemsSource="{Binding DeckLinkKeyerModes}" SelectedItem="{Binding CgDeckLinkKeyerMode, Mode=TwoWay}"/>
                            <TextBlock Text="OUTPUT PRESET" Style="{StaticResource SectionCaption}" Margin="0,6,0,2"/>
                            <ComboBox ItemsSource="{Binding CgOutputPresets}" SelectedItem="{Binding CgOutputPreset, Mode=TwoWay}"/>
                            <TextBlock Text="SCAN / FIELD ORDER" Style="{StaticResource SectionCaption}" Margin="0,6,0,2"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding CgFrameRates}" SelectedItem="{Binding CgOutputFrameRate, Mode=TwoWay}"/><ComboBox Grid.Column="1" ItemsSource="{Binding CgScanModes}" SelectedItem="{Binding CgOutputScanMode, Mode=TwoWay}"/></Grid>
                            <TextBlock Text="PREROLL FRAMES" Style="{StaticResource SectionCaption}" Margin="0,6,0,2"/>
                            <TextBox Text="{Binding CgOutputPrerollFrames, UpdateSourceTrigger=LostFocus}"/>
                            <Button Content="APPLY CG BUS FORMAT" Click="ApplyCgOutput_Click" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding CgOutputStatus}" Foreground="{StaticResource AccentBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="STATUS"><StackPanel Margin="8"><TextBlock Text="LAST ROUTE" Style="{StaticResource SectionCaption}"/><TextBlock Text="{Binding LastOperation}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding LastDetail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/><Separator Margin="0,10"/><TextBlock Text="{Binding CgOutputSummary}" Foreground="#B98CF1" TextWrapping="Wrap"/></StackPanel></TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#0E1013" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Endpoint}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/><TextBlock Grid.Column="2" Text="INDEPENDENT PREVIEW / PROGRAM" Foreground="#B98CF1" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
    </Border>
</Window>
