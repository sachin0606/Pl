                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Width in %" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedHtml.WidthPercent, UpdateSourceTrigger=LostFocus}" LostFocus="HtmlInspector_LostFocus"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Height in %" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedHtml.HeightPercent, UpdateSourceTrigger=LostFocus}" LostFocus="HtmlInspector_LostFocus"/></StackPanel>
                            </Grid>

                            <TextBlock Text="DYNAMIC DATA JSON" FontWeight="SemiBold" FontSize="11" Margin="0,12,0,4" Foreground="{StaticResource AccentBrush}"/>
                            <TextBox Text="{Binding SelectedHtml.DataJson, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="75" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Content="UPDATE DATA" Click="UpdateHtmlData_Click" Width="118"/><Button Content="RELOAD" Click="ReloadHtml_Click" Width="90"/></StackPanel>
                            <TextBlock Text="HTML may listen for window.Kashtrix.update(data) or the 'kashtrix-data' CustomEvent. Local assets, CSS, JS, SVG, canvas, WebGL and MediaStream are handled by the Kashtrix web graphics engine." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="9.5" Margin="0,10,0,0"/>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="COMPOSITION">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                            <TextBlock Text="COMPOSITION SETTINGS" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Live project properties · Frame size, frame rate, timeline duration and name" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,3,0,10"/>
                            
                            <TextBlock Text="COMPOSITION NAME" Style="{StaticResource SectionCaption}"/>
                            <TextBox Text="{Binding SelectedProject.Name, UpdateSourceTrigger=LostFocus}" LostFocus="ProjectInspector_LostFocus" Margin="0,0,0,10"/>

                            <TextBlock Text="FRAME SIZE (RESOLUTION)" Foreground="#B78BE7" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Width (px)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedProject.Width, UpdateSourceTrigger=LostFocus}" LostFocus="ProjectInspector_LostFocus" ToolTip="Horizontal resolution (scrub or type)"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Height (px)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedProject.Height, UpdateSourceTrigger=LostFocus}" LostFocus="ProjectInspector_LostFocus" ToolTip="Vertical resolution (scrub or type)"/></StackPanel>
                            </Grid>
                            <TextBlock Text="RESOLUTION PRESETS" Foreground="#93A0A8" FontWeight="SemiBold" FontSize="10" Margin="0,4,0,3"/>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="1080p FHD (1920x1080)" Tag="1920x1080" Click="SetProjectResolution_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="4K UHD (3840x2160)" Tag="3840x2160" Click="SetProjectResolution_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="720p HD (1280x720)" Tag="1280x720" Click="SetProjectResolution_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="9:16 VERTICAL (1080x1920)" Tag="1080x1920" Click="SetProjectResolution_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="1:1 SQUARE (1080x1080)" Tag="1080x1080" Click="SetProjectResolution_Click" Margin="2" Padding="6,3" FontSize="9"/>
                            </WrapPanel>

                            <TextBlock Text="FRAME RATE (FPS)" Foreground="#B78BE7" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="FPS" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedProject.FrameRate, UpdateSourceTrigger=LostFocus}" LostFocus="ProjectInspector_LostFocus" ToolTip="Frame rate in fps (scrub or type)"/></StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom"><TextBlock Text="{Binding CanvasInfoText}" Foreground="{StaticResource MutedBrush}" FontSize="8.5" TextWrapping="Wrap"/></StackPanel>
                            </Grid>
                            <TextBlock Text="BROADCAST FPS PRESETS" Foreground="#93A0A8" FontWeight="SemiBold" FontSize="10" Margin="0,4,0,3"/>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="50 FPS (PAL/HD)" Tag="50" Click="SetProjectFps_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="25 FPS (PAL SD)" Tag="25" Click="SetProjectFps_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="59.94 FPS (NTSC/ATSC)" Tag="59.94" Click="SetProjectFps_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="60 FPS" Tag="60" Click="SetProjectFps_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="29.97 FPS (NTSC SD)" Tag="29.97" Click="SetProjectFps_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="30 FPS" Tag="30" Click="SetProjectFps_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="24 FPS (FILM)" Tag="24" Click="SetProjectFps_Click" Margin="2" Padding="6,3" FontSize="9"/>
                            </WrapPanel>

                            <TextBlock Text="TIMELINE DURATION" Foreground="#B78BE7" FontWeight="SemiBold" Margin="0,4,0,4"/>
                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Duration (seconds)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedProject.DurationSeconds, UpdateSourceTrigger=LostFocus}" LostFocus="ProjectDuration_LostFocus" ToolTip="Duration in seconds (scrub or type)"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Timecode Length" Style="{StaticResource SectionCaption}"/><TextBlock Text="{Binding RemainingText}" Style="{StaticResource TimecodeText}" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
                            </Grid>
                            <TextBlock Text="AUTHENTIC SEQUENCE PRESETS" Foreground="#93A0A8" FontWeight="SemiBold" FontSize="10" Margin="0,4,0,3"/>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="3.90s (PRIME HD LOOP)" Tag="3.90" Click="SetProjectDuration_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="9.80s (SPACE 4K TOPBAR)" Tag="9.80" Click="SetProjectDuration_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="10.04s (SPACE 4K BREAKING)" Tag="10.04" Click="SetProjectDuration_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="5.0s (QUICK BUMPER)" Tag="5.0" Click="SetProjectDuration_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="15.0s (COMMERCIAL ID)" Tag="15.0" Click="SetProjectDuration_Click" Margin="2" Padding="6,3" FontSize="9"/>
                                <Button Content="30.0s (STANDARD PROMO)" Tag="30.0" Click="SetProjectDuration_Click" Margin="2" Padding="6,3" FontSize="9"/>
                            </WrapPanel>

                            <Button Content="FIT TIMELINE &amp; APPLY" Click="ApplyCompositionSettings_Click" Height="32" Background="#261E3E" BorderBrush="#9354FF" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- timeline -->
        <GridSplitter Grid.Row="2" Height="6" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="#2B1740" ResizeDirection="Rows" ResizeBehavior="PreviousAndCurrent" ShowsPreview="True"/>
        <Border x:Name="TimelinePanel" Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="10,7,10,10"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource PanelHeader}" Padding="10,0" Height="44">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TIMELINE" FontWeight="Bold" Foreground="#ECEFF1" VerticalAlignment="Center" Margin="0,0,8,0"
                                   ToolTip="TIMELINE · CTRL-CLICK ANY ROW/CLIP TO MULTI-SELECT · SHIFT RANGE · DRAG PLAYHEAD / BARS / KEYFRAMES"/>
                        <Button x:Name="TimelineDockBtn" Content="DOCK OUT" Click="TimelineDockOut_Click" Height="24" MinHeight="24" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Detach the complete interactive timeline into its own resizable window"/>
                        <Button Content="−" Click="TimelineZoomOut_Click" Height="24" Width="26" MinWidth="26" Padding="0" Margin="1,0" VerticalAlignment="Center" ToolTip="Zoom out the real timeline time scale"/>
                        <TextBlock Text="{Binding TimelineZoomText}" Width="44" TextAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#A9B7C6"/>
                        <Button Content="+" Click="TimelineZoomIn_Click" Height="24" Width="26" MinWidth="26" Padding="0" Margin="1,0" VerticalAlignment="Center" ToolTip="Zoom in the real timeline time scale"/>
                        <Button Content="FIT" Click="TimelineZoomFit_Click" Height="24" MinWidth="38" Padding="4,0" Margin="3,0,0,0" VerticalAlignment="Center" ToolTip="Fit timeline to view"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedProject.Name}" TextTrimming="CharacterEllipsis" MinWidth="10" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="DUR " Foreground="#A981FF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Width="58" MinWidth="58" Height="24" Padding="2,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TextAlignment="Center" FontSize="11" Text="{Binding SelectedProject.DurationSeconds, UpdateSourceTrigger=LostFocus}" LostFocus="ProjectDuration_LostFocus" ToolTip="Timeline duration in seconds"/>
                    </StackPanel>
                    <CheckBox Grid.Column="3" Content="AUTO KEY" IsChecked="{Binding AutoKey}" Style="{StaticResource ToggleSwitch}" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="When enabled, move/resize at the playhead creates or updates only that keyframe."/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="NOW " Foreground="#78848D" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PlayheadText}" Style="{StaticResource TimecodeText}" Foreground="#FF5A63" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LEFT " Foreground="#78848D" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RemainingText}" Style="{StaticResource TimecodeText}" Foreground="#E7EAED" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Pinned layer header corner (does not scroll horizontally) -->
            <Border Grid.Row="1" Grid.Column="0" Background="#0C1219" BorderBrush="#1C2733" BorderThickness="0,0,1,1"><TextBlock Text="LAYERS" Foreground="#7D8D9D" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/></Border>
            <!-- Timeline ruler: time/ticks stay sticky while layer rows scroll vertically -->
            <ScrollViewer x:Name="TimelineRulerScroll" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Left"><Canvas x:Name="TimelineRulerCanvas" Height="26" MinWidth="240" HorizontalAlignment="Left" Background="#070B10" SizeChanged="TimelineCanvas_SizeChanged" MouseLeftButtonDown="TimelineRulerCanvas_MouseLeftButtonDown" PreviewMouseRightButtonDown="TimelineRulerCanvas_PreviewMouseRightButtonDown" MouseMove="TimelineRulerCanvas_MouseMove" MouseLeftButtonUp="TimelineRulerCanvas_MouseLeftButtonUp"/></ScrollViewer>
            <!-- Pinned layer names column (scrolls vertically in sync with layer rows, fixed horizontally) -->
            <ScrollViewer x:Name="TimelineHeadersScroll" Grid.Row="2" Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" ScrollChanged="TimelineHeadersScroll_ScrollChanged"><Canvas x:Name="TimelineHeadersCanvas" Width="135" Background="#0A0E14" MouseLeftButtonDown="TimelineHeadersCanvas_MouseLeftButtonDown" PreviewMouseRightButtonDown="TimelineHeadersCanvas_PreviewMouseRightButtonDown"/></ScrollViewer>
            <Border Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" Width="1" Background="#1C2733" IsHitTestVisible="False"/>
            <!-- Timeline tracks and duration canvas (zooms and scrolls horizontally) -->
            <ScrollViewer x:Name="TimelineLayerScroll" Grid.Row="2" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" ScrollChanged="TimelineLayerScroll_ScrollChanged" SizeChanged="TimelineViewport_SizeChanged"><Canvas x:Name="TimelineCanvas" Height="146" MinWidth="240" HorizontalAlignment="Left" SizeChanged="TimelineCanvas_SizeChanged" MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown" PreviewMouseRightButtonDown="TimelineCanvas_PreviewMouseRightButtonDown" MouseMove="TimelineCanvas_MouseMove" MouseLeftButtonUp="TimelineCanvas_MouseLeftButtonUp" Background="#070B10">
                    <Canvas.ContextMenu><ContextMenu>
                        <MenuItem Header="GROUP SELECTED" Click="GroupSelectedLayers_Click"/>
                        <MenuItem Header="PRECOMPOSE SELECTED" Click="PrecomposeSelectedLayers_Click"/>
                        <MenuItem Header="UNGROUP SELECTED" Click="UngroupSelectedLayers_Click"/>
                    </ContextMenu></Canvas.ContextMenu>
                </Canvas></ScrollViewer>
        </Grid></Border>
    </Grid>
</Window>
