                                            <ComboBox ItemsSource="{Binding DateTimeFormatPresets}" SelectedItem="{Binding SelectedLayer.DataFormat, Mode=TwoWay}" IsEditable="True" SelectionChanged="NepaliFormatPreset_SelectionChanged" LostFocus="Inspector_LostFocus" ToolTip="Select broadcast date and time format token preset or choose Custom"/>
