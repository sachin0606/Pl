                                            <TextBlock Text="DATE &amp; TIME CALENDAR" Foreground="#00E5FF" FontWeight="SemiBold" FontSize="10.5" Margin="0,10,0,3"/>
                                            <TextBlock Text="Calendar system" Foreground="{StaticResource MutedBrush}" FontSize="8.5" Margin="0,0,0,3"/>
                                            <ComboBox ItemsSource="{Binding CalendarSystems}" SelectedItem="{Binding SelectedLayer.CalendarSystem, Mode=TwoWay}" SelectionChanged="CalendarSystem_SelectionChanged" ToolTip="AD Gregorian or BS Bikram Sambat"/>
