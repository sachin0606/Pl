<Window x:Class="BroadcastPlayout.Views.CgEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix CG Editor" Width="1500" Height="900" MinWidth="1250" MinHeight="760" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown" PreviewGotKeyboardFocus="Window_PreviewGotKeyboardFocus" AllowDrop="True" Drop="Window_Drop" Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-cgeditor.ico">
    <Window.Resources>
        <DrawingBrush x:Key="CgCheckerBrush" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#24272B"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#15181B"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,12,12"/><RectangleGeometry Rect="12,12,12,12"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition x:Name="TimelineRow" Height="280" MinHeight="160"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#080D12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Header -->
                <Grid VerticalAlignment="Center" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-cgeditor.png" Width="30" Height="30" Stretch="Uniform"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,12,0">
                        <TextBlock Text="KASHTRIX CG" FontSize="14" FontWeight="Bold" Foreground="#ECEFF1"/>
                        <TextBlock Text="BROADCAST EDITOR" Foreground="{StaticResource MutedBrush}" FontSize="8.5"/>
                    </StackPanel>
                </Grid>

                <!-- Professional Broadcast Navbar Menu -->
                <Menu Grid.Column="1" Background="Transparent" Foreground="#ECEFF1" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,16,0">
                    <MenuItem Header="FILE">
                        <MenuItem Header="New Composition" Click="NewProject_Click"/>
                        <MenuItem Header="Save Composition" Click="Save_Click"/>
                        <MenuItem Header="Save Composition As..." Click="SaveAs_Click"/>
                        <Separator/>
                        <MenuItem Header="Import Composition (.KCG)..." Click="ImportCompositionFile_Click"/>
                        <MenuItem Header="Export Composition (.KCG)..." Click="ExportCompositionFile_Click"/>
                        <Separator/>
                        <MenuItem Header="Clear Canvas" Click="ClearCanvas_Click"/>
                        <Separator/>
                        <MenuItem Header="Close Window" Click="Close_Click"/>
                    </MenuItem>
                    <MenuItem Header="DEMOS">
                        <MenuItem Header="Load Demo Data" Click="LoadDemo_Click"/>
                        <MenuItem Header="Reload Broadcast Templates" Click="ReloadTemplates_Click"/>
                    </MenuItem>
                    <MenuItem Header="VIEW / LAYOUT">
                        <MenuItem Header="Standard Multi-Panel" Tag="Standard" Click="ApplyEditorLayout_Click"/>
                        <MenuItem Header="Canvas Focus" Tag="CanvasFocus" Click="ApplyEditorLayout_Click"/>
                        <MenuItem Header="Timeline Focus" Tag="TimelineFocus" Click="ApplyEditorLayout_Click"/>
                        <Separator/>
                        <MenuItem x:Name="LibraryPanelMenu" Header="Layers &amp; Sources" IsCheckable="True" IsChecked="True" Tag="Library" Click="ToggleEditorPanel_Click"/>
                        <MenuItem x:Name="CanvasPanelMenu" Header="Canvas &amp; Preview" IsCheckable="True" IsChecked="True" Tag="Canvas" Click="ToggleEditorPanel_Click"/>
                        <MenuItem x:Name="InspectorPanelMenu" Header="Inspector Panel" IsCheckable="True" IsChecked="True" Tag="Inspector" Click="ToggleEditorPanel_Click"/>
                        <MenuItem x:Name="TimelinePanelMenu" Header="Timeline Panel" IsCheckable="True" IsChecked="True" Tag="Timeline" Click="ToggleEditorPanel_Click"/>
                        <Separator/>
                        <MenuItem Header="Restore All Panels" Click="RestoreEditorPanels_Click"/>
                    </MenuItem>
                    <MenuItem Header="BROADCAST">
                        <MenuItem Header="Take On Air" Click="TakeOnAir_Click"/>
                        <MenuItem Header="CG Controller..." Click="OpenCgController_Click"/>
                        <Separator/>
                        <MenuItem Header="Select Now / Next Fields..." Click="OpenNowNextFields_Click"/>
                        <MenuItem Header="Select Weather Fields..." Click="OpenWeatherFields_Click"/>
                        <MenuItem Header="Dynamic Broadcast Fields (Now/Next &amp; Weather)..." Click="DynamicFields_Click"/>
                    </MenuItem>
                </Menu>

                <!-- Template & Project Selectors -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,4,12,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MaxWidth="360"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Height="26" ItemsSource="{Binding TemplateCategories}" SelectedItem="{Binding TemplateCategory, Mode=TwoWay}" ToolTip="Filter the 200-template catalog" Background="#10151C" BorderBrush="#252F3C"/>
                    <ComboBox Grid.Column="2" Height="26" ItemsSource="{Binding ProjectView}" DisplayMemberPath="Name" SelectedItem="{Binding ProjectPickerSelection, Mode=TwoWay}" ToolTip="Active composition / graphic project" Background="#10151C" BorderBrush="#252F3C"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding TemplateCountText, Mode=OneWay}" Foreground="#78909C" FontSize="8.5" Margin="2,2,0,0"/>
                </Grid>

                <!-- Professional Uniform Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="SAVE" Click="Save_Click" Height="26" MinWidth="54" Margin="0,0,6,0" Background="#19232F" BorderBrush="#2C3B4E" Foreground="#E2E8F0" ToolTip="Save current composition changes"/>
                    <Button Content="SAVE AS" Click="SaveAs_Click" Height="26" MinWidth="58" Margin="0,0,6,0" Background="#19232F" BorderBrush="#2C3B4E" Foreground="#E2E8F0" ToolTip="Save composition under a new file name or location"/>
                    <Button Content="CLEAR CANVAS" Click="ClearCanvas_Click" Height="26" MinWidth="70" Margin="0,0,6,0" Background="#281519" BorderBrush="#E45467" Foreground="#FF8A9B" ToolTip="Remove all native layers, groups and HTML sources from this project"/>
                    <Button Content="TAKE ON AIR" Click="TakeOnAir_Click" Height="26" MinWidth="88" Background="#2A1B16" BorderBrush="#6B3A2C" Foreground="#FFA726" ToolTip="Broadcast current graphic directly to program output"/>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="Minimize_Click" Style="{StaticResource WindowControlButton}" ToolTip="Minimize"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button>
                    <Button Click="Maximize_Click" Style="{StaticResource WindowControlButton}" ToolTip="Maximize / Restore"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button>
                    <Button Click="Close_Click" Style="{StaticResource WindowCloseButton}" ToolTip="Close"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="EditorWorkspaceGrid" Grid.Row="1" Margin="10"><Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="286"/><ColumnDefinition x:Name="CanvasColumn" Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="390"/></Grid.ColumnDefinitions>
            <!-- native layers + independent web graphic sources -->
            <Border x:Name="LibraryPanel" Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource PanelHeader}" Padding="10,4">
                        <Grid>
                            <TextBlock Text="LAYERS &amp; SOURCES" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="LibraryDockBtn" Content="DOCK OUT" Click="LibraryDockOut_Click" Height="22" MinHeight="22" Padding="8,0" HorizontalAlignment="Right" ToolTip="Detach / Dock in Layers &amp; Sources window"/>
                        </Grid>
                    </Border>
                    <TabControl Grid.Row="1">
                    <TabItem Header="CG LAYERS / NATIVE">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="316"/></Grid.RowDefinitions>
                            <ListBox x:Name="LayerList" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer, Mode=TwoWay}" SelectionMode="Extended" PreviewMouseLeftButtonDown="LayerList_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="LayerList_PreviewMouseRightButtonDown" MouseDoubleClick="LayerList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,3" ToolTip="{Binding Name}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#16222E" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StartSeconds, StringFormat={}{0:0.00}s}" FontSize="8.5" Foreground="#7EE787" FontFamily="Consolas"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Type}" Foreground="{StaticResource MutedBrush}" FontSize="8.5"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#261A3A" BorderBrush="#503070" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EndSeconds, StringFormat={}{0:0.00}s}" FontSize="8.5" Foreground="#B98CF1" FontFamily="Consolas"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="COPY" InputGestureText="Ctrl+C" Click="CopyLayer_Click"/>
                                        <MenuItem Header="CUT" InputGestureText="Ctrl+X" Click="CutLayer_Click"/>
                                        <MenuItem Header="PASTE" InputGestureText="Ctrl+V" Click="PasteLayer_Click"/>
                                        <MenuItem Header="DUPLICATE" InputGestureText="Ctrl+D" Click="DuplicateSelectedLayers_Click"/>
                                        <Separator/>
                                        <MenuItem Header="GROUP SELECTED" InputGestureText="Ctrl+G" Click="GroupSelectedLayers_Click"/>
                                        <MenuItem Header="PRECOMPOSE SELECTED" InputGestureText="Ctrl+Shift+G" Click="PrecomposeSelectedLayers_Click" ToolTip="Create an animated parent precomposition for the selected elements"/>
                                        <MenuItem Header="UNGROUP SELECTED" Click="UngroupSelectedLayers_Click"/>
                                        <Separator/>
                                        <MenuItem Header="MOVE UP ONE LAYER" Click="MoveLayerUp_Click"/>
                                        <MenuItem Header="MOVE DOWN ONE LAYER" Click="MoveLayerDown_Click"/>
                                        <MenuItem Header="BRING TO FRONT" Click="BringToFront_Click"/>
                                        <MenuItem Header="SEND TO BACK" Click="SendToBack_Click"/>
                                        <Separator/>
                                        <MenuItem Header="ALIGN TO CANVAS">
                                            <MenuItem Header="LEFT" Click="AlignLeft_Click"/>
                                            <MenuItem Header="HORIZONTAL CENTER" Click="AlignHorizontalCenter_Click"/>
                                            <MenuItem Header="RIGHT" Click="AlignRight_Click"/>
                                            <Separator/>
                                            <MenuItem Header="TOP" Click="AlignTop_Click"/>
                                            <MenuItem Header="VERTICAL CENTER" Click="AlignVerticalCenter_Click"/>
                                            <MenuItem Header="BOTTOM" Click="AlignBottom_Click"/>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="CLEAR IN / OUT ANIMATION" Click="ClearLayerAnimation_Click"/>
                                        <MenuItem Header="DELETE" InputGestureText="Delete" Click="DeleteSelectedLayers_Click"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="6">
                                    <UniformGrid Columns="2">
                                        <Button Content="TEXT" Click="AddText_Click" Height="28" Margin="3" FontSize="9.5"/>
                                        <Button Content="SHAPE" Click="AddShape_Click" Height="28" Margin="3" FontSize="9.5"/>
                                        <Button Content="PEN SHAPE" Click="AddPenShape_Click" Height="28" Margin="3" FontSize="9.5" ToolTip="Click points on the canvas; double-click or press Enter to close the native path"/>
                                        <Button Content="PEN MASK" Click="AddPenMask_Click" Height="28" Margin="3" FontSize="9.5" ToolTip="Draw a freeform mask for the selected layer; double-click or press Enter to finish"/>
                                        <Button Content="TICKER" Click="AddTicker_Click" Height="28" Margin="3" FontSize="9.5"/>
                                        <Button Content="TIMER" Click="AddTimer_Click" Height="28" Margin="3" FontSize="9.5" ToolTip="Timer / Countdown / Countup / Commercial Back In"/>
                                        <Button Content="WEATHER" Click="AddWeatherIcon_Click" Height="28" Margin="3" FontSize="9.5"/>
                                        <Button Content="ROLL" Click="AddRoll_Click" Height="28" Margin="3" FontSize="9.5"/>
                                        <Button Content="DATE TIME" Click="AddDigital_Click" Height="28" Margin="3" FontSize="9.5" ToolTip="Date and time with AD / BS calendar selection"/>
                                        <Button Content="ANALOG" Click="AddAnalog_Click" Height="28" Margin="3" FontSize="9.5"/>
                                        <Button Content="PROGRAM PIP" Click="AddProgramPip_Click" Height="28" Margin="3" FontSize="9.5" ToolTip="Movable &amp; resizable Program Video PIP squeeze box"/>
                                        <Button Content="ELLIPSE" Click="AddEllipse_Click" Height="28" Margin="3" FontSize="9.5"/>
                                        <Button Content="LINE" Click="AddLine_Click" Height="28" Margin="3" FontSize="9.5"/>
                                        <Button Content="LOGO" Click="ImportLogo_Click" Height="28" Margin="3" FontSize="9.5"/>
                                        <Button Content="IMAGE" Click="ImportImage_Click" Height="28" Margin="3" FontSize="9.5"/>
                                        <Button Content="IMAGE SEQUENCE" Click="ImportSequence_Click" Height="28" Margin="3" FontSize="9.5"/>
                                        <Button Content="AFTER EFFECTS" Click="ImportAfterEffects_Click" Height="28" Margin="3" FontSize="9.5" ToolTip="Render an installed Adobe After Effects .aep/.aepx/.aet composition to an alpha image sequence and place it on the native CG timeline"/>
                                        <Button Content="VIDEO FILE" Click="ImportVideo_Click" Height="28" Margin="3" FontSize="9.5"/>
                                        <Button Content="VIDEO SOURCE" Click="AddVideoSource_Click" Height="28" Margin="3" FontSize="9.5" ToolTip="Choose File / URL / NDI / card / webcam / screen / custom source, then drag its 16:9 or custom region on the canvas"/>
                                    </UniformGrid>
                                    <TextBlock Width="250" Margin="4,8,4,2" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="9"
                                               Text="KEYS: Ctrl+C/X/V/D · Delete · arrows move · Shift+arrows 10 px · Ctrl+arrows resize · Alt+Up/Down layer step · Alt+Home/End front/back · Ctrl+G group · Ctrl+Z Undo · Ctrl+Y Redo"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="HTML / WEB">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="235"/></Grid.RowDefinitions>
                            <ListBox ItemsSource="{Binding HtmlSources}" SelectedItem="{Binding SelectedHtml, Mode=TwoWay}">
                                <ListBox.ItemTemplate><DataTemplate><Grid Margin="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding SourceKind}" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource GoodBrush}" FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="1" Text="Web graphics run their own HTML/CSS/JavaScript animation and are not placed on the native timeline." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="9" Margin="8,5"/>
                            <ScrollViewer Grid.Row="2"><WrapPanel Margin="7">
                                <Button Content="HTML FILE" Click="ImportHtml_Click" Width="112"/><Button Content="HTML FOLDER" Click="ImportHtmlFolder_Click" Width="112"/>
                                <Button Content="WEB URL" Click="ImportHtmlUrl_Click" Width="112"/><Button Content=".KASHGFX" Click="ImportKashGfx_Click" Width="112"/>
                                <Button Content="RELOAD" Click="ReloadHtml_Click" Width="112"/><Button Content="DELETE" Click="DeleteHtml_Click" Width="112"/>
                            </WrapPanel></ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="DATA / GROUPS">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <TextBlock Text="TEXT DATA SOURCES" Foreground="#B78BE7" FontWeight="SemiBold"/>
                                <TextBlock Text="URL JSON · local JSON · XML · RSS · XLSX/CSV · TXT · OpenWeather" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,2,0,6"/>
                                <ListBox ItemsSource="{Binding DataSources}" SelectedItem="{Binding SelectedDataSource, Mode=TwoWay}" Height="120" DisplayMemberPath="Name"/>
                                <WrapPanel Margin="0,5,0,0">
                                    <Button Content="URL JSON" Click="AddUrlJsonData_Click" Width="82"/><Button Content="JSON" Click="AddJsonData_Click" Width="62"/><Button Content="XML/RSS" Click="AddXmlRssData_Click" Width="78"/>
                                    <Button Content="EXCEL" Click="AddExcelData_Click" Width="68"/><Button Content="TXT" Click="AddTxtData_Click" Width="58"/><Button Content="WEATHER" Click="AddWeatherData_Click" Width="78"/><Button Content="WEATHER FIELDS..." Click="OpenWeatherFields_Click" Width="105" Background="#2A1B3D" BorderBrush="{StaticResource AccentBrush}" Foreground="#E2D5F5" ToolTip="Broadcast Weather Fields (temperature, min/max, feels like, pressure, humidity, clouds, image, multi-day)"/><Button Content="NOW/NEXT..." Click="OpenNowNextFields_Click" Width="82" Background="#2A1B3D" BorderBrush="{StaticResource AccentBrush}" Foreground="#E2D5F5" ToolTip="Broadcast Now/Next Fields Modal"/><Button Content="REFRESH" Click="RefreshData_Click" Width="78"/><Button Content="DELETE" Click="DeleteData_Click" Width="68"/>
                                </WrapPanel>
                                <TextBlock Text="Name" Style="{StaticResource SectionCaption}" Margin="0,7,0,2"/><TextBox Text="{Binding SelectedDataSource.Name, UpdateSourceTrigger=LostFocus}" LostFocus="DataInspector_LostFocus"/>
                                <TextBlock Text="Source type" Style="{StaticResource SectionCaption}" Margin="0,6,0,2"/><ComboBox ItemsSource="{Binding DataSourceTypes}" SelectedItem="{Binding SelectedDataSource.SourceType}" SelectionChanged="DataInspector_SelectionChanged"/>
                                <TextBlock Text="Path / URL / City" Style="{StaticResource SectionCaption}" Margin="0,6,0,2"/><TextBox Text="{Binding SelectedDataSource.Source, UpdateSourceTrigger=LostFocus}" LostFocus="DataInspector_LostFocus" TextWrapping="Wrap"/>
                                <TextBlock Text="JSON/XML selector" Style="{StaticResource SectionCaption}" Margin="0,6,0,2"/><TextBox Text="{Binding SelectedDataSource.Selector, UpdateSourceTrigger=LostFocus}" LostFocus="DataInspector_LostFocus"/>
                                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Credential env var" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedDataSource.CredentialEnvironmentVariable, UpdateSourceTrigger=LostFocus}" LostFocus="DataInspector_LostFocus" ToolTip="For weather use OPENWEATHER_API_KEY. Secrets are not stored in CG project files."/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Units" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedDataSource.Units, UpdateSourceTrigger=LostFocus}" LostFocus="DataInspector_LostFocus" ToolTip="metric, imperial, or standard"/></StackPanel>
                                </Grid>
                                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Refresh sec" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedDataSource.RefreshSeconds, UpdateSourceTrigger=LostFocus}" LostFocus="DataInspector_LostFocus"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Status" Style="{StaticResource SectionCaption}"/><TextBlock Text="{Binding SelectedDataSource.Status}" Foreground="{StaticResource GoodBrush}" TextWrapping="Wrap"/></StackPanel>
                                </Grid>
                                <Separator Margin="0,12"/>
                                <TextBlock Text="LAYER GROUPS" Foreground="#B78BE7" FontWeight="SemiBold"/>
                                <TextBlock Text="Groups carry parent transforms/keyframes like a motion-graphics precomp." Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" Height="105" DisplayMemberPath="Name"/>
                                <WrapPanel Margin="0,5,0,0"><Button Content="ADD GROUP" Click="AddGroup_Click" Width="90"/><Button Content="PRECOMPOSE" Click="PrecomposeSelectedLayers_Click" Width="96"/><Button Content="DELETE" Click="DeleteGroup_Click" Width="70"/><Button Content="ASSIGN LAYER" Click="AssignGroup_Click" Width="104"/><Button Content="GROUP KF" Click="AddGroupKeyframe_Click" Width="82"/><Button Content="DEL KF" Click="DeleteGroupKeyframe_Click" Width="68"/><Button Content="CLEAR KF" Click="ClearGroupKeyframes_Click" Width="82"/></WrapPanel>
                                <TextBlock Text="GROUP KEYFRAMES" Style="{StaticResource SectionCaption}" Margin="0,8,0,2"/>
                                <ListBox ItemsSource="{Binding GroupKeyframes}" SelectedItem="{Binding SelectedGroupKeyframe, Mode=TwoWay}" Height="82"/>
                                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Time" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroupKeyframe.TimeSeconds, UpdateSourceTrigger=LostFocus}" LostFocus="GroupKeyframeInspector_LostFocus"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="X" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroupKeyframe.X, UpdateSourceTrigger=LostFocus}" LostFocus="GroupKeyframeInspector_LostFocus"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Y" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroupKeyframe.Y, UpdateSourceTrigger=LostFocus}" LostFocus="GroupKeyframeInspector_LostFocus"/></StackPanel>
                                </Grid>
                                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Scale X" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroupKeyframe.ScaleX, UpdateSourceTrigger=LostFocus}" LostFocus="GroupKeyframeInspector_LostFocus"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Scale Y" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroupKeyframe.ScaleY, UpdateSourceTrigger=LostFocus}" LostFocus="GroupKeyframeInspector_LostFocus"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Scale Z" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroupKeyframe.ScaleZ, UpdateSourceTrigger=LostFocus}" LostFocus="GroupKeyframeInspector_LostFocus"/></StackPanel>
                                </Grid>
                                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Rotate X" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroupKeyframe.RotationX, UpdateSourceTrigger=LostFocus}" LostFocus="GroupKeyframeInspector_LostFocus"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Rotate Y" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroupKeyframe.RotationY, UpdateSourceTrigger=LostFocus}" LostFocus="GroupKeyframeInspector_LostFocus"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Rotate Z" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroupKeyframe.Rotation, UpdateSourceTrigger=LostFocus}" LostFocus="GroupKeyframeInspector_LostFocus"/></StackPanel>
                                </Grid>
                                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Anchor X" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroupKeyframe.AnchorX, UpdateSourceTrigger=LostFocus}" LostFocus="GroupKeyframeInspector_LostFocus"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Anchor Y" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroupKeyframe.AnchorY, UpdateSourceTrigger=LostFocus}" LostFocus="GroupKeyframeInspector_LostFocus"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Position Z" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroupKeyframe.Z, UpdateSourceTrigger=LostFocus}" LostFocus="GroupKeyframeInspector_LostFocus"/></StackPanel>
                                </Grid>
                                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Anchor Z" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroupKeyframe.AnchorZ, UpdateSourceTrigger=LostFocus}" LostFocus="GroupKeyframeInspector_LostFocus"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Opacity" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroupKeyframe.Opacity, UpdateSourceTrigger=LostFocus}" LostFocus="GroupKeyframeInspector_LostFocus"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Ease" Style="{StaticResource SectionCaption}"/><ComboBox ItemsSource="{Binding Easings}" SelectedItem="{Binding SelectedGroupKeyframe.Ease}" SelectionChanged="GroupKeyframeInspector_SelectionChanged"/></StackPanel>
                                </Grid>
                                <CheckBox Content="HOLD GROUP KEYFRAME" IsChecked="{Binding SelectedGroupKeyframe.Hold}" Click="GroupKeyframeInspector_CheckChanged" Margin="0,5,0,0"/>
                                <TextBlock Text="Group name" Style="{StaticResource SectionCaption}" Margin="0,7,0,2"/><TextBox Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=LostFocus}" LostFocus="GroupInspector_LostFocus"/>
                                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Stagger sec" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroup.StaggerSeconds, UpdateSourceTrigger=LostFocus}" LostFocus="GroupInspector_LostFocus"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Stagger from" Style="{StaticResource SectionCaption}"/><ComboBox ItemsSource="{Binding StaggerFromOptions}" SelectedItem="{Binding SelectedGroup.StaggerFrom}" SelectionChanged="GroupInspector_SelectionChanged"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Repeat (-1∞)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedGroup.KeyframeRepeat, UpdateSourceTrigger=LostFocus}" LostFocus="GroupInspector_LostFocus"/></StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><CheckBox Content="VISIBLE" IsChecked="{Binding SelectedGroup.Visible}" Click="GroupInspector_CheckChanged" Style="{StaticResource ToggleSwitch}"/><CheckBox Content="YOYO" IsChecked="{Binding SelectedGroup.KeyframeYoyo}" Click="GroupInspector_CheckChanged" Margin="12,0,0,0"/></StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                </Grid>
            </Border>

            <!-- preview -->
            <Border x:Name="CanvasPanel" Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="52"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
                <Border Style="{StaticResource PanelHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="◀ UP" Width="54" Margin="0,0,8,0" Click="BackToParentComposition_Click" IsEnabled="{Binding IsInsidePrecomposition}" ToolTip="Return to the parent composition"/>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="PROGRAM GRAPHICS PREVIEW" FontWeight="SemiBold"/><TextBlock Text="{Binding CompositionPathText}" Foreground="White" FontSize="8.5"/><TextBlock Text="{Binding CanvasInfoText}" Foreground="{StaticResource MutedBrush}" FontSize="8.5"/></StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="GRID" IsChecked="{Binding ShowCanvasGrid, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Editor grid only; never rendered on-air." Margin="0,0,8,0"/>
                            <CheckBox Content="SAFE AREAS" IsChecked="{Binding ShowSafeAreas, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Show Action Safe and Title Safe guides. Editor only; never rendered on-air."/>
                            <ComboBox Width="188" Margin="8,0,0,0" ItemsSource="{Binding SafeAreaPresets}" SelectedItem="{Binding SafeAreaPreset, Mode=TwoWay}" ToolTip="Safe-area inset preset"/>
                            <CheckBox Content="CENTER" IsChecked="{Binding ShowCenterGuide, Mode=TwoWay}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Show horizontal and vertical center guides"/>
                            <Button x:Name="CanvasDockBtn" Content="DOCK OUT" Click="CanvasDockOut_Click" Height="22" MinHeight="22" Margin="10,0,0,0" Padding="8,0" ToolTip="Detach / Dock in canvas preview window"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Background="#020304"><Viewbox Stretch="Uniform"><Border x:Name="PreviewCanvasBorder" Width="960" Height="540" Background="#081018" BorderBrush="#263744" BorderThickness="1"><Canvas x:Name="PreviewCanvas" Width="960" Height="540" ClipToBounds="True" Focusable="True" UseLayoutRounding="False" SnapsToDevicePixels="False" Background="{StaticResource CgCheckerBrush}" MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown" PreviewMouseRightButtonDown="PreviewCanvas_PreviewMouseRightButtonDown" MouseMove="PreviewCanvas_MouseMove" MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp">
                            <Canvas.ContextMenu><ContextMenu>
                                <MenuItem Header="MOVE UP ONE LAYER" Click="MoveLayerUp_Click"/><MenuItem Header="MOVE DOWN ONE LAYER" Click="MoveLayerDown_Click"/>
                                <MenuItem Header="BRING TO FRONT" Click="BringToFront_Click"/><MenuItem Header="SEND TO BACK" Click="SendToBack_Click"/>
                                <Separator/><MenuItem Header="ALIGN TO CANVAS"><MenuItem Header="LEFT" Click="AlignLeft_Click"/><MenuItem Header="CENTER H" Click="AlignHorizontalCenter_Click"/><MenuItem Header="RIGHT" Click="AlignRight_Click"/><MenuItem Header="TOP" Click="AlignTop_Click"/><MenuItem Header="CENTER V" Click="AlignVerticalCenter_Click"/><MenuItem Header="BOTTOM" Click="AlignBottom_Click"/></MenuItem>
                                <Separator/>
                                <MenuItem Header="3D TRANSFORM &amp; DISTORT">
                                    <MenuItem Header="ROTATE 90° CW" Click="Rotate90Cw_Click"/>
                                    <MenuItem Header="ROTATE 90° CCW" Click="Rotate90Ccw_Click"/>
                                    <MenuItem Header="RESET ROTATION" Click="ResetRotation_Click"/>
                                    <Separator/>
                                    <MenuItem Header="SKEW RIGHT (+15°)" Tag="15" Click="ApplySkew_Click"/>
                                    <MenuItem Header="SKEW LEFT (-15°)" Tag="-15" Click="ApplySkew_Click"/>
                                    <MenuItem Header="RESET SKEW" Tag="0" Click="ApplySkew_Click"/>
                                    <Separator/>
                                    <MenuItem Header="3D PERSPECTIVE TILT (X +20°)" Tag="TiltX" Click="Apply3dTilt_Click"/>
                                    <MenuItem Header="3D PERSPECTIVE TILT (Y +20°)" Tag="TiltY" Click="Apply3dTilt_Click"/>
                                    <MenuItem Header="RESET 3D TILT" Tag="Reset" Click="Apply3dTilt_Click"/>
                                    <Separator/>
                                    <MenuItem Header="WARP: SLANTED TICKER" Tag="SlantedTicker" Click="ApplyWarpPreset_Click"/>
                                    <MenuItem Header="WARP: 3D NEWS STRIP" Tag="NewsStrip" Click="ApplyWarpPreset_Click"/>
                                    <MenuItem Header="WARP: PARALLELOGRAM" Tag="Parallelogram" Click="ApplyWarpPreset_Click"/>
                                    <MenuItem Header="WARP: RESET ALL" Tag="Reset" Click="ApplyWarpPreset_Click"/>
                                </MenuItem>
                                <Separator/><MenuItem Header="MASK FROM ELEMENT" Click="MaskFromElement_Click"/><MenuItem Header="DRAW MASK" Click="DrawMask_Click"/><MenuItem Header="CLEAR MASK" Click="ClearMask_Click"/>
                                <Separator/><MenuItem Header="PRECOMPOSE SELECTED" Click="PrecomposeSelectedLayers_Click"/><MenuItem Header="DELETE" Click="DeleteSelectedLayers_Click"/>
                            </ContextMenu></Canvas.ContextMenu>
                        </Canvas></Border></Viewbox></Grid>
                <Grid Grid.Row="2" Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="▶" Click="Play_Click" Width="46"/>
                    <Slider x:Name="PlayheadSlider" Grid.Column="1" Minimum="0" Maximum="{Binding ProjectDuration}" Value="{Binding Playhead, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SeekSlider}" Margin="8,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding PlayheadText}" Style="{StaticResource TimecodeText}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <CheckBox Grid.Column="3" Content="LOOP" IsChecked="{Binding Loop}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- inspector -->
        <Border x:Name="InspectorPanel" Grid.Column="2" Style="{StaticResource PanelBorder}" PreviewMouseWheel="NumericInspector_MouseWheel" PreviewKeyDown="NumericInspector_PreviewKeyDown">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource PanelHeader}" Padding="10,4">
                        <Grid>
                            <TextBlock Text="INSPECTOR / PROPERTIES" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="InspectorDockBtn" Content="DOCK OUT" Click="InspectorDockOut_Click" Height="22" MinHeight="22" Padding="8,0" HorizontalAlignment="Right" ToolTip="Detach / Dock in Inspector window"/>
                        </Grid>
                    </Border>
                    <TabControl Grid.Row="1">
                    <TabItem Header="LAYER">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="10">
                            <TextBlock Text="SELECTED ELEMENT" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Properties, transforms, styles, typography, and animation for the selected element." Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,2,0,8"/>

                            <!-- CARD 1: TRANSFORM & 3D GEOMETRY -->
                            <Border Background="#0C1219" BorderBrush="#202A36" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Cursor="Hand" Background="Transparent" MouseLeftButtonUp="ToggleCardHeader_Click">
                                        <TextBlock Text="▼" DockPanel.Dock="Right" Foreground="#B78BE7" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="TRANSFORM &amp; 3D GEOMETRY · 3D TRANSFORM" Foreground="#B78BE7" FontWeight="SemiBold" FontSize="11"/>
                                    </DockPanel>
                                    <StackPanel Margin="0,8,0,0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Name" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.Name, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Type" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.Type}" IsReadOnly="True"/></StackPanel>
                                        </Grid>
                                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="X" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.X, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Y" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.Y, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="4"><TextBlock Text="Z" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.Z, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                        </Grid>
                                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Scale X" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.ScaleX, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Scale Y" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.ScaleY, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="4"><TextBlock Text="Scale Z" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.ScaleZ, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                        </Grid>
                                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Rotate X" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.RotationX, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Rotate Y" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.RotationY, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="4"><TextBlock Text="Rotate Z" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.Rotation, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                        </Grid>
                                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Skew X (-70..70)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.SkewX, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Skew Y (-70..70)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.SkewY, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="4"><TextBlock Text="Perspective" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.Perspective, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                        </Grid>
                                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Anchor X 0-1" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.AnchorX, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Anchor Y 0-1" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.AnchorY, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="4"><TextBlock Text="Anchor Z" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.AnchorZ, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                        </Grid>
                                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Width" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.Width, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Height" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.Height, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="4"><TextBlock Text="Opacity" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.Opacity, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                        </Grid>
                                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Start sec" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.StartSeconds, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="End sec" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.EndSeconds, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="4"><TextBlock Text="Duration" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.DurationSeconds, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus" ToolTip="Layer duration in seconds"/></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: FILL, OUTLINE & APPEARANCE -->
                            <Border Visibility="{Binding CardFillOutlineVisibility}" Background="#0C1219" BorderBrush="#202A36" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Cursor="Hand" Background="Transparent" MouseLeftButtonUp="ToggleCardHeader_Click">
                                        <TextBlock Text="▶" DockPanel.Dock="Right" Foreground="#B78BE7" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="FILL, OUTLINE &amp; APPEARANCE" Foreground="#B78BE7" FontWeight="SemiBold" FontSize="11"/>
                                    </DockPanel>
                                    <StackPanel Visibility="Collapsed" Margin="0,8,0,0">
                                        <StackPanel Visibility="{Binding CardShapeKindVisibility}">
                                            <TextBlock Text="Shape kind" Style="{StaticResource SectionCaption}"/><ComboBox ItemsSource="{Binding ShapeKinds}" SelectedItem="{Binding SelectedLayer.ShapeKind}" SelectionChanged="Inspector_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                            <TextBlock Text="Background fill" Style="{StaticResource SectionCaption}" VerticalAlignment="Center"/>
                                            <CheckBox Content="USE BACKGROUND" IsChecked="{Binding SelectedLayer.UseBackground}" Click="Inspector_CheckChanged" Margin="14,0,0,0" ToolTip="Enable background color fill on this text/date/shape element"/>
                                        </StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><Border Height="28" Background="{Binding SelectedLayer.Background}" BorderBrush="#59636F" BorderThickness="1" CornerRadius="3"/><Button Grid.Column="2" Content="PICK COLOR" Tag="Background" Click="ColorPicker_Click"/></Grid>
                                        <TextBlock Text="Outline / Border" Style="{StaticResource SectionCaption}" Margin="0,6,0,2"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="78"/><ColumnDefinition Width="6"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><Border Height="28" Background="{Binding SelectedLayer.BorderColor}" BorderBrush="#59636F" BorderThickness="1" CornerRadius="3"/><TextBox Grid.Column="2" Text="{Binding SelectedLayer.BorderWidth, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/><Button Grid.Column="4" Content="PICK COLOR" Tag="BorderColor" Click="ColorPicker_Click"/></Grid>
                                        <TextBlock Text="CORNER RADIUS · EACH CORNER" Foreground="#93A0A8" FontWeight="SemiBold" Margin="0,8,0,3"/>
                                        <CheckBox Content="RADIUS AS % OF SHORTEST SIDE (0-50%)" IsChecked="{Binding SelectedLayer.CornerRadiusAsPercent}" Click="Inspector_CheckChanged"/>
                                        <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Top L %" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.CornerRadiusTopLeftPercent, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Top R %" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.CornerRadiusTopRightPercent, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="4"><TextBlock Text="Bottom R %" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.CornerRadiusBottomRightPercent, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                            <StackPanel Grid.Column="6"><TextBlock Text="Bottom L %" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.CornerRadiusBottomLeftPercent, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus"/></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: MULTI-COLOR GRADIENT & PALETTES -->
                            <Border Visibility="{Binding CardGradientVisibility}" Background="#0C1219" BorderBrush="#202A36" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Cursor="Hand" Background="Transparent" MouseLeftButtonUp="ToggleCardHeader_Click">
                                        <TextBlock Text="▶" DockPanel.Dock="Right" Foreground="#B78BE7" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="MULTI-COLOR GRADIENT &amp; PALETTES" Foreground="#B78BE7" FontWeight="SemiBold" FontSize="11"/>
                                    </DockPanel>
                                    <StackPanel Visibility="Collapsed" Margin="0,8,0,0">
                                        <CheckBox Content="USE GRADIENT" IsChecked="{Binding SelectedLayer.UseGradient}" Click="Inspector_CheckChanged"/>
                                        <Grid Margin="0,5,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Gradient angle" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedLayer.GradientAngle, UpdateSourceTrigger=LostFocus}" LostFocus="Inspector_LostFocus" ToolTip="Up/Down changes angle; Shift=10°, Ctrl=0.1°"/></StackPanel>
                                            <Button Grid.Column="2" Content="ADD STOP" Click="AddGradientStop_Click" VerticalAlignment="Bottom"/>
                                        </Grid>
                                        <WrapPanel Margin="0,0,0,4">
                                            <Button Content="0°" Tag="0" Click="SetGradientAngle_Click" Margin="1" Padding="5,2" FontSize="8.5"/>
                                            <Button Content="45°" Tag="45" Click="SetGradientAngle_Click" Margin="1" Padding="5,2" FontSize="8.5"/>
                                            <Button Content="90°" Tag="90" Click="SetGradientAngle_Click" Margin="1" Padding="5,2" FontSize="8.5"/>
                                            <Button Content="135°" Tag="135" Click="SetGradientAngle_Click" Margin="1" Padding="5,2" FontSize="8.5"/>
                                            <Button Content="180°" Tag="180" Click="SetGradientAngle_Click" Margin="1" Padding="5,2" FontSize="8.5"/>
                                            <Button Content="270°" Tag="270" Click="SetGradientAngle_Click" Margin="1" Padding="5,2" FontSize="8.5"/>
                                        </WrapPanel>
                                        <ListBox x:Name="GradientStopList" ItemsSource="{Binding SelectedLayer.GradientStops}" SelectedItem="{Binding SelectedGradientStop, Mode=TwoWay}" MaxHeight="140" Background="#080D12" BorderBrush="#303842" BorderThickness="1">
                                            <ListBox.ItemTemplate><DataTemplate><Grid Margin="3"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="74"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                                                <Border Background="{Binding Color}" BorderBrush="#59636F" BorderThickness="1" CornerRadius="2" Margin="1"/>
                                                <TextBox Grid.Column="1" Text="{Binding Color, UpdateSourceTrigger=LostFocus}" LostFocus="GradientStop_LostFocus" Margin="3,0"/>
                                                <TextBox Grid.Column="2" Text="{Binding Offset, UpdateSourceTrigger=LostFocus}" LostFocus="GradientStop_LostFocus" ToolTip="0.0 to 1.0; Up/Down adjusts"/>
                                                <Button Grid.Column="3" Content="PICK" Click="PickGradientStopColor_Click" Padding="3"/>
                                            </Grid></DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Content="REMOVE SELECTED STOP" Click="RemoveGradientStop_Click" Margin="0,4,0,6"/>

                                        <!-- Quick Palette Button placed below gradient as requested by user -->
                                        <Button x:Name="QuickPaletteBtn" Content="🎨 QUICK COLOR PALETTES ▾" Click="ToggleQuickPaletteModal_Click" Height="27" Background="#141F2B" BorderBrush="#00E5FF" Foreground="#00E5FF" FontWeight="SemiBold" ToolTip="Open broadcast brand color palettes (Prime HD, Space 4K, Ruby Red, etc.)"/>
                                        <Popup x:Name="QuickPalettePopup" PlacementTarget="{Binding ElementName=QuickPaletteBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                            <Border Background="#090E14" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="10" Width="360">
                                                <StackPanel>
                                                    <TextBlock Text="BROADCAST COLOR STYLES · PREDEFINED LOOKS · QUICK PALETTE" Foreground="#E5A93C" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                                    <WrapPanel>
                                                        <Button Content="AP1 HD RUBY" Tag="Ap1Hd" Click="ChannelBrandStyle_Click" Background="#2E0A12" BorderBrush="#FFEF233C" Foreground="#FFF" Margin="2" Padding="6,4" FontSize="9"/>
                                                        <Button Content="RUBY RED" Tag="RedAlert" Click="ChannelBrandStyle_Click" Background="#2B0505" BorderBrush="#FFAF0303" Margin="2" Padding="6,4" FontSize="9"/>
                                                        <Button Content="CYAN ELECTRIC" Tag="Space4k" Click="ChannelBrandStyle_Click" Background="#05182B" BorderBrush="#FF00E5FF" Margin="2" Padding="6,4" FontSize="9"/>
                                                        <Button Content="GOLD AMBER" Tag="SportsPro" Click="ChannelBrandStyle_Click" Background="#2B1D05" BorderBrush="#FFF59E0B" Margin="2" Padding="6,4" FontSize="9"/>
                                                        <Button Content="GLASS FROST" Tag="CrystalGlass" Click="ChannelBrandStyle_Click" Background="#0C1B2E" BorderBrush="#FF88D6F2" Margin="2" Padding="6,4" FontSize="9"/>
                                                        <Button Content="SPORTS VIVID" Tag="PrimeHd" Click="ChannelBrandStyle_Click" Background="#1D1F08" BorderBrush="#FFFF9900" Margin="2" Padding="6,4" FontSize="9"/>
                                                        <Button Content="EMERALD NEWS" Tag="FinancePulse" Click="ChannelBrandStyle_Click" Background="#081E13" BorderBrush="#FF22C55E" Margin="2" Padding="6,4" FontSize="9"/>
                                                        <Button Content="PURPLE ROYAL" Tag="ElectionDesk" Click="ChannelBrandStyle_Click" Background="#1A0D2E" BorderBrush="#FF8B5CF6" Margin="2" Padding="6,4" FontSize="9"/>
                                                        <Button Content="SKY PULSE" Tag="Weather3d" Click="ChannelBrandStyle_Click" Background="#061F2E" BorderBrush="#FF38BDF8" Margin="2" Padding="6,4" FontSize="9"/>
                                                        <Button Content="MAGENTA GLOW" Tag="EntertainmentNeon" Click="ChannelBrandStyle_Click" Background="#2B071D" BorderBrush="#FFEC4899" Margin="2" Padding="6,4" FontSize="9"/>
                                                        <Button Content="SLATE MINIMAL" Tag="ModernMinimal" Click="ChannelBrandStyle_Click" Background="#171A21" BorderBrush="#FF94A3B8" Margin="2" Padding="6,4" FontSize="9"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- CARD 4: TYPOGRAPHY -->
                            <Border Visibility="{Binding CardTypographyVisibility}" Background="#0C1219" BorderBrush="#202A36" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Cursor="Hand" Background="Transparent" MouseLeftButtonUp="ToggleCardHeader_Click">
                                        <TextBlock Text="▶" DockPanel.Dock="Right" Foreground="#B78BE7" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="TYPOGRAPHY" Foreground="#B78BE7" FontWeight="SemiBold" FontSize="11"/>
                                    </DockPanel>
