                                            <Button Content="+ {Timer}" Tag="{}{Timer}" Click="InsertVariable_Click" Margin="2" Padding="6,3" FontSize="9" Background="#172230" BorderBrush="#FBBF24" Foreground="#FBBF24" ToolTip="Dynamic Timer / Countdown"/>
                                            <Button Content="+ {NextTitle}" Tag="{}{NextTitle}" Click="InsertVariable_Click" Margin="2" Padding="6,3" FontSize="9" Background="#172230" BorderBrush="#F472B6" Foreground="#F472B6" ToolTip="Next Coming Up Title"/>
                                            <Button Content="+ {NextArtist}" Tag="{}{NextArtist}" Click="InsertVariable_Click" Margin="2" Padding="6,3" FontSize="9" Background="#172230" BorderBrush="#F472B6" Foreground="#F472B6" ToolTip="Next Coming Up Artist"/>
                                            <Button Content="+ {Description}" Tag="{}{Description}" Click="InsertVariable_Click" Margin="2" Padding="6,3" FontSize="9" Background="#172230" BorderBrush="#FBBF24" Foreground="#FBBF24" ToolTip="Description / Synopsis"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- CARD 4B: DYNAMIC TIMER & COUNTDOWN (INCREMENT / DECREMENT / BACK IN) -->
                            <Border Visibility="{Binding CardTimerVisibility}" Background="#0C1219" BorderBrush="#202A36" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Cursor="Hand" Background="Transparent" MouseLeftButtonUp="ToggleCardHeader_Click">
                                        <TextBlock Text="▶" DockPanel.Dock="Right" Foreground="#F59E0B" FontSize="11" VerticalAlignment="Center"/>
