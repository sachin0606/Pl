<Window x:Class="BroadcastPlayout.Views.ChannelControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Channel Controller" Width="1680" Height="950" MinWidth="1320" MinHeight="780"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-channelcontroller.ico">
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#080C12" BorderBrush="#39204A" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="KASHTRIX CHANNEL CONTROLLER" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Multi-channel client playout supervision · shared graphics routing" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1C1129" BorderBrush="#5A2B78" BorderThickness="1" CornerRadius="5" Padding="12,6" Margin="4"><StackPanel Orientation="Horizontal"><TextBlock Text="ONLINE  " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ConnectedCount}" Foreground="{StaticResource GoodBrush}" FontWeight="Bold"/></StackPanel></Border>
                    <Border Background="#1C1129" BorderBrush="#5A2B78" BorderThickness="1" CornerRadius="5" Padding="12,6" Margin="4"><StackPanel Orientation="Horizontal"><TextBlock Text="CHANNELS  " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding TotalChannelCount}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/></StackPanel></Border>
                    <Border Background="#2A112D" BorderBrush="{StaticResource PinkBrush}" BorderThickness="1" CornerRadius="5" Padding="12,6" Margin="4"><StackPanel Orientation="Horizontal"><TextBlock Text="TARGETS  " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SelectedTargetCount}" Foreground="{StaticResource PinkBrush}" FontWeight="Bold"/></StackPanel></Border>
                    <TextBlock Text="{Binding ListenerStatus}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="DEMO DATA" Click="LoadDemo_Click" Style="{StaticResource DemoActionButton}"/>
                    <Button Content="MANAGE CHANNELS" Click="Manage_Click"/>
                    <TextBlock x:Name="ClockText" FontFamily="Digital-7, DSEG7 Classic, Consolas" FontSize="20" Margin="12,0" VerticalAlignment="Center"/>
                    <Button Click="Minimize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button>
                    <Button Click="Maximize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button>
                    <Button Click="Close_Click" Style="{StaticResource WindowCloseButton}"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="8">
                <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="CHANNELS" FontWeight="Bold"/><TextBlock Text="Unique client identities" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel><Button Grid.Column="1" Content="+ ADD" Click="Manage_Click"/></Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel, Mode=TwoWay}">
                        <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#30203C" BorderThickness="0,0,0,1" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Index, StringFormat=00}" Foreground="{StaticResource PinkBrush}" FontWeight="Bold" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Status.ChannelName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status.ChannelId}" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="{Binding Status.Format}" Foreground="{StaticResource AccentBrush}" FontSize="9"/></StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right"><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="TARGET"/><TextBlock Text="{Binding Status.State}" Foreground="{Binding StateBrush}" FontSize="9" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel>
                        </Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="4,8,4,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="SELECT ALL" Click="SelectAll_Click"/><Button Grid.Column="1" Content="CLEAR" Click="ClearTargets_Click"/></Grid><Button Content="ADD / EDIT / REMOVE CHANNELS" Click="Manage_Click" Background="#261439" BorderBrush="{StaticResource PinkBrush}"/></StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="245"/></Grid.RowDefinitions>
                <Border Style="{StaticResource PanelBorder}" Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Channels}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Width="300" Height="238" Margin="5" Padding="8" Background="#0A0F16" BorderBrush="#4B2860" BorderThickness="1" CornerRadius="5" MouseLeftButtonDown="ChannelCard_Click" Tag="{Binding}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="112"/><RowDefinition Height="44"/><RowDefinition/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Status.ChannelId}" Foreground="{StaticResource PinkBrush}" FontWeight="Bold"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding Status.ChannelName}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status.State}" Foreground="{Binding StateBrush}"/></Grid>
                                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Background="#020304" BorderBrush="#39234B" BorderThickness="1"><Grid><Image Source="{Binding ProgramImage}" Stretch="UniformToFill"/><TextBlock Text="PROGRAM" Background="#AA120C17" Foreground="{StaticResource GoodBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,2"/><TextBlock Text="{Binding Status.ProgramTitle}" Background="#B0000000" VerticalAlignment="Bottom" Padding="5,3" TextTrimming="CharacterEllipsis"/></Grid></Border>
                                    <Border Grid.Column="2" Background="#020304" BorderBrush="#39234B" BorderThickness="1"><Grid><Image Source="{Binding PreviewImage}" Stretch="UniformToFill"/><TextBlock Text="PREVIEW" Background="#AA120C17" Foreground="{StaticResource PinkBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,2"/><TextBlock Text="{Binding Status.NextTitle}" Background="#B0000000" VerticalAlignment="Bottom" Padding="5,3" TextTrimming="CharacterEllipsis"/></Grid></Border>
                                </Grid>
                                <Grid Grid.Row="2" Margin="2,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="NEXT" Style="{StaticResource SectionCaption}"/><TextBlock Text="{Binding Status.NextTitle}" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ELAPSED" Style="{StaticResource SectionCaption}"/><TextBlock Text="{Binding ElapsedText}" FontFamily="Digital-7, DSEG7 Classic, Consolas"/></StackPanel></Grid>
                                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ProgressBar Width="78" Height="5" Maximum="1" Value="{Binding Status.AudioLeft, Mode=OneWay}" Foreground="{StaticResource MeterGradientBrush}"/><ProgressBar Width="78" Height="5" Maximum="1" Value="{Binding Status.AudioRight, Mode=OneWay}" Foreground="{StaticResource MeterGradientBrush}" Margin="5,0,0,0"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="TARGET" Foreground="{StaticResource PinkBrush}"/></Grid>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </Border>

                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="40*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="30*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="30*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorder}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="SELECTED CHANNEL CONFIDENCE" FontWeight="Bold"/><Border Grid.Row="1" Background="#020304" BorderBrush="#5D2B78" BorderThickness="1" Margin="0,8"><Image Source="{Binding SelectedChannel.ProgramImage}" Stretch="Uniform"/></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedChannel.Status.ChannelName}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedChannel.Status.ProgramTitle}" Foreground="{StaticResource AccentBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SelectedChannel.Status.ChannelId}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid></Grid></Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="10"><StackPanel><TextBlock Text="GRAPHIC ROUTE" FontWeight="Bold"/><ComboBox ItemsSource="{Binding Graphics}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedGraphic, Mode=TwoWay}" Margin="0,10,0,0"/><TextBlock Text="One asset can play on many target channels; each channel can simultaneously receive a different asset from another operator action." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="{Binding SelectedTargetCount, StringFormat={}{0} target(s) selected}" Foreground="{StaticResource PinkBrush}" Margin="0,8,0,0"/></StackPanel></Border>
                    <Border Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="CONTROLLER EVENTS" FontWeight="Bold"/><ListBox Grid.Row="1" ItemsSource="{Binding Logs}" FontFamily="Digital-7, DSEG7 Classic, Consolas" FontSize="9" Margin="0,8,0,0"/></Grid></Border>
                </Grid>
            </Grid>

            <Border Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="210"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SHARED CG ENGINE" FontSize="17" FontWeight="Bold"/><TextBlock Text="Single graphics library · multi-channel targets" Foreground="{StaticResource MutedBrush}"/></StackPanel><Button Grid.Column="1" Content="OPEN CG" Click="OpenCg_Click"/></Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Graphics}" SelectedItem="{Binding SelectedGraphic, Mode=TwoWay}" Margin="0,10,0,0"><ListBox.ItemTemplate><DataTemplate><Border Padding="7" BorderBrush="#3C2550" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Layers.Count, StringFormat={}{0} native layers}" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <Grid Grid.Row="2" Margin="0,10,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="ROUTING / ASSIGNMENT" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="ALL" Click="SelectAll_Click"/><Button Content="NONE" Click="ClearTargets_Click"/></StackPanel></Grid>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding Channels}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="30"><DataGrid.Columns><DataGridCheckBoxColumn Header="TARGET" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="68"/><DataGridTextColumn Header="ID" Binding="{Binding Status.ChannelId, Mode=OneWay}" Width="90"/><DataGridTextColumn Header="CHANNEL" Binding="{Binding Status.ChannelName, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="STATE" Binding="{Binding Status.State, Mode=OneWay}" Width="72"/></DataGrid.Columns></DataGrid>
                    <StackPanel Grid.Row="4" Margin="0,10,0,0"><Button Content="PLAY GRAPHIC TO TARGETS" Click="PlayCg_Click" Height="45" Background="#5A1775" BorderBrush="{StaticResource PinkBrush}" FontWeight="Bold"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="PREVIEW" Click="PreviewCg_Click"/><Button Grid.Column="1" Content="STOP CG" Click="StopCg_Click" Background="#3C121C" BorderBrush="{StaticResource OnAirBrush}"/></Grid></StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#080C12" BorderBrush="#39204A" BorderThickness="0,1,0,0"><Grid Margin="12,0"><TextBlock Text="Each playout client reports a unique Channel ID. Configured offline channels remain visible and become ONLINE automatically when the matching client connects." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
</Window>
