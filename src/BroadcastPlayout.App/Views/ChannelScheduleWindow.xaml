<Window x:Class="BroadcastPlayout.Views.ChannelScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Kashtrix Channel Schedule" Width="1600" Height="940" MinWidth="1240" MinHeight="720" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True"
        Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-scheduler.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Readable dates on the dark theme (the stock date box draws dim grey text). -->
        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#0B1016"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>
        <Style TargetType="primitives:DatePickerTextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#0B1016"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldCaption" TargetType="TextBlock" BasedOn="{StaticResource SectionCaption}">
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="LaneItem" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left, Mode=OneWay}"/>
        </Style>
        <DataTemplate x:Key="LaneBlockTemplate">
            <Border Width="{Binding Width, Mode=OneWay}" Height="28" Background="{Binding Color, Mode=OneWay}" BorderBrush="#0B0F14" BorderThickness="0,0,1,0" ToolTip="{Binding ToolTip, Mode=OneWay}">
                <TextBlock Text="{Binding Label, Mode=OneWay}" Foreground="White" FontSize="10" Margin="4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Border Grid.Row="0" Background="#080D12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TitleText, Mode=OneWay}" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Spot Ad › News › Live › Movie › Programme › Filler  ·  CG overlays run alongside" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="CHANNEL" Style="{StaticResource SectionCaption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="170" ItemsSource="{Binding Channels}" SelectedItem="{Binding ChannelId, Mode=TwoWay}" ToolTip="Each channel has its own schedule"/>
                    <CheckBox Content="SCHEDULE AUTOMATION" IsChecked="{Binding AutomationEnabled, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" Margin="22,0,0,0" VerticalAlignment="Center" ToolTip="ON: the channel follows this schedule. OFF: manual operation, exactly as before."/>
                    <TextBlock Text="{Binding RunnerStatusText, Mode=OneWay}" Foreground="{StaticResource GoodBrush}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="VALIDATE" Click="Validate_Click"/>
                    <Button Content="RELOAD" Click="Reload_Click"/>
                    <Button Content="SAVE" Click="Save_Click" Background="#321445" BorderBrush="{StaticResource PinkBrush}"/>
                    <Button Click="Minimize_Click" Style="{StaticResource WindowControlButton}" ToolTip="Minimize"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button>
                    <Button Click="Maximize_Click" Style="{StaticResource WindowControlButton}" ToolTip="Maximize / Restore"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button>
                    <Button Click="Close_Click" Style="{StaticResource WindowCloseButton}" ToolTip="Close"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>

            <!-- LEFT: TYPES -->
            <Border Style="{StaticResource PanelBorder}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="SCHEDULE TYPES" Style="{StaticResource PanelTitle}" Margin="4,2,4,8"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="180" Margin="2,5">
                                    <TextBlock Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Count, Mode=OneWay, StringFormat=({0})}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="{Binding AddButtonText, Mode=OneWay}" Click="Add_Click" Height="34" Background="#321445" BorderBrush="{StaticResource PinkBrush}"/>
                        <TextBlock Text="Pick a type, then ADD. The default filler (00:00 every day) always exists." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,8,2,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CENTER: DAY PLAN + LIST -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource PanelHeader}">
                            <Grid>
                                <TextBlock Text="DAY PLAN · what plays when" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="DATE" Style="{StaticResource SectionCaption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <DatePicker SelectedDate="{Binding PlanDate, Mode=TwoWay}" Width="160" Height="28" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="6">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding LaneHours}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Width="90" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0"><TextBlock Text="{Binding Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="3,0"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="VIDEO" Style="{StaticResource SectionCaption}" Margin="0,4,0,2"/>
                                <ItemsControl ItemsSource="{Binding VideoLane}" ItemTemplate="{StaticResource LaneBlockTemplate}" ItemContainerStyle="{StaticResource LaneItem}" Height="28" Width="2160">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Background="#0B1016"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Text="CG OVERLAYS" Style="{StaticResource SectionCaption}" Margin="0,6,0,2"/>
                                <ItemsControl ItemsSource="{Binding CgLane}" ItemTemplate="{StaticResource LaneBlockTemplate}" ItemContainerStyle="{StaticResource LaneItem}" Height="28" Width="2160">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Background="#0B1016"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                    <DataGrid x:Name="ScheduleGrid" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected, Mode=TwoWay}" IsReadOnly="True" CanUserAddRows="False" RowHeight="32" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="ON" Binding="{Binding Enabled, Mode=OneWay}" Width="44"/>
                            <DataGridTextColumn Header="TYPE" Binding="{Binding KindText, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="NAME" Binding="{Binding Name, Mode=OneWay}" Width="1.2*"/>
                            <DataGridTextColumn Header="TIME" Binding="{Binding TimeText, Mode=OneWay}" Width="170"/>
                            <DataGridTextColumn Header="WHEN" Binding="{Binding WhenText, Mode=OneWay}" Width="200"/>
                            <DataGridTextColumn Header="SOURCE" Binding="{Binding SourceText, Mode=OneWay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- RIGHT: EDITOR -->
            <Border Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="12" IsEnabled="{Binding IsEditable, Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="EDIT" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding KindHint, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"/>

                        <TextBlock Text="TYPE" Style="{StaticResource FieldCaption}"/>
                        <ComboBox ItemsSource="{Binding KindChoices}" SelectedItem="{Binding Selected.Kind, Mode=TwoWay}" IsEnabled="{Binding KindEditable, Mode=OneWay}"/>
                        <TextBlock Text="NAME" Style="{StaticResource FieldCaption}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Selected.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <CheckBox Grid.Column="1" Content="ENABLED" IsChecked="{Binding Selected.Enabled, Mode=TwoWay}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- WHEN: one repeat choice decides which date/day controls appear -->
                        <StackPanel Visibility="{Binding ShowWhen, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="REPEAT" Style="{StaticResource FieldCaption}"/>
                            <ComboBox ItemsSource="{Binding RepeatChoices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedRepeat, Mode=TwoWay}"/>

                            <StackPanel Visibility="{Binding IsOnce, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="DATE" Style="{StaticResource FieldCaption}"/>
                                <DatePicker SelectedDate="{Binding OnceDate, Mode=TwoWay}" Height="28" HorizontalAlignment="Left" Width="200"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsSelectedDays, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="DAYS" Style="{StaticResource FieldCaption}"/>
                                <WrapPanel>
                                    <CheckBox Content="Mon" IsChecked="{Binding Mon, Mode=TwoWay}" Margin="0,0,10,4"/>
                                    <CheckBox Content="Tue" IsChecked="{Binding Tue, Mode=TwoWay}" Margin="0,0,10,4"/>
                                    <CheckBox Content="Wed" IsChecked="{Binding Wed, Mode=TwoWay}" Margin="0,0,10,4"/>
                                    <CheckBox Content="Thu" IsChecked="{Binding Thu, Mode=TwoWay}" Margin="0,0,10,4"/>
                                    <CheckBox Content="Fri" IsChecked="{Binding Fri, Mode=TwoWay}" Margin="0,0,10,4"/>
                                    <CheckBox Content="Sat" IsChecked="{Binding Sat, Mode=TwoWay}" Margin="0,0,10,4"/>
                                    <CheckBox Content="Sun" IsChecked="{Binding Sun, Mode=TwoWay}" Margin="0,0,10,4"/>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding CanLimitDates, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                <CheckBox Content="{Binding LimitDatesLabel, Mode=OneWay}" IsChecked="{Binding LimitDates, Mode=TwoWay}"/>
                                <Grid Margin="0,6,0,0" Visibility="{Binding ShowDateRange, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="FROM" Style="{StaticResource FieldCaption}" Margin="0,0,0,4"/>
                                        <DatePicker SelectedDate="{Binding ValidFrom, Mode=TwoWay}" Height="28"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="UNTIL (empty = no end)" Style="{StaticResource FieldCaption}" Margin="0,0,0,4"/>
                                        <DatePicker SelectedDate="{Binding ValidUntil, Mode=TwoWay}" Height="28"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding NoLimitText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="22,2,0,0"
                                           Visibility="{Binding ShowNoLimitText, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Visibility="{Binding UsesWindow, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="START (HH:mm:ss)" Style="{StaticResource FieldCaption}"/>
                                <TextBox Text="{Binding StartTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Visibility="{Binding UsesEndTime, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="END (empty = by length)" Style="{StaticResource FieldCaption}"/>
                                <TextBox Text="{Binding EndTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding UsesTimes, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="AIR TIMES (e.g. 06:30, 12:00, 18:45)" Style="{StaticResource FieldCaption}"/>
                            <TextBox Text="{Binding TimesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>

                        <Border Background="#16233A" BorderBrush="#2F5C9E" BorderThickness="1" Padding="10,8" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="WHEN IT PLAYS" FontSize="10" FontWeight="Bold" Foreground="#8FB8FF"/>
                                <TextBlock Text="{Binding WhenSummary, Mode=OneWay}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Media files / folders / playlists -->
                        <StackPanel Visibility="{Binding IsMediaSource, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="SOURCES (files, folders or playlists)" Style="{StaticResource FieldCaption}"/>
                            <ListBox x:Name="SourceListBox" ItemsSource="{Binding SourceList, Mode=OneWay}" Height="120"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="+ FILES" Click="AddFiles_Click"/>
                                <Button Content="+ FOLDER" Click="AddFolder_Click"/>
                                <Button Content="+ PLAYLIST" Click="AddPlaylist_Click"/>
                                <Button Content="▲" Click="SourceUp_Click" ToolTip="Move up"/>
                                <Button Content="▼" Click="SourceDown_Click" ToolTip="Move down"/>
                                <Button Content="REMOVE" Click="RemoveSource_Click"/>
                            </WrapPanel>
                            <CheckBox Content="Shuffle" IsChecked="{Binding Shuffle, Mode=TwoWay}" Margin="0,8,0,0" Visibility="{Binding IsFiller, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}">
                                <Run Text="Measured length: "/><Run Text="{Binding PlannedDurationText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Live -->
                        <StackPanel Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="STREAM URL (rtmp:// srt:// udp:// http(s):// ...)" Style="{StaticResource FieldCaption}"/>
                            <TextBox Text="{Binding LiveUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            <CheckBox Content="Stay on air until cut manually" IsChecked="{Binding LiveUntilManualCut, Mode=TwoWay}" Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- Spot ad -->
                        <StackPanel Visibility="{Binding IsSpot, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="SPOT AD" Style="{StaticResource FieldCaption}"/>
                            <CheckBox Content="CG ad (instead of a video file)" IsChecked="{Binding SpotIsCg, Mode=TwoWay}"/>
                            <CheckBox Content="Wait for the current clip to end (default: cut on time)" IsChecked="{Binding SpotWaitsForClip, Mode=TwoWay}" Margin="0,6,0,0" Visibility="{Binding IsMediaSource, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- CG templates -->
                        <StackPanel Visibility="{Binding IsCgSource, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="CG TEMPLATES (bottom ads loop in this order)" Style="{StaticResource FieldCaption}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding CgTemplates}" SelectedItem="{Binding SelectedCgTemplate, Mode=TwoWay}"/>
                                <Button Grid.Column="1" Content="ADD" Click="AddCg_Click"/>
                            </Grid>
                            <ListBox x:Name="CgListBox" ItemsSource="{Binding CgList, Mode=OneWay}" Height="90" Margin="0,6,0,0"/>
                            <Button Content="REMOVE" Click="RemoveCg_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LAYER" Style="{StaticResource FieldCaption}"/>
                                    <TextBox Text="{Binding CgLayerText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SECONDS (empty = CG duration)" Style="{StaticResource FieldCaption}"/>
                                    <TextBox Text="{Binding CgDurationText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- L-shape trigger -->
                        <StackPanel Visibility="{Binding IsLShape, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="L-SHAPE TRIGGER" Style="{StaticResource FieldCaption}"/>
                            <ComboBox ItemsSource="{Binding LTriggerChoices}" SelectedItem="{Binding LTrigger, Mode=TwoWay}"/>
                            <StackPanel Visibility="{Binding UsesRepeat, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="REPEAT EVERY (minutes, 0 = once)" Style="{StaticResource FieldCaption}"/>
                                <TextBox Text="{Binding RepeatMinutesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding UsesProgrammeMatch, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="PROGRAMME TITLE OR CATEGORY" Style="{StaticResource FieldCaption}"/>
                                <TextBox Text="{Binding ProgrammeMatch, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="DUPLICATE" Click="Duplicate_Click"/>
                            <Button Content="DELETE" Click="Delete_Click"/>
                        </WrapPanel>

                        <StackPanel Margin="0,16,0,0" Visibility="{Binding CanControlRunner, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ON AIR CONTROL" Style="{StaticResource FieldCaption}"/>
                            <WrapPanel>
                                <Button Content="RESUME SCHEDULE NOW" Click="ResumeSchedule_Click" Background="#321445" BorderBrush="{StaticResource PinkBrush}"/>
                                <Button Content="CUT LIVE" Click="CutLive_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#080D12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Message, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0"/>
        </Border>
    </Grid>
</Window>
