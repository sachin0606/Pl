<Window x:Class="BroadcastPlayout.Views.EpgOutputSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix EPG Output" Width="1540" Height="900" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip" Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-epg.ico">
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
        <Border Background="#0A0E13" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="EPG / AUTO GRAPHICS OUTPUT" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="XMLTV header · custom columns · language · title/description mapping · CG timing/templates" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="REFRESH PREVIEW" Click="RefreshPreview_Click"/><Button Click="Minimize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button><Button Click="Maximize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button><Button Click="Close_Click" Style="{StaticResource WindowCloseButton}"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="610"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="HEADER / PROGRAMME" Foreground="{StaticResource AccentBrush}" FontSize="17" FontWeight="SemiBold"/>
                <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,8,0,0"><StackPanel>
                    <TextBlock Text="PROVIDER INFO NAME" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding ProviderInfoName, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,8"/>
                    <TextBlock Text="PROVIDER INFO URL" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding ProviderInfoUrl, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,8"/>
                    <TextBlock Text="EPG TIME FORMAT" Style="{StaticResource SectionCaption}"/><ComboBox SelectedValue="{Binding TimeFormat, Mode=TwoWay}" SelectedValuePath="Content" Margin="0,4,0,8"><ComboBoxItem Content="XMLTV UTC Offset"/><ComboBoxItem Content="UTC Z"/><ComboBoxItem Content="Local Compact"/><ComboBoxItem Content="Human Readable"/></ComboBox>
                    <TextBlock Text="PROGRAMME KEY ORDER" Style="{StaticResource SectionCaption}"/><ComboBox SelectedValue="{Binding ProgrammeKeyOrder, Mode=TwoWay}" SelectedValuePath="Content" Margin="0,4,0,8"><ComboBoxItem Content="Time - Channel"/><ComboBoxItem Content="Channel - Time"/></ComboBox>
                    <CheckBox Content="Display language attribute" IsChecked="{Binding DisplayLanguageAttribute, Mode=TwoWay}"/><TextBox Text="{Binding Language, UpdateSourceTrigger=LostFocus}" Margin="24,4,0,8" Width="90" HorizontalAlignment="Left"/>
                    <CheckBox Content="Skip tag if value is empty" IsChecked="{Binding SkipTagIfValueEmpty, Mode=TwoWay}"/><CheckBox Content="Ignore time for no-EPG items" IsChecked="{Binding IgnoreTimeForNoEpgFiles, Mode=TwoWay}"/><CheckBox Content="Round EPG times" IsChecked="{Binding RoundEpgTimes, Mode=TwoWay}"/><CheckBox Content="Remove end time from EPG" IsChecked="{Binding RemoveEndTime, Mode=TwoWay}"/>
                    <TextBlock Text="TITLE SOURCE" Style="{StaticResource SectionCaption}" Margin="0,10,0,3"/><ComboBox SelectedValue="{Binding TitleSource, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Item Name"/><ComboBoxItem Content="Original Title"/><ComboBoxItem Content="Now/Next Promo Name"/></ComboBox>
                    <TextBlock Text="DESCRIPTION SOURCE" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><ComboBox SelectedValue="{Binding DescriptionSource, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Item Description"/><ComboBoxItem Content="Original Description"/><ComboBoxItem Content="Notes"/></ComboBox>
                </StackPanel></Border>
                <TextBlock Text="AUTO GRAPHICS TIMING" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,5"/>
                <Border Style="{StaticResource PanelBorder}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Now/Next every (minutes)"/><TextBox Grid.Column="1" Text="{Binding NowNextEveryMinutes}"/><TextBlock Grid.Row="1" Text="Now/Next repeats"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NowNextRepeatsBeforePromo}"/><TextBlock Grid.Row="2" Text="Program title start seconds"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProgramTitleStartSeconds}"/><TextBlock Grid.Row="3" Text="Program title before end"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ProgramTitleEndSeconds}"/><TextBlock Grid.Row="4" Text="Music title after start"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MusicTitleShowSecondsAfterStart}"/><TextBlock Grid.Row="5" Text="Music title before end"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MusicTitleShowSecondsBeforeEnd}"/></Grid></Border>
            </StackPanel></ScrollViewer>

            <Grid Grid.Column="1" Margin="12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="CUSTOM COLUMNS" Foreground="{StaticResource AccentBrush}" FontSize="17" FontWeight="SemiBold"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Columns}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8,0,10" RowHeight="30" HeadersVisibility="Column"><DataGrid.Columns>
                    <DataGridTextColumn Header="COLUMN NAME" Binding="{Binding Name, Mode=OneWay}" Width="160" IsReadOnly="True"/><DataGridCheckBoxColumn Header="SHOW" Binding="{Binding Show, Mode=TwoWay}" Width="60"/><DataGridTextColumn Header="EPG TAG" Binding="{Binding Tag, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="180"/><DataGridCheckBoxColumn Header="LANG" Binding="{Binding ShowLanguage, Mode=TwoWay}" Width="60"/><DataGridTextColumn Header="LANGUAGE" Binding="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="90"/>
                </DataGrid.Columns></DataGrid>
                <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="12"><StackPanel><TextBlock Text="DEFAULT CG TEMPLATES" FontWeight="SemiBold"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="AUTO" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding DefaultAutoGraphicsTemplate}"/><TextBlock Text="PROGRAM" Style="{StaticResource SectionCaption}" Margin="0,6,0,0"/><TextBox Text="{Binding DefaultProgramTemplate}"/><TextBlock Text="NOW/NEXT" Style="{StaticResource SectionCaption}" Margin="0,6,0,0"/><TextBox Text="{Binding NowNextTemplate}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="MUSIC" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding DefaultMusicTemplate}"/><TextBlock Text="WEATHER" Style="{StaticResource SectionCaption}" Margin="0,6,0,0"/><TextBox Text="{Binding DefaultWeatherTemplate}"/><TextBlock Text="PROMO" Style="{StaticResource SectionCaption}" Margin="0,6,0,0"/><TextBox Text="{Binding PromoTemplate}"/></StackPanel></Grid></StackPanel></Border>
            </Grid>

            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="PREVIEW" Foreground="{StaticResource AccentBrush}" FontSize="17" FontWeight="SemiBold"/><TextBox x:Name="PreviewBox" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#080B0E" Foreground="#D4DEE5"/></Grid>
        </Grid>
        <Border Grid.Row="2" Background="#0A0E13" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="RESET DEFAULTS" Click="Reset_Click"/><TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="SAVE CHANGES" Click="Save_Click" Background="#281735" BorderBrush="{StaticResource PinkBrush}"/><Button Content="CLOSE" Click="Close_Click"/></StackPanel></Grid></Border>
    </Grid>
</Window>
