<Window x:Class="BroadcastPlayout.Views.FileManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix File Manager" Width="1460" Height="860" MinWidth="1080" MinHeight="650" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" PreviewKeyDown="Window_PreviewKeyDown" Background="{StaticResource Bg0Brush}"
        Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-filemanager.ico">
    <Grid><Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
        <!-- compact broadcast explorer chrome -->
        <Border Grid.Row="0" Background="#0C1116" BorderBrush="#242B31" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="9,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Width="27" Height="27" Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-filemanager.png" Stretch="Uniform" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="FILES" FontSize="17" FontWeight="Bold" Foreground="White"/><TextBlock Text="  ·  KASHTRIX MEDIA EXPLORER" Foreground="#D9B8EE" FontSize="10" VerticalAlignment="Center" Margin="7,2,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="ClockText" Style="{StaticResource DigitalClockText}" FontSize="18" Foreground="#F0D8FF" Margin="0,0,12,0"/><Button Style="{StaticResource WindowControlButton}" Click="Minimize_Click"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button><Button Style="{StaticResource WindowControlButton}" Click="Maximize_Click"><TextBlock x:Name="MaxGlyph" Style="{StaticResource WindowMaximizeGlyph}"/></Button><Button Style="{StaticResource WindowCloseButton}" Click="Close_Click"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#090C0F"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
            <!-- folder tree / roots -->
            <Border Grid.Column="0" Background="#0B0F12" BorderBrush="#232A30" BorderThickness="0,0,1,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/><RowDefinition Height="45"/></Grid.RowDefinitions>
                    <Grid Background="#111519" Margin="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="MEDIA ROOTS" Foreground="#C9A4E3" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/><Button Grid.Column="1" Content="＋" Width="34" Height="28" MinHeight="28" Click="AddFolder_Click" ToolTip="Add media root"/></Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" Background="#090D10" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><Grid Height="40" Margin="4,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="▰" FontSize="18" Foreground="#8B56D0" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding}" Foreground="#D7DCE0" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock Text="MEDIA" Foreground="#68747D" FontSize="7.5"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button Content="FOLDER" Click="AddFolder_Click" Height="29" MinHeight="29"/><Button Content="REFRESH" Click="Refresh_Click" Height="29" MinHeight="29"/></StackPanel>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#2B3137"/>

            <!-- search + file list, intentionally close to broadcast FILES reference -->
            <Border Grid.Column="2" Background="#0D1114"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Background="#111519" Margin="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="70"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <TextBlock Text="SEARCH" Foreground="#9F63C9" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged" Margin="4,8" ToolTip="Search name, format or category"/>
                    <TextBlock Grid.Column="2" Text="TYPE" Foreground="#A4ABB1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <ComboBox x:Name="TypeFilter" Grid.Column="3" SelectedIndex="0" Margin="0,8,8,8" SelectionChanged="TypeFilter_SelectionChanged"><ComboBoxItem Content="ALL"/><ComboBoxItem Content="VIDEO"/><ComboBoxItem Content="AUDIO"/><ComboBoxItem Content="GRAPHICS"/></ComboBox>
                </Grid>
                <ListView Grid.Row="1" x:Name="MediaList" ItemsSource="{Binding Media}" SelectedItem="{Binding SelectedMedia}" SelectionChanged="MediaList_SelectionChanged" PreviewMouseMove="MediaList_PreviewMouseMove" Background="#0A0D10" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.Resources><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="31"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="#0E1215"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2B1640"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#151B20"/></Trigger></Style.Triggers></Style></ListView.Resources>
                    <ListView.View><GridView>
                        <GridViewColumn Width="27"><GridViewColumn.CellTemplate><DataTemplate><Border Width="12" Height="27" Background="#6F42A8" Margin="4,1"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="NAME" Width="330"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ParsedName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="DURATION" Width="112" DisplayMemberBinding="{Binding Duration}"/>
                        <GridViewColumn Header="TYPE" Width="80" DisplayMemberBinding="{Binding Extension}"/>
                        <GridViewColumn Header="CATEGORY" Width="115" DisplayMemberBinding="{Binding Category}"/>
                        <GridViewColumn Header="FORMAT" Width="260" DisplayMemberBinding="{Binding Format}"/>
                        <GridViewColumn Header="SIZE" Width="90" DisplayMemberBinding="{Binding SizeText, Mode=OneWay}"/>
                        <GridViewColumn Header="QC" Width="70" DisplayMemberBinding="{Binding QcStatus}"/>
                    </GridView></ListView.View>
                </ListView>
            </Grid></Border>
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#2B3137"/>

            <!-- inspector remains available without crowding the media list -->
            <Border Grid.Column="4" Background="#0B0F12" BorderBrush="#232A30" BorderThickness="1,0,0,0" Padding="10"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="MEDIA INSPECTOR" Foreground="#C9A4E3" FontWeight="SemiBold"/>
                <Border Height="146" Background="Black" BorderBrush="#2A3137" BorderThickness="1" Margin="0,9,0,0"><Image Source="{Binding SelectedMedia.ThumbnailPath}" Stretch="Uniform"/></Border>
                <TextBlock Text="{Binding SelectedMedia.ParsedName, TargetNullValue='NO MEDIA SELECTED'}" FontSize="14" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedMedia.Duration}" Foreground="#B78BE7" Margin="0,4,0,0"/><TextBlock Text="{Binding SelectedMedia.Format}" Foreground="#8C969E" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedMedia.FilePath}" Foreground="#69737B" FontSize="8.5" TextWrapping="Wrap" Margin="0,9,0,0"/>
                <TextBlock Text="CATEGORY" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><ComboBox x:Name="CategoryBox" IsEditable="True" Text="{Binding SelectedMedia.Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Media"/><ComboBoxItem Content="Music"/><ComboBoxItem Content="News"/><ComboBoxItem Content="Commercial"/><ComboBoxItem Content="Graphics"/><ComboBoxItem Content="Live"/></ComboBox>
                <Button Content="SAVE CATEGORY" Click="SaveCategory_Click" Margin="0,5,0,0"/><Button Content="QC SELECTED" Click="Qc_Click" Margin="0,12,0,0"/><Button Content="ADD TO PLAYLIST" Click="AddToPlaylist_Click" Background="#251730" BorderBrush="#8B56D0"/><Button Content="ADD + MULTIPART" Click="AddAndTrim_Click"/><Button Content="OPEN IN EXPLORER" Click="OpenExplorer_Click" Margin="0,10,0,0"/>
            </StackPanel></ScrollViewer></Border>
        </Grid>

        <Border Grid.Row="2" Background="#0E1215" BorderBrush="#242B31" BorderThickness="0,1,0,0"><Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready" Foreground="#8E989F" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="OPEN PLAYLIST EDITOR" Click="OpenPlaylistEditor_Click" Height="31" MinHeight="31"/><Button Content="ADD TO PLAYLIST" Click="AddToPlaylist_Click" Height="31" MinHeight="31" Background="#251730" BorderBrush="#8B56D0"/></StackPanel></Grid></Border>
    </Grid>
</Window>
