<Window x:Class="BroadcastPlayout.Views.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Setup" Width="900" Height="610" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize">
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
        <Border Background="#090D14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid Margin="24,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="KASHTRIX PLAYOUT · RUN-ONCE SETUP" FontSize="22" FontWeight="Bold"/><TextBlock Text="Choose the channel standard and safe automation defaults. These can be changed later in Settings." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></Grid></Border>
        <Grid Grid.Row="1" Margin="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CHANNEL IDENTITY" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Channel name" Style="{StaticResource SectionCaption}" Margin="0,14,0,4"/><TextBox x:Name="ChannelNameBox" Text="KASHTRIX NEWS HD"/>
                <TextBlock Text="Unique playout ID" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox x:Name="ChannelIdBox"/>
                <TextBlock Text="Every client playout uses a unique ID in Channel Controller." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="AUTOMATION" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,0"/>
                <CheckBox x:Name="FillerCheck" Content="Enable filler when no scheduled/program event is on air" IsChecked="True" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"/>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBox x:Name="FillerFolderBox" ToolTip="Folder containing filler clips"/><Button Grid.Column="1" Content="BROWSE" Click="BrowseFiller_Click"/></Grid>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="PLAYOUT PRESET" FontSize="15" FontWeight="SemiBold"/>
                <UniformGrid Columns="2" Margin="0,14,0,0">
                    <RadioButton x:Name="Preset4K" GroupName="Preset" Content="4K UHD\n3840 × 2160 · 50p" Style="{StaticResource PresetRadio}"/>
                    <RadioButton x:Name="Preset1080" GroupName="Preset" Content="1080p\n1920 × 1080 · 50p" IsChecked="True" Style="{StaticResource PresetRadio}"/>
                    <RadioButton x:Name="Preset1080i" GroupName="Preset" Content="1080i\n1920 × 1080 · 50i" Style="{StaticResource PresetRadio}"/>
                    <RadioButton x:Name="Preset720" GroupName="Preset" Content="720p\n1280 × 720 · 50p" Style="{StaticResource PresetRadio}"/>
                </UniformGrid>
                <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,18,0,0"><StackPanel><TextBlock Text="CHANNEL CONTROLLER" FontWeight="SemiBold"/><CheckBox x:Name="ControllerCheck" Content="Connect this playout as a controller client" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="ControllerHostBox" Text="127.0.0.1"/><TextBox Grid.Column="1" x:Name="ControllerPortBox" Text="9120" Margin="8,0,0,0"/></Grid><TextBlock Text="The client keeps a persistent connection to Kashtrix Channel Controller and can receive per-channel graphics commands." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Background="#090D14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="Kashtrix stores this profile locally. No media-engine implementation details are exposed in the operator UI." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="24,0"/><Button Grid.Column="1" Content="COMPLETE SETUP" Click="Complete_Click" Margin="16" Background="#37164E" BorderBrush="{StaticResource PinkBrush}" FontWeight="Bold"/></Grid>
    </Grid>
</Window>
