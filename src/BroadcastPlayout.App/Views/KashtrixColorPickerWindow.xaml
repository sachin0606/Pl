<Window x:Class="BroadcastPlayout.Views.KashtrixColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Color" Width="680" Height="580" MinWidth="600" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" Background="{StaticResource Bg0Brush}">
    <Window.Resources>
        <LinearGradientBrush x:Key="RainbowBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF0000" Offset="0.0"/>
            <GradientStop Color="#FFFFFF00" Offset="0.17"/>
            <GradientStop Color="#FF00FF00" Offset="0.33"/>
            <GradientStop Color="#FF00FFFF" Offset="0.50"/>
            <GradientStop Color="#FF0000FF" Offset="0.67"/>
            <GradientStop Color="#FFFF00FF" Offset="0.83"/>
            <GradientStop Color="#FFFF0000" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>
        <Border Background="#0B1016" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0,5,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="KASHTRIX VISUAL COLOR PICKER" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text=" · 2D spectrum &amp; broadcast palette" Foreground="{StaticResource MutedBrush}" FontSize="9.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource WindowCloseButton}" Click="Cancel_Click"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: 2D Visual Spectrum Canvas + Rainbow Hue Slider -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="240"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="VISUAL COLOR SPECTRUM" FontWeight="SemiBold" Foreground="#B78BE7" Margin="0,0,0,6"/>

                <!-- 2D Saturation / Value Canvas -->
                <Border Grid.Row="1" x:Name="SpectrumBorder" CornerRadius="4" BorderBrush="#354252" BorderThickness="1" ClipToBounds="True" Cursor="Cross"
                        MouseLeftButtonDown="Spectrum_MouseDown" MouseMove="Spectrum_MouseMove" MouseLeftButtonUp="Spectrum_MouseUp">
                    <Grid x:Name="SpectrumGrid">
                        <!-- Base Hue Background -->
                        <Rectangle x:Name="SpectrumHueRect" Fill="#FFFF0000"/>
                        <!-- Saturation Gradient: White to Transparent (horizontal) -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Brightness Gradient: Transparent to Black (vertical) -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Thumb marker -->
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SpectrumThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2" Canvas.Left="0" Canvas.Top="0" Margin="-7,-7,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="Black" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Hue Rainbow Bar -->
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="HUE SPECTRUM" Style="{StaticResource SectionCaption}"/>
                        <TextBlock x:Name="HueValueText" Text="0°" HorizontalAlignment="Right" Foreground="#B78BE7" FontSize="9.5"/>
                    </Grid>
                    <Border Height="18" CornerRadius="3" Background="{StaticResource RainbowBrush}" BorderBrush="#354252" BorderThickness="1">
                        <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Value="0" ValueChanged="HueSlider_ValueChanged"
                                Background="Transparent" Foreground="Transparent" VerticalAlignment="Center" Margin="-4,0"/>
                    </Border>
                </StackPanel>

                <!-- Alpha Bar -->
                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="OPACITY / ALPHA" Style="{StaticResource SectionCaption}"/>
                        <TextBlock x:Name="AlphaValue" Text="A 255" HorizontalAlignment="Right" Foreground="#B78BE7" FontSize="9.5"/>
                    </Grid>
                    <Slider x:Name="AlphaSlider" Minimum="0" Maximum="255" Value="255" TickFrequency="1" ValueChanged="ChannelSlider_ValueChanged"/>
                </StackPanel>
            </Grid>

            <!-- RIGHT: Preview, Swatches, Hex & Channel Sliders -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Color Preview & Hex Input -->
                <Border Grid.Row="0" Background="#0E141C" BorderBrush="#25303E" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PreviewSwatch" Height="68" CornerRadius="4" BorderBrush="#59636F" BorderThickness="1"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="HEX COLOR CODE" Style="{StaticResource SectionCaption}" Margin="0,0,0,3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HexInput" Height="28" FontSize="13" FontWeight="Bold" FontFamily="Consolas, Segoe UI"
                                         VerticalContentAlignment="Center" Padding="6,0" LostFocus="HexInput_LostFocus" KeyDown="HexInput_KeyDown"/>
                                <Button Grid.Column="1" Content="SET" Click="HexSet_Click" Margin="4,0,0,0" Padding="10,0" Height="28"/>
                            </Grid>
                            <UniformGrid Columns="4" Margin="0,5,0,0">
                                <TextBlock x:Name="RedValue" Text="R 255" TextAlignment="Center" FontSize="9" Foreground="#FF8888"/>
                                <TextBlock x:Name="GreenValue" Text="G 255" TextAlignment="Center" FontSize="9" Foreground="#88FF88"/>
                                <TextBlock x:Name="BlueValue" Text="B 255" TextAlignment="Center" FontSize="9" Foreground="#8888FF"/>
                                <TextBlock x:Name="HexSummary" Text="#FFFFFFFF" TextAlignment="Center" FontSize="9" Foreground="#B7C0C8"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RGB Sliders -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <Grid Margin="0,0,0,2"><TextBlock Text="RED" Style="{StaticResource SectionCaption}"/><TextBlock Text="{Binding Value, ElementName=RedSlider, StringFormat='{}{0:0}'}" HorizontalAlignment="Right" Foreground="#FF8888" FontSize="9.5"/></Grid>
                    <Slider x:Name="RedSlider" Minimum="0" Maximum="255" TickFrequency="1" ValueChanged="ChannelSlider_ValueChanged" Margin="0,0,0,4"/>

                    <Grid Margin="0,2,0,2"><TextBlock Text="GREEN" Style="{StaticResource SectionCaption}"/><TextBlock Text="{Binding Value, ElementName=GreenSlider, StringFormat='{}{0:0}'}" HorizontalAlignment="Right" Foreground="#88FF88" FontSize="9.5"/></Grid>
                    <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" TickFrequency="1" ValueChanged="ChannelSlider_ValueChanged" Margin="0,0,0,4"/>

                    <Grid Margin="0,2,0,2"><TextBlock Text="BLUE" Style="{StaticResource SectionCaption}"/><TextBlock Text="{Binding Value, ElementName=BlueSlider, StringFormat='{}{0:0}'}" HorizontalAlignment="Right" Foreground="#8888FF" FontSize="9.5"/></Grid>
                    <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" TickFrequency="1" ValueChanged="ChannelSlider_ValueChanged"/>
                </StackPanel>

                <!-- Broadcast Palette Presets -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="BROADCAST PALETTE PRESETS" FontWeight="SemiBold" Foreground="#B78BE7" Margin="0,0,0,6"/>
                    <UniformGrid Columns="6" Rows="3">
                        <Button Tag="#FFFFFFFF" Background="#FFFFFFFF" Click="Preset_Click" ToolTip="Clean White" Height="24" Margin="2"/>
                        <Button Tag="#FF000000" Background="#FF000000" Click="Preset_Click" ToolTip="Pure Black" Height="24" Margin="2"/>
                        <Button Tag="#FFFF2438" Background="#FFFF2438" Click="Preset_Click" ToolTip="News Breaking Red" Height="24" Margin="2"/>
                        <Button Tag="#FFFFB800" Background="#FFFFB800" Click="Preset_Click" ToolTip="Broadcast Gold / Amber" Height="24" Margin="2"/>
                        <Button Tag="#FF00E5FF" Background="#FF00E5FF" Click="Preset_Click" ToolTip="Live Cyan" Height="24" Margin="2"/>
                        <Button Tag="#FF0047FF" Background="#FF0047FF" Click="Preset_Click" ToolTip="Royal Broadcast Blue" Height="24" Margin="2"/>

                        <Button Tag="#FF00E676" Background="#FF00E676" Click="Preset_Click" ToolTip="Signal Green" Height="24" Margin="2"/>
                        <Button Tag="#FFFF3D71" Background="#FFFF3D71" Click="Preset_Click" ToolTip="Alert Coral / Magenta" Height="24" Margin="2"/>
                        <Button Tag="#FF8B3DFF" Background="#FF8B3DFF" Click="Preset_Click" ToolTip="Studio Purple" Height="24" Margin="2"/>
                        <Button Tag="#FFFF6D00" Background="#FFFF6D00" Click="Preset_Click" ToolTip="Flame Orange" Height="24" Margin="2"/>
                        <Button Tag="#FF121820" Background="#FF121820" Click="Preset_Click" ToolTip="Deep Charcoal" Height="24" Margin="2"/>
                        <Button Tag="#FF253342" Background="#FF253342" Click="Preset_Click" ToolTip="Studio Slate" Height="24" Margin="2"/>

                        <Button Tag="#00000000" Background="Transparent" BorderBrush="#556677" BorderThickness="1" Click="Preset_Click" ToolTip="100% Transparent" Height="24" Margin="2"/>
                        <Button Tag="#80000000" Background="#80000000" Click="Preset_Click" ToolTip="50% Black Glass" Height="24" Margin="2"/>
                        <Button Tag="#CC0A1118" Background="#CC0A1118" Click="Preset_Click" ToolTip="80% Broadcast Panel Glass" Height="24" Margin="2"/>
                        <Button Tag="#D916212C" Background="#D916212C" Click="Preset_Click" ToolTip="85% Slate Glass" Height="24" Margin="2"/>
                        <Button Tag="#CC990000" Background="#CC990000" Click="Preset_Click" ToolTip="80% Dark Red" Height="24" Margin="2"/>
                        <Button Tag="#CC003366" Background="#CC003366" Click="Preset_Click" ToolTip="80% Deep Navy" Height="24" Margin="2"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#0B1016" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock x:Name="SelectedColorSummary" Text="#FFFFFFFF" VerticalAlignment="Center" Foreground="#B78BE7" FontWeight="Bold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="CANCEL" Width="90" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button Content="APPLY COLOR" Width="130" Click="Apply_Click" Background="#321445" BorderBrush="{StaticResource PinkBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
