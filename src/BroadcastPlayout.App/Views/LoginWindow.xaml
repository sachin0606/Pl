<Window x:Class="BroadcastPlayout.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Sign In" Width="540" Height="580" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#080C10" WindowStyle="None">
    <Border BorderBrush="#25303D" BorderThickness="1" Background="#0B0F14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="#10151C" BorderBrush="#1C2733" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="KASHTRIX" FontWeight="Bold" FontSize="11" Foreground="#9354FF" Margin="0,0,6,0"/>
                        <TextBlock Text="OPERATOR SIGN IN" FontSize="11" Foreground="#A0B0C0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Click="Close_Click" Width="28" Height="24" Background="Transparent" BorderThickness="0" Foreground="#8A99A8" Cursor="Hand" ToolTip="Close"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="18">
                <Border Style="{StaticResource PanelBorder}" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="KASHTRIX PLAYOUT" FontSize="28" FontWeight="Bold" Foreground="#E6C4FF"/>
                    <TextBlock Text="Secure operator sign in · Playout opens immediately after authentication" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="USERNAME" Style="{StaticResource SectionCaption}"/>
                    <TextBox x:Name="UsernameBox" Text="admin" Height="40" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="PASSWORD" Style="{StaticResource SectionCaption}"/>
                        <TextBlock Grid.Column="1" Text="ENTER TO SIGN IN" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                    </Grid>
                    <PasswordBox x:Name="PasswordBox" Height="42" MinHeight="42" Padding="10,4" Margin="0,5,0,0"
                                 VerticalContentAlignment="Center" KeyDown="PasswordBox_KeyDown"/>
                    <CheckBox x:Name="RememberLoginCheck" Content="REMEMBER THIS SIGN-IN ON THIS WINDOWS ACCOUNT" IsChecked="True" Margin="0,9,0,0" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>

                <Border Grid.Row="6" Background="#101722" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                    <TextBlock x:Name="InfoText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                </Border>

                <Button Grid.Row="8" x:Name="SignInButton" Content="SIGN IN AND OPEN PLAYOUT" Click="SignIn_Click" Height="46" FontWeight="Bold"/>

                <ProgressBar Grid.Row="10" x:Name="LoginProgress" Height="4" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" IsIndeterminate="True"/>

                <TextBlock Grid.Row="12" x:Name="ErrorText" Foreground="#FF8F9C" TextWrapping="Wrap" MinHeight="34"/>
            </Grid>
        </Border>
    </Grid>
    </Grid>
    </Border>
</Window>
