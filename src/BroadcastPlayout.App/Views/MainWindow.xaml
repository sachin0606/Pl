<Window x:Class="BroadcastPlayout.Views.MainWindow" x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:BroadcastPlayout.Models"
        Title="Kashtrix Playout" Width="1672" Height="941" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" WindowStyle="None" ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown" StateChanged="Window_StateChanged" Background="#090D11" UseLayoutRounding="True" SnapsToDevicePixels="True" Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-playout.ico">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding TakeSelectedCommand}"/>
        <KeyBinding Key="F6" Command="{Binding NextCommand}"/>
        <KeyBinding Key="F8" Command="{Binding StopCommand}"/>
        <KeyBinding Key="F11" Command="{Binding FullscreenCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="24"/><Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="30"/><Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style x:Key="SmallTool" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="22"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,2"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="Transport" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="52"/><Setter Property="MinHeight" Value="52"/><Setter Property="Padding" Value="4,2"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="QuickButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="82"/><Setter Property="Width" Value="82"/><Setter Property="Height" Value="54"/><Setter Property="MinHeight" Value="54"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="4"/><Setter Property="FontSize" Value="9.5"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#B78BE7"/>
        </Style>
        <Style x:Key="ClockBig" TargetType="TextBlock" BasedOn="{StaticResource DigitalClockText}">
            <Setter Property="FontSize" Value="47"/><Setter Property="Foreground" Value="#A35ADB"/><Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ClockMedium" TargetType="TextBlock" BasedOn="{StaticResource DigitalClockText}">
            <Setter Property="FontSize" Value="30"/><Setter Property="Foreground" Value="#F1F1F1"/>
        </Style>
        <Style x:Key="TimelineBlock" TargetType="Border">
            <Setter Property="CornerRadius" Value="1"/><Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="9,8"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="RightCard" TargetType="Border">
            <Setter Property="Background" Value="#0F141A"/><Setter Property="BorderBrush" Value="#27303A"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="9"/>
        </Style>
        <!-- Detail lines of a NOW PLAYING / NEXT / UP NEXT card, shown through a ContentControl whose Content is the
             PlaylistItem, so the block renders nothing when the slot is empty. -->
        <Style x:Key="NowNextDetailHost" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{DynamicResource NowNextDetailLines}"/><Setter Property="Focusable" Value="False"/>
            <Style.Triggers><Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="NowNextDetailLines">
            <StackPanel>
                <TextBlock Foreground="#AEB7BD" TextTrimming="CharacterEllipsis"><Run Text="{Binding EventType, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Category, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding RundownDurationText, Mode=OneWay}"/></TextBlock>
                <TextBlock Text="{Binding FilePath, Mode=OneWay}" Foreground="#7F8991" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath, Mode=OneWay}"/>
                <TextBlock FontSize="9" Margin="0,2,0,0"><Run Text="IN " Foreground="#7F8991"/><Run Text="{Binding StartTimeText, Mode=OneWay}" Foreground="#C9D1D6"/><Run Text="   OUT " Foreground="#7F8991"/><Run Text="{Binding EndTimeText, Mode=OneWay}" Foreground="#C9D1D6"/></TextBlock>
            </StackPanel>
        </DataTemplate>
        <Style TargetType="DataGridCell">
            <Setter Property="FontSize" Value="{Binding DataContext.PlaylistFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="{Binding DataContext.PlaylistRowHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="FontSize" Value="{Binding DataContext.PlaylistFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Background" Value="{Binding CategoryColor}"/><Setter Property="Foreground" Value="{Binding RowTextColor}"/><Setter Property="BorderBrush" Value="#222A31"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Completed"/>
                        <Condition Binding="{Binding DataContext.DimCompletedItems, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.58"/>
                    <Setter Property="Foreground" Value="#68737C"/>
                </MultiDataTrigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#47266D"/><Setter Property="Foreground" Value="White"/><Setter Property="Opacity" Value="1"/></Trigger>
                <DataTrigger Binding="{Binding Status}" Value="On Air"><Setter Property="Background" Value="#123D2B"/><Setter Property="Foreground" Value="#F4FFF8"/><Setter Property="BorderBrush" Value="#45D889"/><Setter Property="BorderThickness" Value="3,0,0,1"/><Setter Property="Opacity" Value="1"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Paused"><Setter Property="Background" Value="#4A3513"/><Setter Property="Foreground" Value="#FFF3CF"/><Setter Property="BorderBrush" Value="#F1B84B"/><Setter Property="BorderThickness" Value="3,0,0,1"/><Setter Property="Opacity" Value="1"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#20272E" BorderThickness="0" Background="#090D11">
        <Grid x:Name="ShellGrid" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition x:Name="TopOperatorRow" Height="275" MinHeight="180" MaxHeight="450"/>
                <RowDefinition x:Name="RundownRow" Height="0" MinHeight="0"/>
                <RowDefinition x:Name="PlaylistRow" Height="*" MinHeight="150"/>
                <RowDefinition x:Name="QuickControlsRow" Height="178" MinHeight="126"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="780"/>
                <ColumnDefinition Width="310" MinWidth="260" MaxWidth="440"/>
            </Grid.ColumnDefinitions>

            <!-- TOP DESKTOP MENU -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#0C1116" BorderBrush="#20272E" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="10,0,6,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▶ " Foreground="#FF2A85" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="SPARKLE TV" FontWeight="Bold" FontSize="18" Foreground="#FF2A85" VerticalAlignment="Center"/>
                        <TextBlock Text=" PLAYOUT" FontWeight="Bold" FontSize="18" Foreground="#A855F7" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Menu Grid.Column="1" Background="Transparent" Foreground="#F4F6F8" BorderThickness="0" VerticalAlignment="Stretch">
                        <MenuItem Header="File">
                            <MenuItem Header="New Playlist" Click="NewPlaylist_Click" InputGestureText="Ctrl+N"/>
                            <MenuItem Header="Open / Import Playlist (Clean)..." Click="OpenPlaylist_Click" InputGestureText="Ctrl+O"/>
                            <MenuItem Header="Append Playlist to Bottom..." Click="AppendPlaylistBottom_Click"/>
                            <MenuItem Header="Append Playlist Here (After Selected)..." Click="AppendPlaylistHere_Click"/>
                            <MenuItem Header="Save Playlist As (*.kashtrixplaylist)..." Click="SavePlaylist_Click" InputGestureText="Ctrl+S"/><Separator/><MenuItem Header="Export EPG · XMLTV..." Click="ExportEpg_Click"/><MenuItem Header="Export EPG · JSON..." Click="ExportEpgJson_Click"/>
                            <Separator/>
                            <MenuItem Header="Add Media Files to Rundown..." Click="ImportMedia_Click" InputGestureText="Insert"/>
                            <MenuItem Header="Add Media + Trim..." Click="AddTrimmedMedia_Click"/>
                            <MenuItem Header="Insert Media After Selected..." Click="InsertMedia_Click" InputGestureText="Shift+Insert"/>
                            <MenuItem Header="Insert Media + Trim After Selected..." Click="InsertTrimmedMedia_Click"/>
                            <Separator/>
                            <MenuItem Header="Add Live / URL / Capture / Screen / Custom..." Click="AddInput_Click"/>
                            <MenuItem Header="Insert Live / Input After Selected..." Click="InsertInputAfterSelected_Click"/>
                            <MenuItem Header="Add CG Graphic Event..." Click="AddCgEvent_Click"/>
                            <MenuItem Header="Insert CG Event After Selected..." Click="InsertCgEvent_Click"/>
                            <MenuItem Header="Open File Manager" Click="FileManager_Click"/>
                            <Separator/>
                            <MenuItem Header="Exit Operator Window" Click="Close_Click"/>
                        </MenuItem>
                        <MenuItem Header="Edit">
                            <MenuItem Header="Play / Pause Selected" Click="PlayPauseSelected_Click" InputGestureText="Ctrl+Space"/>
                            <MenuItem Header="Play / Take Selected" Click="PlaySelected_Click" InputGestureText="F5"/>
                            <MenuItem Header="Cue / Refresh Preview" Click="CueSelected_Click"/>
                            <MenuItem Header="Next Event" Click="NextSelected_Click" InputGestureText="F6"/>
                            <MenuItem Header="Stop Playout" Click="StopSelected_Click" InputGestureText="F8"/>
                            <Separator/>
                            <MenuItem Header="Trim Selected Media..." Click="Trim_Click"/>
                            <MenuItem Header="Multipart Trim / Segments..." Click="Trim_Click"/>
                            <MenuItem Header="Set IN At Preview" Click="SetInAtPreview_Click"/>
                            <MenuItem Header="Set OUT At Preview" Click="SetOutAtPreview_Click"/>
                            <MenuItem Header="Reset Trim" Click="ResetTrim_Click"/>
                            <Separator/>
                            <MenuItem Header="Duplicate Selected" Click="DuplicateSelected_Click"/>
                            <MenuItem Header="Move Up" Click="MoveUp_Click" InputGestureText="Alt+Up"/>
                            <MenuItem Header="Move Down" Click="MoveDown_Click" InputGestureText="Alt+Down"/>
                            <MenuItem Header="Remove Selected" Click="RemoveSelected_Click" InputGestureText="Delete"/>
                        </MenuItem>
                        <MenuItem Header="View">
                            <MenuItem Header="Pop Out Program Monitor..." Click="ProgramMonitor_Click"/>
                            <MenuItem Header="Floating Timers &amp; Clock..." Click="OpenFloatingTimers_Click"/>
                            <Separator/>
                            <MenuItem Header="Layout Presets">
                                <MenuItem Header="Standard Broadcast" Tag="Standard" Click="ApplyPlayoutLayout_Click"/>
                                <MenuItem Header="Compact Rundown" Tag="Compact" Click="ApplyPlayoutLayout_Click"/>
                                <MenuItem Header="Master Control" Tag="MasterControl" Click="ApplyPlayoutLayout_Click"/>
                                <MenuItem Header="Studio Monitor Focus" Tag="StudioMonitor" Click="ApplyPlayoutLayout_Click"/>
                            </MenuItem>
                            <MenuItem Header="Panels &amp; Components">
                                <MenuItem x:Name="TopOperatorPanelMenu" Header="Top Operator Bus" IsCheckable="True" IsChecked="True" Tag="TopOperator" Click="TogglePlayoutPanel_Click"/>
                                <MenuItem x:Name="PreviewMonitorMenu" Header="Preview Monitor" IsCheckable="True" IsChecked="True" Tag="PreviewMonitor" Click="TogglePlayoutPanel_Click"/>
                                <MenuItem x:Name="ProgramMonitorMenu" Header="Program Monitor" IsCheckable="True" IsChecked="True" Tag="ProgramMonitor" Click="TogglePlayoutPanel_Click"/>
                                <MenuItem x:Name="ProgramAudioMenu" Header="Program Audio &amp; Fader" IsCheckable="True" IsChecked="True" Tag="ProgramAudio" Click="TogglePlayoutPanel_Click"/>
                                <MenuItem x:Name="TransportDeckMenu" Header="Runtime Deck (Timers &amp; Transport)" IsCheckable="True" IsChecked="True" Tag="TransportDeck" Click="TogglePlayoutPanel_Click"/>
                                <MenuItem x:Name="RundownPanelMenu" Header="Rundown Timeline" IsCheckable="True" IsChecked="False" Tag="Rundown" Click="TogglePlayoutPanel_Click"/>
                                <MenuItem x:Name="PlaylistPanelMenu" Header="Playlist" IsCheckable="True" IsChecked="True" Tag="Playlist" Click="TogglePlayoutPanel_Click"/>
                                <MenuItem x:Name="QuickControlsPanelMenu" Header="Quick Controls / Inputs" IsCheckable="True" IsChecked="True" Tag="QuickControls" Click="TogglePlayoutPanel_Click"/>
                                <MenuItem x:Name="RightSidebarPanelMenu" Header="Right Media / Event Dock" IsCheckable="True" IsChecked="True" Tag="RightSidebar" Click="TogglePlayoutPanel_Click"/>
                                <Separator/>
                                <MenuItem Header="Restore All Panels" Click="RestorePlayoutPanels_Click"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Fullscreen Program" Command="{Binding FullscreenCommand}" InputGestureText="F11"/>
                            <MenuItem Header="Multiview" Click="Multiview_Click"/>
                            <MenuItem Header="File Manager" Click="FileManager_Click"/>
                            <MenuItem Header="Mute Program Audio" Click="MasterMute_Click"/>
                            <MenuItem Header="Audio Mixer" Click="AudioMixer_Click"/>
                            <MenuItem Header="Final Output Video Processor" Click="VideoProcessor_Click"/>
                            <MenuItem Header="QC Controller" Click="QcController_Click"/>
                        </MenuItem>
                        <MenuItem Header="Playlist">
                            <MenuItem Header="Add to Rundown">
                                <MenuItem Header="Media File(s)..." Click="ImportMedia_Click"/>
                                <MenuItem Header="Media + Trim..." Click="AddTrimmedMedia_Click"/>
                                <MenuItem Header="Live / URL / Capture / Screen / Custom..." Click="AddInput_Click"/>
                                <MenuItem Header="CG Graphic Event..." Click="AddCgEvent_Click"/>
                            </MenuItem>
                            <MenuItem Header="Insert After Selected">
                                <MenuItem Header="Media File(s)..." Click="InsertMedia_Click"/>
                                <MenuItem Header="Media + Trim..." Click="InsertTrimmedMedia_Click"/>
                                <MenuItem Header="Live / URL / Capture / Screen / Custom..." Click="InsertInputAfterSelected_Click"/>
                                <MenuItem Header="CG Graphic Event..." Click="InsertCgEvent_Click"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Playlist Editor" Click="PlaylistEditor_Click"/>
                            <MenuItem Header="QC Selected Media" Click="QcSelected_Click"/>
                            <MenuItem Header="Open Selected File Location" Click="OpenSelectedLocation_Click"/>
                            <Separator/>
                            <MenuItem Header="Load Demo Workspace" Click="LoadDemo_Click"/>
                            <MenuItem Header="Clear Playlist" Click="NewPlaylist_Click"/>
                        </MenuItem>
                        <MenuItem Header="Schedule">
                            <MenuItem Header="Channel Schedule (filler, news, live, ads)..." Click="ChannelSchedule_Click"/>
                            <MenuItem Header="Open Scheduler..." Click="Scheduler_Click"/>
                        </MenuItem>
                        <MenuItem Header="Media Library">
                            <MenuItem Header="Media Asset Management (MAM)..." Click="Mam_Click"/>
                            <MenuItem Header="File Manager..." Click="FileManager_Click"/>
                            <MenuItem Header="QC Controller..." Click="QcController_Click"/>
                        </MenuItem>
                        <MenuItem Header="Graphics">
                            <MenuItem Header="CG Controller..." Click="CgController_Click"/>
                            <MenuItem Header="CG Designer..." Click="CgEditor_Click"/>
                            <MenuItem Header="EPG / Auto Graphics Output..." Click="EpgSettings_Click"/>
                            <MenuItem Header="Now / Next Graphics..." Click="NowNextGraphics_Click"/>
                            <MenuItem Header="Viewer Requests..." Click="ViewerRequests_Click"/>
                        </MenuItem>
                        <MenuItem Header="SCTE-35">
                            <MenuItem Header="SCTE-35 &amp; SCTE-104 Trigger Center..." Click="ScteTriggerManager_Click"/>
                        </MenuItem>
                        <MenuItem Header="Automation">
                            <MenuItem Header="Automation / MOS Gateway..." Click="AutomationGateway_Click"/>
                            <MenuItem Header="Channel Controller..." Click="ChannelController_Click"/>
                            <MenuItem Header="Final Output Video Processor..." Click="VideoProcessor_Click"/>
                            <MenuItem Header="Entertainment Channel Manager..." Click="EntertainmentManager_Click"/>
                            <MenuItem Header="Program Launcher..." Click="ProgramLauncher_Click"/>
                            <Separator/>
                            <MenuItem Header="Audit Log..." Click="AuditLog_Click"/>
                        </MenuItem>
                        <MenuItem Header="Settings" Click="Settings_Click"/>
                        <MenuItem Header="Help">
                            <MenuItem Header="Keyboard Shortcuts" Click="KeyboardShortcuts_Click"/>
                            <MenuItem Header="About Kashtrix Playout" Click="About_Click"/>
                        </MenuItem>
                    </Menu>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="▦  APPS" Style="{StaticResource SmallTool}" Click="ProgramLauncher_Click" Foreground="#CDA8F2" BorderBrush="#51326D" ToolTip="Open separate Kashtrix applications"/>
                        <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimize"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;"/></Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Click="Maximize_Click" ToolTip="Maximize"><TextBlock x:Name="MaximizeGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE922;"/></Button>
                        <Button Style="{StaticResource ChromeButton}" Click="Close_Click" Foreground="#FF8989" ToolTip="Close"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;"/></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TOP MAIN: PREVIEW + PROGRAM + AUDIO + TIMERS -->
            <Grid x:Name="TopOperatorPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,5,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TopPreviewColumn" Width="Auto" MinWidth="200"/>
                    <ColumnDefinition x:Name="TopTransportColumn" Width="*" MinWidth="360"/>
                    <ColumnDefinition x:Name="TopAudioColumn" Width="132" MinWidth="122" MaxWidth="146"/>
                    <ColumnDefinition x:Name="TopProgramColumn" Width="Auto" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <!-- PREVIEW BUS -->
                <Border x:Name="PreviewMonitorPanel" Grid.Column="0" Style="{StaticResource PanelBorder}" Background="#06090C" Width="420" HorizontalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="31"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                        <Grid x:Name="PreviewAspectHost" Grid.Row="0" Background="Black" ClipToBounds="True" SizeChanged="ConfidenceAspectHost_SizeChanged">
                            <Border x:Name="PreviewAspectSurface" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="PreviewImage" Stretch="Fill" SnapsToDevicePixels="True"/>
                            </Border>
                            <Border Background="#B33E2B62" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" Padding="7,3"><TextBlock Text="PREVIEW  1080p50 | 16:9 | STEREO" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/></Border>
                        </Grid>
                        <Grid Grid.Row="1" Background="#11171C">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0">
                                <TextBlock Text="PREVIEW" FontWeight="SemiBold" Foreground="#C89BED"/>
                                <TextBlock Text="  ·  "/>
                                <TextBlock Text="{Binding SelectedItem.Title, TargetNullValue='NO CUE'}" Foreground="#A7B1B9" TextTrimming="CharacterEllipsis" MaxWidth="205"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0"><TextBlock Text="{Binding PreviewSeekText, Mode=OneWay}" Style="{StaticResource DigitalClockText}" Foreground="#C89BED"/><TextBlock Text=" / " Foreground="#66717A" Margin="3,0"/><TextBlock Text="{Binding PreviewDurationText, Mode=OneWay}" Style="{StaticResource DigitalClockText}" Foreground="#9C86B1"/></StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Background="#0D1318" Margin="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="CUE" Style="{StaticResource SmallTool}" Click="CueSelected_Click" Margin="3" ToolTip="Load selected item to Preview"/>
                            <Slider x:Name="PreviewSeekSlider" Grid.Column="1" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="{Binding PreviewSeekMaximum}" Value="{Binding PreviewSeekSeconds, Mode=TwoWay}" IsEnabled="{Binding CanPreviewSeek}" VerticalAlignment="Center" Margin="5,0" PreviewMouseLeftButtonDown="PreviewSeekSlider_MouseDown" PreviewMouseLeftButtonUp="PreviewSeekSlider_MouseUp"/>
                            <Button Grid.Column="2" Content="{Binding PreviewPlayPauseGlyph}" Style="{StaticResource SmallTool}" Click="PreviewPlayPause_Click" Margin="3" ToolTip="Play / pause PREVIEW only. Never takes Program."/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- PROGRAM BUS · hard-right operator confidence monitor -->
                <Border x:Name="ProgramMonitorPanel" Grid.Column="3" Style="{StaticResource PanelBorder}" Background="#06090C" Margin="4,0,0,0" Width="420" HorizontalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="31"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                        <Grid x:Name="ProgramAspectHost" Grid.Row="0" Background="Black" ClipToBounds="True" SizeChanged="ConfidenceAspectHost_SizeChanged">
                            <Border x:Name="ProgramAspectSurface" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="ProgramImage" Stretch="Fill" SnapsToDevicePixels="True"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" Background="#11171C">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0">
                                <TextBlock Text="PROGRAM  1080p50 | 16:9 | STEREO" FontWeight="Bold" Foreground="#EF4444" FontSize="11"/>
                                <TextBlock Text="  ·  "/>
                                <TextBlock Text="{Binding CurrentItem.Title, TargetNullValue='OFF AIR'}" Foreground="#A7B1B9" TextTrimming="CharacterEllipsis" MaxWidth="205"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0"><TextBlock Text="{Binding CurrentElapsedText, Mode=OneWay}" Style="{StaticResource DigitalClockText}"/><TextBlock Text=" / " Foreground="#66717A" Margin="3,0"/><TextBlock Text="{Binding ProgramDurationText, Mode=OneWay}" Style="{StaticResource DigitalClockText}" Foreground="#9AA4AB"/></StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Background="#0D1318">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="TAKE" Style="{StaticResource SmallTool}" Command="{Binding TakeSelectedCommand}" Margin="3" Background="#63378E" BorderBrush="#8D55B7"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding PlayoutPreset, Mode=OneWay, StringFormat='PROGRAM · {0}'}" Foreground="White" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding ProgramFormatText, Mode=OneWay}" Foreground="#8C969E" FontSize="8" HorizontalAlignment="Center" ToolTip="Selected channel raster, cadence and scan mode"/></StackPanel></StackPanel>
                            <Button Grid.Column="2" Content="{Binding ProgramPlayPauseGlyph}" Style="{StaticResource SmallTool}" Command="{Binding PauseCommand}" Margin="3" ToolTip="Pause / Resume current program"/>
                        </Grid>
                    </Grid>
                </Border>
                <!-- PROGRAM AUDIO · vertical fader + narrow segmented L/R/M broadcast meters -->
                <Border x:Name="ProgramAudioPanel" Grid.Column="2" Style="{StaticResource PanelBorder}" Margin="4,0" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="F" HorizontalAlignment="Center" FontSize="8" Foreground="#8C969E"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="L" HorizontalAlignment="Center" FontSize="9"/><TextBlock Grid.Column="1" Text="R" HorizontalAlignment="Center" FontSize="9"/><TextBlock Grid.Column="2" Text="M" HorizontalAlignment="Center" FontSize="9"/></Grid></Grid>
                        <Grid Grid.Row="1" Margin="0,4,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource BroadcastFaderVertical}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Value="{Binding MasterOutputVolumePercent, Mode=TwoWay}"/>
                            <Grid Grid.Column="1" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="5"/><ColumnDefinition Width="17"/><ColumnDefinition Width="5"/><ColumnDefinition Width="17"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0" Style="{StaticResource BroadcastBlueAudioMeter}" VerticalAlignment="Stretch" Value="{Binding AudioLeftLevel, Mode=OneWay}"/>
                                <ProgressBar Grid.Column="2" Style="{StaticResource BroadcastBlueAudioMeter}" VerticalAlignment="Stretch" Value="{Binding AudioRightLevel, Mode=OneWay}"/>
                                <ProgressBar Grid.Column="4" Style="{StaticResource BroadcastBlueAudioMeter}" VerticalAlignment="Stretch" Value="{Binding AudioMasterLevel, Mode=OneWay}"/>
                                <Grid Grid.Column="5" Margin="2,0,0,0"><TextBlock Text="0" FontSize="7" Foreground="#8C969E" VerticalAlignment="Top"/><TextBlock Text="-6" FontSize="7" Foreground="#8C969E" VerticalAlignment="Top" Margin="0,23,0,0"/><TextBlock Text="-18" FontSize="7" Foreground="#8C969E" VerticalAlignment="Center"/><TextBlock Text="-36" FontSize="7" Foreground="#8C969E" VerticalAlignment="Bottom" Margin="0,0,0,23"/><TextBlock Text="-60" FontSize="7" Foreground="#8C969E" VerticalAlignment="Bottom"/></Grid>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><UniformGrid Grid.Column="1" Rows="1" Columns="3"><TextBlock Text="{Binding AudioLeftDb, Mode=OneWay}" FontSize="7.4" Foreground="#A3AFB7" HorizontalAlignment="Center"/><TextBlock Text="{Binding AudioRightDb, Mode=OneWay}" FontSize="7.4" Foreground="#A3AFB7" HorizontalAlignment="Center"/><TextBlock Text="{Binding AudioMasterDb, Mode=OneWay}" FontSize="7.4" Foreground="#C6D0D6" HorizontalAlignment="Center"/></UniformGrid></Grid>
                    </Grid>
                </Border>

                <!-- TIMERS / TRANSPORT · broadcast reference deck -->
                <Border x:Name="TransportDeckPanel" Grid.Column="1" Style="{StaticResource PanelBorder}" Padding="7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="112"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="58"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Margin="2" Background="#11161B" BorderBrush="#30383F" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Current Played Time" Foreground="#D4D7DA" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentElapsedText, Mode=OneWay}" Style="{StaticResource DigitalClockText}" FontSize="48" Foreground="#4F9CE6" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="2" Background="#11161B" BorderBrush="#30383F" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Current Remaining Time" Foreground="#D4D7DA" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentRemainingText, Mode=OneWay}" Style="{StaticResource DigitalClockText}" FontSize="52" Foreground="#E45B61" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding CurrentProgressPercent, Mode=OneWay}" Height="10" Margin="2,0" Foreground="#4F9CE6" Background="#1E2227" BorderThickness="0"/>
                        <UniformGrid Grid.Row="2" Rows="1" Columns="8" Margin="2,5,2,4">
                            <Button Style="{StaticResource Transport}" Click="ProgramStart_Click" ToolTip="GO TO IN" AutomationProperties.Name="Go to IN point"><StackPanel HorizontalAlignment="Center"><TextBlock Text="|◀" FontSize="16" HorizontalAlignment="Center"/><TextBlock Text="IN" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource Transport}" Command="{Binding StopCommand}" ToolTip="STOP" AutomationProperties.Name="Stop program"><StackPanel HorizontalAlignment="Center"><TextBlock Text="■" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="STOP" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource Transport}" Command="{Binding PauseCommand}" ToolTip="PAUSE / RESUME" AutomationProperties.Name="Pause or resume program"><StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding ProgramPlayPauseGlyph, Mode=OneWay}" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="{Binding PlayPauseStateText, Mode=OneWay}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource Transport}" Command="{Binding NextCommand}" ToolTip="NEXT" AutomationProperties.Name="Next event"><StackPanel HorizontalAlignment="Center"><TextBlock Text="▶|" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="NEXT" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource Transport}" Click="ProgramBack_Click" ToolTip="BACK 5 SEC" AutomationProperties.Name="Back five seconds"><StackPanel HorizontalAlignment="Center"><TextBlock Text="↶" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="-5 SEC" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource Transport}" Command="{Binding PlayCommand}" ToolTip="PLAY" AutomationProperties.Name="Play program"><StackPanel HorizontalAlignment="Center"><TextBlock Text="▶" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="PLAY" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource Transport}" Click="ProgramForward_Click" ToolTip="FORWARD 5 SEC" AutomationProperties.Name="Forward five seconds"><StackPanel HorizontalAlignment="Center"><TextBlock Text="↷" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="+5 SEC" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource Transport}" Command="{Binding TakeSelectedCommand}" ToolTip="TAKE SELECTED" AutomationProperties.Name="Take selected item"><StackPanel HorizontalAlignment="Center"><TextBlock Text="✦" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="TAKE" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></Button>
                        </UniformGrid>
                        <Grid Grid.Row="3" Margin="2,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Background="#0F1419" BorderBrush="#303840" BorderThickness="1" Padding="4">
                                <StackPanel HorizontalAlignment="Center"><TextBlock Text="Station Time" Foreground="#98A2A9" FontSize="8.5"/><TextBlock x:Name="LocalClockText" Text="00:00:00" Style="{StaticResource DigitalClockText}" Foreground="#E9C91E" FontSize="17"/><TextBlock x:Name="LocalDateText" Text="DATE" Foreground="#6F7A82" FontSize="6.5" HorizontalAlignment="Center"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#0F1419" BorderBrush="#303840" BorderThickness="0,1,1,1" Padding="4"><StackPanel HorizontalAlignment="Center"><TextBlock Text="Playlist Played Time" Foreground="#98A2A9" FontSize="8.5"/><TextBlock Text="{Binding PlaylistPlayedTimeText, Mode=OneWay}" Style="{StaticResource DigitalClockText}" Foreground="#97C63E" FontSize="17"/></StackPanel></Border>
                            <Border Grid.Column="2" Background="#0F1419" BorderBrush="#303840" BorderThickness="0,1,1,1" Padding="4"><StackPanel HorizontalAlignment="Center"><TextBlock Text="Playlist Remaining Time" Foreground="#98A2A9" FontSize="8.5"/><TextBlock Text="{Binding PlaylistRemainingTimeText, Mode=OneWay}" Style="{StaticResource DigitalClockText}" Foreground="#F06A3C" FontSize="17"/></StackPanel></Border>
                            <Border Grid.Column="3" Background="#0F1419" BorderBrush="#303840" BorderThickness="0,1,1,1" Padding="4"><StackPanel HorizontalAlignment="Center"><TextBlock Text="Next Event" Foreground="#98A2A9" FontSize="8.5"/><TextBlock Text="{Binding NextDurationText, Mode=OneWay}" Style="{StaticResource DigitalClockText}" Foreground="#D67CD9" FontSize="17"/></StackPanel></Border>
                            <Border Grid.Column="4" Background="#0F1419" BorderBrush="#303840" BorderThickness="0,1,1,1" Padding="4"><StackPanel HorizontalAlignment="Center"><TextBlock Text="Selected Remaining" Foreground="#98A2A9" FontSize="8.5"/><TextBlock Text="{Binding SelectedRemainingTimeText, Mode=OneWay}" Style="{StaticResource DigitalClockText}" Foreground="#E33A4E" FontSize="17"/></StackPanel></Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT SIDEBAR TOP/ALL -->
            <GridSplitter x:Name="RightSidebarSplitter" Grid.Row="2" Grid.RowSpan="3" Grid.Column="1" Width="5" HorizontalAlignment="Left" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent" ShowsPreview="True" Background="#28313A" Panel.ZIndex="99"/>
            <Border x:Name="RightSidebarPanel" Grid.Row="2" Grid.RowSpan="3" Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,5,4">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition x:Name="NowPlayingRow" Height="1.0*" MinHeight="112"/><RowDefinition x:Name="NextRow" Height="0.82*" MinHeight="94"/><RowDefinition x:Name="UpNextRow" Height="0.82*" MinHeight="94"/><RowDefinition x:Name="EventLogRow" Height="1.15*" MinHeight="120"/><RowDefinition x:Name="MediaDockRow" Height="1.7*" MinHeight="170"/></Grid.RowDefinitions>
                    <!-- NOW PLAYING / NEXT / UP NEXT share one layout: thumbnail (type placeholder when none) + title, type · category, duration, path, IN/OUT wall-clock -->
                    <Border x:Name="NowPlayingCard" Grid.Row="0" Style="{StaticResource RightCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="▣  NOW PLAYING" Style="{StaticResource PanelTitle}"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Background="#0B141E" BorderBrush="#26313B" BorderThickness="1" Margin="0,3,9,0"><Grid><TextBlock Text="{Binding CurrentItem.EventType, Mode=OneWay, FallbackValue='OFF AIR'}" Foreground="#4E5B66" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding CurrentItem.ThumbnailPath, Mode=OneWay}" Stretch="UniformToFill"/><Border Background="#B3B91C1C" VerticalAlignment="Bottom" Padding="3"><TextBlock Text="ON AIR" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/></Border></Grid></Border>
                        <StackPanel Grid.Column="1" Margin="0,3,0,0"><TextBlock Text="{Binding NowPlayingAutoText, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><ContentControl Content="{Binding CurrentItem, Mode=OneWay}" Style="{StaticResource NowNextDetailHost}"/><TextBlock Text="{Binding AutoCgStatusText, Mode=OneWay}" Foreground="#B78BE7" FontSize="9" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Grid></Border>
                    <Border x:Name="NextCard" Grid.Row="1" Style="{StaticResource RightCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="NEXT" Style="{StaticResource PanelTitle}"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Background="#0B141E" BorderBrush="#26313B" BorderThickness="1" Margin="0,3,9,0"><Grid><TextBlock Text="{Binding NextItem.EventType, Mode=OneWay, FallbackValue='--'}" Foreground="#4E5B66" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding NextItem.ThumbnailPath, Mode=OneWay}" Stretch="UniformToFill"/><Border Background="#B3073389" VerticalAlignment="Bottom" Padding="3"><TextBlock Text="NEXT" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/></Border></Grid></Border>
                        <StackPanel Grid.Column="1" Margin="0,3,0,0"><TextBlock Text="{Binding NextAutoText, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><ContentControl Content="{Binding NextItem, Mode=OneWay}" Style="{StaticResource NowNextDetailHost}"/></StackPanel></Grid></Grid></Border>
                    <Border x:Name="UpNextCard" Grid.Row="2" Style="{StaticResource RightCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="UP NEXT" Style="{StaticResource PanelTitle}"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Background="#0B141E" BorderBrush="#26313B" BorderThickness="1" Margin="0,3,9,0"><Grid><TextBlock Text="{Binding UpNextItem.EventType, Mode=OneWay, FallbackValue='--'}" Foreground="#4E5B66" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding UpNextItem.ThumbnailPath, Mode=OneWay}" Stretch="UniformToFill"/><Border Background="#B314243A" VerticalAlignment="Bottom" Padding="3"><TextBlock Text="UP NEXT" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/></Border></Grid></Border>
                        <StackPanel Grid.Column="1" Margin="0,3,0,0"><TextBlock Text="{Binding UpNextAutoText, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><ContentControl Content="{Binding UpNextItem, Mode=OneWay}" Style="{StaticResource NowNextDetailHost}"/></StackPanel></Grid></Grid></Border>
                    <Border x:Name="EventLogCard" Grid.Row="3" Style="{StaticResource RightCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="EVENT LOG" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/><ComboBox x:Name="EventLogFilterCombo" Grid.Column="1" Width="100" Height="24" SelectionChanged="EventLogFilter_SelectionChanged" ToolTip="Filter the event log"><ComboBoxItem Content="All" IsSelected="True"/><ComboBoxItem Content="On-Air"/><ComboBoxItem Content="Warnings"/></ComboBox></Grid>
                        <ListBox x:Name="EventLogList" Grid.Row="1" ItemsSource="{Binding RecentEvents}" FontSize="9" Background="#0B1015"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2"><Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="56"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Width="6" Height="6" Fill="{Binding DotColor, Mode=OneTime}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding TimeText, Mode=OneTime}" Foreground="#8E999F"/><TextBlock Grid.Column="2" Text="{Binding Message, Mode=OneTime}" Foreground="{Binding MessageColor, Mode=OneTime}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message, Mode=OneTime}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                    <Border x:Name="MediaDockCard" Grid.Row="4" Style="{StaticResource RightCard}" Padding="7">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid x:Name="ClipInfoPanel" Grid.Row="0" Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="102"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="CLIP INFO" Style="{StaticResource PanelTitle}"/><TextBlock Text="{Binding SelectedItem.Title, Mode=OneWay, TargetNullValue='NO SELECTION'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SelectedItem.MediaDetails, Mode=OneWay}" Foreground="#89939B" FontSize="8.5" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedItem.FilePath, Mode=OneWay}" Foreground="#65717A" FontSize="8" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <Image Grid.Column="1" Source="{Binding SelectedItem.ThumbnailPath, Mode=OneWay}" Stretch="UniformToFill" Margin="7,0,0,0"/>
                            </Grid>
                            <Expander x:Name="MediaDockExpander" Grid.Row="1" Header="FILE EXPLORER / MEDIA DOCK" IsExpanded="False" Expanded="MediaDockExpander_Expanded" Collapsed="MediaDockExpander_Collapsed" Foreground="#B78BE7" Background="#0A0F14">
                                <Grid Margin="0,5,0,0"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/><ColumnDefinition Width="58"/><ColumnDefinition Width="64"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><ComboBox x:Name="MediaRootCombo" ItemsSource="{Binding MediaRoots, ElementName=RootWindow}" SelectionChanged="MediaRootCombo_SelectionChanged"/><Button Grid.Column="1" Content="UP" Style="{StaticResource SmallTool}" Height="26" Click="EmbeddedMediaUp_Click" ToolTip="Go to the parent folder"/><Button x:Name="EmbeddedMediaScanButton" Grid.Column="2" Content="SCAN" Style="{StaticResource SmallTool}" Height="26" Click="EmbeddedMediaScan_Click" ToolTip="Scan the currently selected drive/folder"/><Button Grid.Column="3" Content="FOLDER" Style="{StaticResource SmallTool}" Height="26" Click="EmbeddedMediaFolder_Click" ToolTip="Choose and register another media folder"/><Button Grid.Column="4" Content="APP" Style="{StaticResource SmallTool}" Height="26" Click="FileManager_Click"/></Grid>
                                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><TextBox x:Name="EmbeddedMediaSearch" TextChanged="EmbeddedMediaSearch_TextChanged" ToolTip="Search scanned media"/><ComboBox x:Name="EmbeddedCategoryFilter" Grid.Column="1" SelectionChanged="EmbeddedCategoryFilter_SelectionChanged"><ComboBoxItem Content="All" IsSelected="True"/><ComboBoxItem Content="Media"/><ComboBoxItem Content="Music"/><ComboBoxItem Content="News"/><ComboBoxItem Content="Commercial"/><ComboBoxItem Content="Graphics"/></ComboBox></Grid>
                                    <ListBox x:Name="EmbeddedMediaList" Grid.Row="2" ItemsSource="{Binding EmbeddedMedia, ElementName=RootWindow}" SelectedItem="{Binding SelectedEmbeddedMedia, ElementName=RootWindow, Mode=TwoWay}" PreviewMouseMove="EmbeddedMediaList_PreviewMouseMove" MouseDoubleClick="EmbeddedMediaList_MouseDoubleClick" Background="#090E13">
                                        <ListBox.ItemTemplate><DataTemplate><Grid Margin="2"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Border Width="40" Height="25" Background="#05080B"><Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="5,0"><TextBlock Text="{Binding ParsedName}" FontSize="8.7" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="7.8" Foreground="#77838C"><Run Text="{Binding Duration, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Format, Mode=OneWay}"/></TextBlock></StackPanel><TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="#B78BE7" FontSize="8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="CATEGORY" Style="{StaticResource SectionCaption}" VerticalAlignment="Center"/><ComboBox x:Name="EmbeddedCategoryAssign" Grid.Column="1" IsEditable="True" Text="{Binding SelectedEmbeddedMedia.Category, ElementName=RootWindow, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"><ComboBoxItem Content="Media"/><ComboBoxItem Content="Music"/><ComboBoxItem Content="News"/><ComboBoxItem Content="Commercial"/><ComboBoxItem Content="Graphics"/></ComboBox><Button Grid.Column="2" Content="SET" Style="{StaticResource SmallTool}" Height="26" Click="EmbeddedCategorySet_Click"/></Grid>
                                </Grid>
                            </Expander>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- SCHEDULE TIMELINE (COLLAPSED BY DEFAULT; USER CLICKS TIMELINE TO EXPAND) -->
            <Border x:Name="RundownTimelinePanel" Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="5,0,4,4" Padding="8" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#A45BFF" Margin="0,0,6,0"/><TextBlock Text="RUNDOWN TIMELINE" Style="{StaticResource PanelTitle}"/></StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TimelineDateText, Mode=OneWay}" Foreground="#D7DCE0"/>
                        <Button Grid.Column="2" Content="OPEN SCHEDULER" Style="{StaticResource SmallTool}" Height="24" MinHeight="24" Click="Scheduler_Click"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="170,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TimelineStartText, Mode=OneWay}" Foreground="#9BA5AD"/>
                        <TextBlock Grid.Column="1" Text="{Binding TimelineMidText, Mode=OneWay}" HorizontalAlignment="Center" Foreground="#9BA5AD"/>
                        <TextBlock Grid.Column="2" Text="{Binding TimelineEndText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#9BA5AD"/>
                        <Border Grid.Column="3" Background="#6B3A93" CornerRadius="2" Padding="6,1" Margin="8,0,0,0"><TextBlock Text="{Binding TimelinePlayheadText, Mode=OneWay}" FontSize="9" Foreground="White"/></Border>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,7,0">
                            <ComboBox SelectedIndex="0" Height="28"><ComboBoxItem Content="Current Rundown"/></ComboBox>
                            <ComboBox SelectedIndex="0" Height="28" Margin="0,4,0,0"><ComboBoxItem Content="Follow Program"/></ComboBox>
                        </StackPanel>
                        <Border x:Name="TimelineSurface" Grid.Column="1" Background="#090E13" BorderBrush="#232E37" BorderThickness="1" ClipToBounds="True" SizeChanged="TimelineSurface_SizeChanged" MouseLeftButtonDown="TimelineSurface_MouseLeftButtonDown">
                            <Canvas Width="{Binding TimelineCanvasWidth, Mode=OneWay}" Height="60" HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding TimelineBlocks}" Width="{Binding TimelineCanvasWidth, Mode=OneWay}" Height="60">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left, Mode=OneWay}"/><Setter Property="Canvas.Top" Value="0"/></Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding Width, Mode=OneWay}" Height="58" Background="{Binding Background, Mode=OneWay}" BorderBrush="{Binding Border, Mode=OneWay}" BorderThickness="1" CornerRadius="2" Padding="7,5" Margin="0,0,2,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding StartText, Mode=OneWay}" FontSize="8" Foreground="#B7C0C7"/>
                                                    <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DurationText, Mode=OneWay}" FontSize="8.5" Foreground="#C6CDD2"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Width="2" Height="60" Background="#FF4B62" Canvas.Left="{Binding TimelinePlayheadX, Mode=OneWay}" Panel.ZIndex="20"/>
                            </Canvas>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- CURRENT PLAYLIST -->
            <Border x:Name="PlaylistPanel" Grid.Row="3" Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="5,0,4,4">
                <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Grid.Column="1" Background="#0C1217" Margin="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="CURRENT PLAYLIST:" Style="{StaticResource PanelTitle}"/><TextBlock Text="  EVENING ENTERTAINMENT" Foreground="#F1F5F9" FontWeight="Bold" FontSize="13" Margin="4,0,0,0"/></StackPanel><Border Grid.Column="1" Background="#080D11" BorderBrush="#27303A" BorderThickness="1" Margin="14,5" CornerRadius="2" MaxWidth="240" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" Margin="8,0" VerticalAlignment="Center"/><TextBox x:Name="PlaylistSearchBox" Background="Transparent" BorderThickness="0" TextChanged="PlaylistSearch_TextChanged" MinHeight="26" Width="195" Padding="0,2"/></StackPanel></Border><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,8,0"><Button Content="＋" Style="{StaticResource SmallTool}" Command="{Binding AddCommand}" ToolTip="Add media"/><Button Content="⏱ TIMELINE" Style="{StaticResource SmallTool}" Click="ToggleRundownTimeline_Click" ToolTip="Toggle Rundown Timeline View"/><Button Content="✂" Style="{StaticResource SmallTool}" Click="Trim_Click" ToolTip="Trim"/><Button Content="▣" Style="{StaticResource SmallTool}" Click="PlaylistEditor_Click" ToolTip="Playlist Editor"/><Button Content="↗" Style="{StaticResource SmallTool}" Click="PlaylistDockOut_Click" ToolTip="Dock playlist out to a separate resizable operator window"/><Button Content="×" Style="{StaticResource SmallTool}" Command="{Binding RemoveCommand}" ToolTip="Remove selected"/></StackPanel></Grid>
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="#0A0F14" BorderBrush="#26313A" BorderThickness="0,0,1,0" Padding="6">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="35"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="BLOCKS / CATEGORIES" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="+" Style="{StaticResource SmallTool}" Height="24" MinHeight="24" Padding="2,0" Click="StartBlock_Click" ToolTip="Start a new block at the selected rundown item"/><Button Grid.Column="2" Content="ALL" Style="{StaticResource SmallTool}" Height="24" MinHeight="24" Padding="3,0" Click="ClearRundownBlockFilter_Click" ToolTip="Show complete rundown"/></Grid>
                            <ListBox x:Name="RundownBlockList" Grid.Row="1" ItemsSource="{Binding RundownBlocks}" SelectionChanged="RundownBlockList_SelectionChanged" Background="#080C10" BorderThickness="0" Padding="0,4,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate DataType="{x:Type models:RundownBlockNode}">
                                    <Border Padding="5,6" BorderBrush="#26313A" BorderThickness="0,0,0,1">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="🔁 Toggle Block Loop" Click="ToggleBlockLoop_Click"/>
                                                <MenuItem Header="✏ Rename Block..." Click="RenameBlock_Click"/>
                                                <MenuItem Header="Start Block Here" Click="StartBlock_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#D6B7EE" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LoopBadge}" Foreground="#FFC107" FontWeight="Bold" FontSize="8.5" Margin="4,0,0,0"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Category}" FontSize="8" Foreground="#73808A"/><TextBlock Grid.Column="1" Text="{Binding DurationText, Mode=OneWay}" FontSize="8" Foreground="#8B97A0"/></Grid><TextBlock Text="{Binding Count, StringFormat='{}{0} item(s)'}" FontSize="8" Foreground="#65717A"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
