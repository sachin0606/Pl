<Window x:Class="BroadcastPlayout.Views.MediaAssetManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix MAM" Width="1540" Height="900" MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg0Brush}" PreviewKeyDown="Window_PreviewKeyDown" Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-mam.ico">
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Bg0Brush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#121519" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-mam.png" Width="34" Height="34" Stretch="Uniform"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="KASHTRIX MEDIA ASSET MANAGEMENT" FontSize="18" FontWeight="Bold"/><TextBlock Text="Asset GUID · versions · SHA-256 · proxy · QC · rights/workflow · archive/restore · drag to Playout / Ingest / CG" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel></Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="REFRESH" Click="Refresh_Click"/><Button Content="ADD ROOT" Click="AddRoot_Click"/><Button Content="FILE MANAGER" Click="FileManager_Click"/><Button Content="INGEST" Click="Ingest_Click"/><Button Content="CG EDITOR" Click="CgEditor_Click"/><Button Click="Minimize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button><Button Click="Maximize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button><Button Click="Close_Click" Style="{StaticResource WindowCloseButton}"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="10,6,10,4" Style="{StaticResource PanelBorder}" Padding="6">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" ToolTip="Search file name, title, tags, description, category, format or path" TextChanged="Search_Changed"/>
                <ComboBox x:Name="CategoryFilter" Grid.Column="1" Margin="6,0,0,0" SelectionChanged="Search_Changed"><ComboBoxItem Content="ALL CATEGORIES" IsSelected="True"/><ComboBoxItem Content="Media"/><ComboBoxItem Content="News"/><ComboBoxItem Content="Commercial"/><ComboBoxItem Content="Music"/><ComboBoxItem Content="Graphics"/><ComboBoxItem Content="Archive"/></ComboBox>
                <ComboBox x:Name="TypeFilter" Grid.Column="2" Margin="6,0,0,0" SelectionChanged="Search_Changed"><ComboBoxItem Content="ALL TYPES" IsSelected="True"/><ComboBoxItem Content="VIDEO"/><ComboBoxItem Content="AUDIO"/></ComboBox>
                <TextBlock Grid.Column="3" x:Name="ResultCountText" Text="0 ASSETS" Foreground="#B78BE7" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="10,4"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="8">
                <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                    <TextBlock Text="STORAGE / MEDIA ROOTS" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                    <ListBox Grid.Row="1" x:Name="RootList" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot, Mode=TwoWay}" SelectionChanged="Root_SelectionChanged"/>
                    <Button Grid.Row="2" Content="SCAN SELECTED ROOT" Click="Refresh_Click"/>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" Background="#26313A"/>
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <DataGrid x:Name="AssetGrid" ItemsSource="{Binding AssetsView}" SelectedItem="{Binding SelectedAsset, Mode=TwoWay}" SelectionMode="Extended" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" PreviewMouseMove="AssetGrid_PreviewMouseMove" SelectionChanged="AssetGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="PREVIEW" Width="96"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="82" Height="46" Background="Black" Margin="2"><Image Source="{Binding Media.ThumbnailPath}" Stretch="UniformToFill"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="TITLE" Binding="{Binding DisplayTitle, Mode=OneWay}" Width="220"/>
                        <DataGridTextColumn Header="FILE" Binding="{Binding Media.FileName, Mode=OneWay}" Width="220"/>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Metadata.Category, Mode=OneWay}" Width="105"/>
                        <DataGridTextColumn Header="TAGS" Binding="{Binding Metadata.Tags, Mode=OneWay}" Width="170"/>
                        <DataGridTextColumn Header="DURATION" Binding="{Binding Media.Duration, Mode=OneWay}" Width="90"/>
                        <DataGridTextColumn Header="FORMAT" Binding="{Binding Media.Format, Mode=OneWay}" Width="190"/>
                        <DataGridTextColumn Header="VERSION" Binding="{Binding AssetVersionText, Mode=OneWay}" Width="70"/>
                        <DataGridTextColumn Header="WORKFLOW / QC / STORAGE" Binding="{Binding HistorySummary, Mode=OneWay}" Width="220"/>
                        <DataGridTextColumn Header="DUP" Binding="{Binding DuplicateText, Mode=OneWay}" Width="75"/>
                        <DataGridTextColumn Header="SIZE" Binding="{Binding Media.SizeText, Mode=OneWay}" Width="85"/>
                        <DataGridTextColumn Header="MODIFIED" Binding="{Binding ModifiedText, Mode=OneWay}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <GridSplitter Grid.Column="3" Width="8" ResizeDirection="Columns" Background="#26313A"/>
            <Border Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="ASSET INSPECTOR" Style="{StaticResource PanelTitle}"/>
                    <Border Height="190" Background="Black" BorderBrush="#303A42" BorderThickness="1" Margin="0,8,0,0"><Image Source="{Binding SelectedAsset.Media.ThumbnailPath}" Stretch="Uniform"/></Border>
                    <TextBlock Text="{Binding SelectedAsset.Media.FilePath, TargetNullValue='NO ASSET SELECTED'}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Border Margin="0,10,0,2" Padding="8" BorderBrush="#34434E" BorderThickness="1" Background="#101820">
                        <StackPanel>
                            <TextBlock Text="ENTERPRISE ASSET RECORD" Style="{StaticResource SectionCaption}"/>
                            <TextBlock Text="{Binding SelectedAsset.Catalog.AssetIdText, StringFormat=GUID  {0}}" FontFamily="Consolas" FontSize="10" Foreground="#8ED7FF" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedAsset.AssetVersionText, StringFormat=VERSION  {0}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedAsset.Catalog.StorageState, StringFormat=STORAGE  {0}}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="{Binding SelectedAsset.Catalog.IntegritySummary}" Foreground="#D0D8DE" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="TITLE" Style="{StaticResource SectionCaption}" Margin="0,12,0,3"/><TextBox Text="{Binding SelectedAsset.Metadata.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="CATEGORY" Style="{StaticResource SectionCaption}" Margin="0,9,0,3"/><ComboBox IsEditable="True" Text="{Binding SelectedAsset.Metadata.Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Media"/><ComboBoxItem Content="News"/><ComboBoxItem Content="Commercial"/><ComboBoxItem Content="Music"/><ComboBoxItem Content="Graphics"/><ComboBoxItem Content="Archive"/></ComboBox>
                    <TextBlock Text="TAGS" Style="{StaticResource SectionCaption}" Margin="0,9,0,3"/><TextBox Text="{Binding SelectedAsset.Metadata.Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comma-separated tags"/>
                    <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionCaption}" Margin="0,9,0,3"/><TextBox Text="{Binding SelectedAsset.Metadata.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="72"/>
                    <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="OWNER" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedAsset.Metadata.Owner, Mode=TwoWay}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="RIGHTS NOTE" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedAsset.Metadata.Rights, Mode=TwoWay}" Margin="0,3,0,0"/></StackPanel></Grid>
                    <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="APPROVAL STATE" Style="{StaticResource SectionCaption}"/><ComboBox SelectedValue="{Binding SelectedAsset.Catalog.ApprovalState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Margin="0,3,0,0"><ComboBoxItem Content="Draft"/><ComboBoxItem Content="Review"/><ComboBoxItem Content="Approved"/><ComboBoxItem Content="Rejected"/><ComboBoxItem Content="Blocked"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="QC STATUS" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding SelectedAsset.Catalog.QcStatus, Mode=OneWay}" IsReadOnly="True" Margin="0,3,0,0"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="RIGHTS START" Style="{StaticResource SectionCaption}"/><DatePicker SelectedDate="{Binding SelectedAsset.Catalog.RightsStartUtc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="RIGHTS END" Style="{StaticResource SectionCaption}"/><DatePicker SelectedDate="{Binding SelectedAsset.Catalog.RightsEndUtc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/></StackPanel>
                    </Grid>
                    <TextBlock Text="PROXY" Style="{StaticResource SectionCaption}" Margin="0,9,0,3"/><TextBox Text="{Binding SelectedAsset.Catalog.ProxyPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                    <TextBlock Text="ARCHIVE" Style="{StaticResource SectionCaption}" Margin="0,9,0,3"/><TextBox Text="{Binding SelectedAsset.Catalog.ArchivePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                    <TextBlock Text="NOTES" Style="{StaticResource SectionCaption}" Margin="0,9,0,3"/><TextBox Text="{Binding SelectedAsset.Metadata.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="64"/>
                    <WrapPanel Margin="0,10,0,0"><Button Content="SAVE METADATA + WORKFLOW" Click="SaveMetadata_Click" BorderBrush="{StaticResource AccentBrush}"/><Button Content="VERIFY SHA-256" Click="VerifyChecksum_Click"/><Button Content="RUN QC" Click="RunQc_Click"/><Button Content="GENERATE PROXY" Click="GenerateProxy_Click"/><Button Content="ARCHIVE" Click="Archive_Click"/><Button Content="RESTORE" Click="Restore_Click"/><Button Content="OPEN LOCATION" Click="OpenLocation_Click"/><Button Content="COPY PATH" Click="CopyPath_Click"/></WrapPanel>
                    <TextBlock Text="ASSET HISTORY" Style="{StaticResource SectionCaption}" Margin="0,12,0,3"/>
                    <Button Content="REFRESH HISTORY" Click="RefreshHistory_Click" HorizontalAlignment="Left"/>
                    <TextBox x:Name="HistoryBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="130" FontFamily="Consolas" FontSize="9" Margin="0,4,0,0"/>
                    <TextBlock Text="Drag one or many selected assets from the table. Kashtrix exports standard Windows FileDrop data, so the same drag works with Playout, Playlist Editor, CG Editor, Ingest and normal Explorer-compatible applications." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="9" Margin="0,12,0,0"/>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="MAM INDEX · LOCAL METADATA STORE" Foreground="#6F7C85" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
    </Border>
</Window>
