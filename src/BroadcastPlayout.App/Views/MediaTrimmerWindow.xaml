<Window x:Class="BroadcastPlayout.Views.MediaTrimmerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Multipart Media Trimmer" Width="1360" Height="820" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip" PreviewKeyDown="Window_PreviewKeyDown" Background="{StaticResource Bg0Brush}">
    <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="104"/><RowDefinition Height="52"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#0B1016" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="MULTIPART MEDIA TRIMMER" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="FileText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#231936" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="3" Padding="12,6"><StackPanel Orientation="Horizontal"><TextBlock Text="EVENT  "/><TextBlock x:Name="TotalDurationText" Style="{StaticResource DigitalClockText}" FontSize="20" Foreground="#C7A6FF"/></StackPanel></Border><Button Width="36" Height="30" Click="Minimize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button><Button Width="36" Height="30" Click="Maximize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button><Button Width="36" Height="30" Click="Cancel_Click" Style="{StaticResource WindowCloseButton}"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button></StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="54"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                    <Border Background="Black" BorderBrush="#313841" BorderThickness="1"><Grid><Image x:Name="PreviewImage" Stretch="Uniform"/><TextBlock x:Name="LoadingText" Text="LOADING PREVIEW…" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/><Border Background="#B8000000" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"><TextBlock x:Name="CurrentTimeText" Style="{StaticResource DigitalClockText}" FontSize="23"/></Border></Grid></Border>
                    <Grid Grid.Row="1" Margin="2,6,2,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="18"/></Grid.RowDefinitions><Slider x:Name="SeekSlider" Style="{StaticResource SeekSlider}" ValueChanged="SeekSlider_ValueChanged"/><Grid Grid.Row="1"><TextBlock Text="00:00:00" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="EndText" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></Grid></Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="|◀" Width="58" Click="Start_Click"/><Button Content="-1s" Width="58" Click="BackSecond_Click"/><Button Content="-1f" Width="58" Click="BackFrame_Click"/><Button Content="+1f" Width="58" Click="ForwardFrame_Click"/><Button Content="+1s" Width="58" Click="ForwardSecond_Click"/><Button Content="▶|" Width="58" Click="End_Click"/></StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="118"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MEDIA PARTS" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="One source file · many trim ranges · one playlist event" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><TextBlock Grid.Column="1" x:Name="PartsCountText" Foreground="#A981FF" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
                    <DataGrid Grid.Row="1" x:Name="PartsGrid" ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart, Mode=TwoWay}" RowHeight="34" ColumnHeaderHeight="30">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="ON" Binding="{Binding Enabled, Mode=TwoWay}" Width="38"/>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="36"/>
                            <DataGridTextColumn Header="PART NAME" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="IN" Binding="{Binding InPointText}" Width="86"/>
                            <DataGridTextColumn Header="OUT" Binding="{Binding OutPointText}" Width="86"/>
                            <DataGridTextColumn Header="DURATION" Binding="{Binding DurationText, Mode=OneWay}" Width="86" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><UniformGrid Columns="5"><Button Content="ADD PART" Click="AddPart_Click" BorderBrush="{StaticResource GoodBrush}"/><Button Content="UPDATE" Click="UpdatePart_Click"/><Button Content="DUPLICATE" Click="DuplicatePart_Click"/><Button Content="REMOVE" Click="RemovePart_Click"/><Button Content="CLEAR ALL" Click="ClearParts_Click"/></UniformGrid><UniformGrid Grid.Row="1" Columns="4"><Button Content="MOVE UP" Click="MoveUp_Click"/><Button Content="MOVE DOWN" Click="MoveDown_Click"/><Button Content="GO PART IN" Click="GoPartIn_Click"/><Button Content="GO PART OUT" Click="GoPartOut_Click"/></UniformGrid></Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="240"/><ColumnDefinition Width="16"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="TRIM MARKERS" Style="{StaticResource SectionCaption}"/><TextBlock Text="Set IN and OUT, then ADD PART. Repeat for every section you want from this one media file." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="SET IN" Width="86" Click="SetIn_Click" BorderBrush="{StaticResource GoodBrush}"/><Button Content="SET OUT" Width="86" Click="SetOut_Click" BorderBrush="{StaticResource OnAirBrush}"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="IN POINT" Style="{StaticResource SectionCaption}"/><TextBox x:Name="InBox" FontFamily="Digital-7, DSEG7 Classic, Consolas" FontSize="18" Margin="0,6,0,0" LostFocus="PointBox_LostFocus"/><Slider x:Name="InMarkerSlider" ValueChanged="InMarkerSlider_ValueChanged"/><Button Content="GO IN" Click="GoIn_Click" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="OUT POINT" Style="{StaticResource SectionCaption}"/><TextBox x:Name="OutBox" FontFamily="Digital-7, DSEG7 Classic, Consolas" FontSize="18" Margin="0,6,0,0" LostFocus="PointBox_LostFocus"/><Slider x:Name="OutMarkerSlider" ValueChanged="OutMarkerSlider_ValueChanged"/><Button Content="GO OUT" Click="GoOut_Click" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Column="6"><TextBlock Text="CURRENT RANGE" Style="{StaticResource SectionCaption}"/><TextBlock x:Name="DurationText" Style="{StaticResource DigitalClockText}" FontSize="28" Foreground="#A981FF" Margin="0,4,0,0"/><TextBlock x:Name="TrimInfoText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="65"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="AUTO SPLIT (SEC):" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"/>
            <TextBox x:Name="AutoSplitIntervalBox" Grid.Column="1" Text="60" Height="26" VerticalAlignment="Center" TextAlignment="Center" FontFamily="Consolas" ToolTip="Split duration per part in seconds (e.g. 60)"/>
            <Button Grid.Column="2" Content="⚡ AUTO SPLIT &amp; INSERT" Click="AutoSplit_Click" Margin="6,0,0,0" Padding="10,0" Height="26" Background="#2A1B38" BorderBrush="#B78BE7" Foreground="#E2D4F0" FontWeight="Bold" ToolTip="Automatically split media into equal parts and insert as separate rundown items"/>
            <TextBlock Grid.Column="3" Text="" VerticalAlignment="Center"/>
            <Button Grid.Column="4" Content="CANCEL" Click="Cancel_Click" Height="26"/>
            <Button Grid.Column="5" Content="SAVE MULTIPART" Click="Save_Click" Height="26" Background="#17321A" BorderBrush="{StaticResource GoodBrush}" FontWeight="Bold"/>
            <Button Grid.Column="6" Content="SAVE SEPARATE" Click="SaveSeparate_Click" Height="26" Background="#25183A" BorderBrush="{StaticResource AccentBrush}" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
