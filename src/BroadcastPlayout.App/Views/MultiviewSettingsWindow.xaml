<Window x:Class="BroadcastPlayout.Views.MultiviewSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MULTIVIEWER SETTINGS &amp; QC ALERTS"
        Width="720" Height="670" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}" SnapsToDevicePixels="True">

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- Custom Chrome Header -->
            <Border Grid.Row="0" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="MULTIVIEWER CONFIGURATION · SMTP &amp; QC ALERTS" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—" Width="30" Height="24" Click="Minimize_Click" Style="{StaticResource ChromeButton}" ToolTip="Minimize"/>
                        <Button Content="✕" Width="30" Height="24" Click="Close_Click" Style="{StaticResource ChromeButton}" Foreground="#FF8989" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Navigation Bar for Multiviewer Settings Tabs -->
            <Border Grid.Row="1" Background="#181122" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TabSmtpBtn" Content="EMAIL &amp; SMTP ALERTS" Click="TabSmtp_Click"
                            Background="#3E2359" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button x:Name="TabQcBtn" Content="QC THRESHOLDS &amp; DETECTION" Click="TabQc_Click"
                            Background="#251B31" BorderThickness="0" Foreground="#B78BE7" FontWeight="SemiBold" FontSize="11" Padding="14,6" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#10131A" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="MONITORING PROFILE" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" x:Name="ProfileComboBox" DisplayMemberPath="Name" SelectionChanged="ProfileComboBox_SelectionChanged"/>
                    <TextBox Grid.Column="2" x:Name="ProfileNameText" Margin="6,0" ToolTip="Profile name"/>
                    <Button Grid.Column="3" Content="NEW" Click="NewProfile_Click" Padding="10,4"/>
                    <Button Grid.Column="4" Content="SAVE" Click="SaveProfile_Click" Padding="10,4"/>
                    <Button Grid.Column="5" Content="ACTIVATE" Click="ActivateProfile_Click" Padding="10,4" Background="#3E2359" BorderBrush="{StaticResource AccentBrush}"/>
                    <TextBlock Grid.Column="6" x:Name="ActiveProfileText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#55C878" FontWeight="SemiBold" FontSize="10"/>
                </Grid>
            </Border>

            <!-- Tab Content -->
            <Grid Grid.Row="3" Margin="20,16">
                <!-- TAB 1: SMTP & EMAIL CONFIGURATION -->
                <ScrollViewer x:Name="SmtpPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox x:Name="EnableEmailAlertsCheck" Content="Enable Automated Email Alerts for Multiview Events"
                                  FontSize="13" FontWeight="Bold" Foreground="#B78BE7" Margin="0,0,0,16" Cursor="Hand"/>
                        <CheckBox x:Name="EnableDesktopNotificationsCheck" Content="Enable in-app notifications and audible alarms" Foreground="{StaticResource TextBrush}" Margin="0,-8,0,14"/>

                        <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="SMTP SERVER CONFIGURATION" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="SMTP Server Host:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Grid.Column="1" x:Name="SmtpServerText" Height="26" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Port:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Grid.Column="3" x:Name="SmtpPortText" Text="587" Height="26" HorizontalContentAlignment="Center" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center"/>
                                </Grid>

                                <CheckBox x:Name="EnableSslCheck" Content="Use SSL / TLS Secure Connection" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,4,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="SMTP Username:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Grid.Column="1" x:Name="SmtpUserText" Height="26" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="SMTP Password:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                    <PasswordBox Grid.Column="1" x:Name="SmtpPassBox" Height="26" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Sender Email:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Grid.Column="1" x:Name="SenderEmailText" Text="alerts@kashtrix.broadcasthost.tv" Height="26" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Recipient Email:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Grid.Column="1" x:Name="RecipientEmailText" Text="noc@broadcasthost.tv" Height="26" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center"/>
                                </Grid>

                                <Button Content="SEND TEST ALERT EMAIL" Click="TestEmail_Click" Width="180" Height="28" HorizontalAlignment="Left"
                                        Background="#251B31" BorderBrush="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,8,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelBorder}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="EMAIL NOTIFICATION TRIGGERS" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <CheckBox x:Name="AlertBlackCheck" Content="Black Frame Occurrence" IsChecked="True" Foreground="{StaticResource TextBrush}" Width="200" Margin="0,0,10,8"/>
                                    <CheckBox x:Name="AlertFreezeCheck" Content="Video Signal Freeze" IsChecked="True" Foreground="{StaticResource TextBrush}" Width="200" Margin="0,0,10,8"/>
                                    <CheckBox x:Name="AlertSilenceCheck" Content="Audio Silence / Loss" IsChecked="True" Foreground="{StaticResource TextBrush}" Width="200" Margin="0,0,10,8"/>
                                    <CheckBox x:Name="AlertScteCheck" Content="SCTE-35 Splice Detection" IsChecked="True" Foreground="{StaticResource TextBrush}" Width="200" Margin="0,0,10,8"/>
                                    <CheckBox x:Name="AlertQualityCheck" Content="Quality / Bitrate Drop" IsChecked="True" Foreground="{StaticResource TextBrush}" Width="200" Margin="0,0,10,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 2: QC THRESHOLDS & MONITORING -->
                <ScrollViewer x:Name="QcPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="QUALITY CONTROL DETECTION THRESHOLDS" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14"/>

                        <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="VIDEO ANALYSIS" FontWeight="Bold" Foreground="#B78BE7" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Quality Threshold:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="QualityThresholdText" Text="85" Height="26" HorizontalContentAlignment="Center" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="% (flags tile when signal decode confidence drops below threshold)" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Minimum Bitrate Alarm:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="MinBitrateText" Text="4.5" Height="26" HorizontalContentAlignment="Center" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Mbps (flags low transport throughput on IP/UDP streams)" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Black Frame Detector Alarm:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="BlackSecondsText" Text="2.0" Height="26" HorizontalContentAlignment="Center" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="seconds of contiguous black" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Black Luma Threshold:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="BlackLumaText" Text="12" Height="26" HorizontalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="0–255 average luma" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Video Freeze Detector Alarm:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="FreezeSecondsText" Text="3.0" Height="26" HorizontalContentAlignment="Center" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="seconds of static identical frames" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Signal Loss Alarm:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="SignalLossSecondsText" Text="2.0" Height="26" HorizontalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="seconds without decoded frames" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <CheckBox x:Name="Scte35DetectionCheck" Content="Enable Realtime SCTE-35 Splice &amp; Cue Tone Detection" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelBorder}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="AUDIO ANALYSIS &amp; LOUDNESS (EBU R128 / ATSC A/85)" FontWeight="Bold" Foreground="#B78BE7" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Audio Silence / Low Alarm:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="AudioSilenceSecondsText" Text="3.0" Height="26" HorizontalContentAlignment="Center" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="seconds below minimum threshold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Low Audio Cutoff Level:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="AudioLowDbfsText" Text="-42.0" Height="26" HorizontalContentAlignment="Center" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="dBFS" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Target Loudness:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TargetLufsText" Text="-23.0" Height="26" HorizontalContentAlignment="Center" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="LUFS (Integrated Target)" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Loudness Tolerance:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="LoudnessToleranceText" Text="1.0" Height="26" HorizontalContentAlignment="Center" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="± LU" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Bottom Action Footer -->
            <Border Grid.Row="4" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusInfoText" Text="Multiviewer QC thresholds monitor all wall tiles in real time." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="CANCEL" Click="Cancel_Click" Width="90" Height="32" Margin="0,0,8,0"
                                Background="#251B31" BorderBrush="{StaticResource LineBrush}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Cursor="Hand"/>
                        <Button Content="CONFIRM &amp; APPLY" Click="Confirm_Click" Width="140" Height="32"
                                Background="#3E2359" BorderBrush="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
