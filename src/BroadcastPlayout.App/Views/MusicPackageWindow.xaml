<Window x:Class="BroadcastPlayout.Views.MusicPackageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MUSIC NOW / NEXT PACKAGE"
        Width="720" Height="640"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}" SnapsToDevicePixels="True">
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <Border Background="#181122" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="MUSIC NOW / NEXT PACKAGE" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕" Width="28" Height="24" Click="Cancel_Click" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,14">
                    <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Song title, rolling credits and a progress bar stay on screen for the whole song. The NEXT / LATER box plays the upcoming songs inside a small window."/>

                    <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <CheckBox x:Name="EnabledCheck" Content="SHOW SONG INFO + PROGRESS BAR" Style="{StaticResource ToggleSwitch}"/>
                            <CheckBox x:Name="VideoBoxCheck" Content="SHOW NEXT / LATER VIDEO BOX" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"
                                      ToolTip="Same option as 'Next Item Video' in Now / Next fields"/>
                            <TextBlock Text="Playlist categories (comma separated)" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/>
                            <TextBox x:Name="CategoriesBox"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="VIDEO BOX TIMING" FontWeight="SemiBold" FontSize="14"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="NEXT appears at (s)" Style="{StaticResource SectionCaption}"/><TextBox x:Name="FirstNextBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="NEXT holds (s)" Style="{StaticResource SectionCaption}"/><TextBox x:Name="NextHoldBox"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Then LATER holds (s, 0 = off)" Style="{StaticResource SectionCaption}"/><TextBox x:Name="LaterHoldBox"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="NEXT again before end (s, 0 = off)" Style="{StaticResource SectionCaption}"/><TextBox x:Name="EndNextBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Preview starts at (% of song)" Style="{StaticResource SectionCaption}"/><TextBox x:Name="PreviewStartBox"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="GRAPHICS" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Both are normal CG templates; restyle them in the CG Designer." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Song info template" Style="{StaticResource SectionCaption}"/><ComboBox x:Name="InfoTemplateBox" IsEditable="True"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="CG layer" Style="{StaticResource SectionCaption}"/><TextBox x:Name="InfoLayerBox"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Video box template" Style="{StaticResource SectionCaption}"/><ComboBox x:Name="BoxTemplateBox" IsEditable="True"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="CG layer" Style="{StaticResource SectionCaption}"/><TextBox x:Name="BoxLayerBox"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,12,0,0"
                               Text="Song credits come from Item Properties → EPG METADATA → SONG CREDITS. For many songs at once, put a credits.csv in the media folder with columns File, Title, Film, Singer, Lyrics, Music, Label. Otherwise the file name 'Title - Film - Singer' is used."/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="CANCEL" Click="Cancel_Click" Width="90" Height="32" Margin="0,0,8,0"/>
                        <Button Content="SAVE" Click="Save_Click" Width="110" Height="32" Background="#3E2359" BorderBrush="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
