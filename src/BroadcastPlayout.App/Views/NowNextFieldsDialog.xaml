<Window x:Class="BroadcastPlayout.Views.NowNextFieldsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SELECT NOW / NEXT FIELDS"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}" SnapsToDevicePixels="True">

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Custom Chrome Header Bar -->
            <Border Grid.Row="0" Background="#181122" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SELECT NOW / NEXT FIELDS" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕" Width="28" Height="24" Click="Close_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Two Columns: NOW and NEXT -->
            <Grid Grid.Row="1" Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- NOW COLUMN -->
                <StackPanel Grid.Column="0" Margin="10,0">
                    <TextBlock Text="NOW" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>
                    <CheckBox x:Name="NowPlayingCheck" Content="Now Playing Item" IsChecked="True" Foreground="#B78BE7" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,12"/>
                    <CheckBox x:Name="NowDescriptionCheck" Content="Now Item Description" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,12"/>
                    <CheckBox x:Name="NowGenreCheck" Content="Now Item Genre" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,12"/>
                    <CheckBox x:Name="NowYearCheck" Content="Now Item Year" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,12"/>
                    <CheckBox x:Name="NowPosterCheck" Content="Now Item Poster (Image)" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,12"/>
                    <CheckBox x:Name="NowVideoCheck" Content="Now Item Video" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,12"/>
                </StackPanel>

                <!-- Center Divider -->
                <Border Grid.Column="1" Background="{StaticResource LineBrush}"/>

                <!-- NEXT COLUMN -->
                <StackPanel Grid.Column="2" Margin="20,0,10,0">
                    <TextBlock Text="NEXT" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>
                    <CheckBox x:Name="NextItemCheck" Content="Next Item" IsChecked="True" Foreground="#B78BE7" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,12"/>
                    <CheckBox x:Name="NextStartTimeCheck" Content="Start Time Of Next Item" IsChecked="True" Foreground="#B78BE7" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,12"/>
                    <CheckBox x:Name="NextDescriptionCheck" Content="Next Item Description" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,12"/>
                    <CheckBox x:Name="NextGenreCheck" Content="Next Item Genre" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,12"/>
                    <CheckBox x:Name="NextYearCheck" Content="Next Item Year" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,12"/>
                    <CheckBox x:Name="NextPosterCheck" Content="Next Item Poster (Image)" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,12"/>
                    <CheckBox x:Name="NextVideoCheck" Content="Next Item Video" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,12"/>
                </StackPanel>
            </Grid>

            <!-- Bottom Action Buttons: SELECT ALL, SAME IN NEXT, SAME IN CURRENT, SELECT ALL -->
            <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left side buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="SELECT ALL" Click="SelectAllNow_Click" Width="120" Height="28" Margin="0,0,10,0"
                                Background="#251B31" BorderBrush="{StaticResource AccentBrush}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" Cursor="Hand"/>
                        <Button Content="SAME IN NEXT" Click="SameInNext_Click" Width="120" Height="28"
                                Background="#251B31" BorderBrush="{StaticResource AccentBrush}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Grid.Column="1" Background="{StaticResource LineBrush}"/>

                    <!-- Right side buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="SAME IN CURRENT" Click="SameInCurrent_Click" Width="120" Height="28" Margin="0,0,10,0"
                                Background="#251B31" BorderBrush="{StaticResource AccentBrush}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" Cursor="Hand"/>
                        <Button Content="SELECT ALL" Click="SelectAllNext_Click" Width="120" Height="28"
                                Background="#251B31" BorderBrush="{StaticResource AccentBrush}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
