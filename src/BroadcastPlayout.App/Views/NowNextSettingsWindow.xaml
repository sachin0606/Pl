<Window x:Class="BroadcastPlayout.Views.NowNextSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOW / NEXT GRAPHICS"
        Width="1180" Height="760"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}" SnapsToDevicePixels="True">
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <Border Background="#181122" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="NOW / NEXT GRAPHICS" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕" Width="28" Height="24" Click="Cancel_Click" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelBorder}" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <CheckBox x:Name="EnabledCheck" Content="NOW / NEXT GRAPHICS ON" Style="{StaticResource ToggleSwitch}"/>
                            <CheckBox x:Name="VideoBoxCheck" Content="VIDEO PREVIEW INSIDE THE BOX" Style="{StaticResource ToggleSwitch}" Margin="0,8,0,0"
                                      ToolTip="Same option as 'Next Item Video'. Off (or live / no file): a title card shows instead."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="28,0,0,0" Width="170">
                            <TextBlock Text="Preview starts at (% of item)" Style="{StaticResource SectionCaption}"/>
                            <TextBox x:Name="PreviewStartBox"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Margin="28,0,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="NEXT and LATER are what really airs next: the Channel Schedule while its automation runs (news, movies, programmes, live), otherwise the playlist. Schedule or playlist changes update the graphic immediately. Ads are never announced."/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="PER TYPE OF ITEM (matched by playlist category, first match wins)" FontWeight="SemiBold" Margin="4,0,0,8"/>
                        <DataGrid x:Name="ProfilesGrid" Grid.Row="1" ItemsSource="{Binding Profiles}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NAME" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="105"/>
                                <DataGridTextColumn Header="CATEGORIES" Binding="{Binding Categories, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                <DataGridCheckBoxColumn Header="INFO" Binding="{Binding ShowInfo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                                <DataGridTemplateColumn Header="BOX" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.BoxModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding BoxMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="FIRST AT (S)" Binding="{Binding StartAtSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="82"/>
                                <DataGridTextColumn Header="HOLD (S)" Binding="{Binding HoldSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="66"/>
                                <DataGridCheckBoxColumn Header="LATER" Binding="{Binding ShowLater, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                                <DataGridTextColumn Header="LATER (S)" Binding="{Binding LaterHoldSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="68"/>
                                <DataGridTextColumn Header="BEFORE END (S)" Binding="{Binding EndLeadSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="100"/>
                                <DataGridTextColumn Header="EVERY (MIN)" Binding="{Binding RepeatEveryMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="82"/>
                                <DataGridTextColumn Header="TIMES" Binding="{Binding RepeatTimes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="52"/>
                                <DataGridTemplateColumn Header="TIME SHOWN" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.TimeDisplays, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding TimeDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="COUNTDOWN (MIN)" Binding="{Binding CountdownMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="112"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="BOX: StartAndEnd = after FIRST AT, and again BEFORE END (0 = skip that one) · Continuous = whole item, NEXT / LATER alternate · Repeat = every N minutes, TIMES times (0 = until the end). TIME SHOWN: Time 20:00 · Countdown IN 5 MIN · Both · Auto = time, then countdown inside COUNTDOWN minutes."/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Button Content="ADD" Click="AddProfile_Click" Width="70" Height="28" Margin="0,0,6,0"/>
                                <Button Content="REMOVE" Click="RemoveProfile_Click" Width="80" Height="28" Margin="0,0,6,0"/>
                                <Button Content="DEFAULTS" Click="DefaultProfiles_Click" Width="90" Height="28"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelBorder}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="VIEWER REQUESTS ON SCREEN" FontWeight="SemiBold"/>
                            <CheckBox x:Name="ShowRequestsCheck" Content="SHOW 'REQUESTED BY'" Style="{StaticResource ToggleSwitch}" Margin="0,8,0,0" Click="RequestOption_Changed"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Prefix" Style="{StaticResource SectionCaption}"/><TextBox x:Name="RequestPrefixBox" TextChanged="RequestPrefix_Changed"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="14,0,0,4">
                                    <CheckBox x:Name="RequestNameCheck" Content="Name" Click="RequestOption_Changed"/>
                                    <CheckBox x:Name="RequestCityCheck" Content="City" Margin="14,0,0,0" Click="RequestOption_Changed"/>
                                    <CheckBox x:Name="RequestMessageCheck" Content="Message / dedication" Margin="14,0,0,0" Click="RequestOption_Changed"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="RequestPreviewText" Foreground="#FFF59D" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="GRAPHICS (normal CG templates, restyle them in the CG Designer)" FontWeight="SemiBold"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Now playing info" Style="{StaticResource SectionCaption}"/><ComboBox x:Name="InfoTemplateBox" IsEditable="True"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="CG layer" Style="{StaticResource SectionCaption}"/><TextBox x:Name="InfoLayerBox"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="NEXT / LATER box" Style="{StaticResource SectionCaption}"/><ComboBox x:Name="BoxTemplateBox" IsEditable="True"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="CG layer" Style="{StaticResource SectionCaption}"/><TextBox x:Name="BoxLayerBox"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               Text="Song credits: Item Properties → SONG CREDITS, or credits.csv in the media folder (File, Title, Film, Singer, Lyrics, Music, Label)."/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="CANCEL" Click="Cancel_Click" Width="90" Height="32" Margin="0,0,8,0"/>
                        <Button Content="SAVE" Click="Save_Click" Width="110" Height="32" Background="#3E2359" BorderBrush="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
