<Window x:Class="BroadcastPlayout.Views.PlaylistEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Playlist Editor" Width="1580" Height="900" MinWidth="1280" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" PreviewKeyDown="Window_PreviewKeyDown" Background="{StaticResource Bg0Brush}" Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-playlisteditor.ico">
    <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#101216" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="K" FontSize="24" Foreground="#8E64C7" FontWeight="Bold"/><TextBlock Text="  KASHTRIX PLAYLIST EDITOR" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="NEW" Click="LoadDemo_Click"/><Button Content="OPEN" Click="Open_Click"/><Button Content="SAVE" Click="Save_Click"/><Button Content="PUBLISH TO PLAYOUT" Click="Send_Click" Background="#281A3A" BorderBrush="{StaticResource AccentBrush}"/><Button Content="SETTINGS" Click="OpenSettings_Click"/><Button Style="{StaticResource WindowControlButton}" Click="Minimize_Click"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button><Button Style="{StaticResource WindowControlButton}" Click="Maximize_Click"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button><Button Style="{StaticResource WindowCloseButton}" Click="Close_Click"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button></StackPanel></ScrollViewer></Grid></Border>
        <Grid Grid.Row="1" Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="220"/><RowDefinition Height="132"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="SOURCE / CUE PREVIEW" Style="{StaticResource SectionCaption}"/><Border Grid.Row="1" Background="Black" BorderBrush="#30343A" BorderThickness="1"><Image x:Name="PreviewImage" Stretch="Uniform"/></Border><Grid Grid.Row="2" Margin="0,9,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="{Binding SelectedItem.Title, TargetNullValue='NO EVENT SELECTED'}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SelectedItem.MediaDetails, Mode=OneWay, TargetNullValue='Select a media event'}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding SelectedItem.QcSummary}" Foreground="#C49A58" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal"><Button Content="{Binding PreviewPlayPauseGlyph}" Click="PreviewPlayPause_Click" ToolTip="Play / pause source preview"/><Button Content="■" Click="PreviewStop_Click" ToolTip="Stop source preview"/><Button Content="SET IN" Click="SetIn_Click"/><Button Content="SET OUT" Click="SetOut_Click"/><Button Content="MULTIPART TRIM…" Click="Trim_Click" BorderBrush="{StaticResource AccentBrush}"/></StackPanel></Grid><StackPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock Text="PARTS IN THIS EVENT" Style="{StaticResource SectionCaption}"/><ListBox ItemsSource="{Binding SelectedItem.Parts}" Margin="0,6,0,0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#272B31" BorderThickness="0,0,0,1" Padding="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10"><Run Text="{Binding InPointText, Mode=OneWay}"/><Run Text="  →  "/><Run Text="{Binding OutPointText, Mode=OneWay}"/></TextBlock></StackPanel><TextBlock Grid.Column="1" Text="{Binding DurationText, Mode=OneWay}" Style="{StaticResource TimecodeText}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Grid></Border><GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" Background="#202830"/>
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions><Grid Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="CURRENT PLAYLIST" FontWeight="SemiBold"/><TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding PlaylistCountText}" Foreground="#9F7BD5"/></StackPanel><ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="+ MEDIA" Command="{Binding AddCommand}"/><Button Content="+ INPUT" Click="AddInput_Click"/><Button Content="+ STOP" Click="AddStop_Click"/><Button Content="+ PLAY" Click="AddPlay_Click"/><Button Content="+ PAUSE" Click="AddPause_Click"/><Button Content="+ NOTE" Click="AddNote_Click"/><Button Content="PROPERTIES" Click="Properties_Click"/><Button Content="DUPLICATE" Click="Duplicate_Click"/><Button Content="▲" Click="MoveUp_Click"/><Button Content="▼" Click="MoveDown_Click"/><Button Content="REMOVE" Command="{Binding RemoveCommand}"/></StackPanel></ScrollViewer></Grid><DataGrid x:Name="PlaylistGrid" Grid.Row="1" ItemsSource="{Binding Playlist}" SelectedItem="{Binding SelectedItem}" FontSize="{Binding PlaylistFontSize}" RowHeight="{Binding PlaylistRowHeight}" AllowDrop="True" PreviewMouseLeftButtonDown="PlaylistGrid_PreviewMouseLeftButtonDown" PreviewMouseMove="PlaylistGrid_PreviewMouseMove" Drop="PlaylistGrid_Drop" MouseDoubleClick="PlaylistGrid_MouseDoubleClick"><DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="Background" Value="{Binding CategoryColor}"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Completed"/><Condition Binding="{Binding DataContext.DimCompletedItems, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Opacity" Value="0.58"/><Setter Property="Foreground" Value="#68737C"/></MultiDataTrigger><Trigger Property="IsSelected" Value="True"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="38"/><DataGridTemplateColumn Header="MEDIA" Width="74"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#08090B" Margin="3"><Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="TYPE" Binding="{Binding EventType}" Width="64"/><DataGridTextColumn Header="BLOCK" Binding="{Binding BlockName}" Width="80"/><DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="92"/><DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="150"/><DataGridTextColumn Header="PARTS" Binding="{Binding PartsSummary, Mode=OneWay}" Width="70"/><DataGridTextColumn Header="DURATION" Binding="{Binding DurationText, Mode=OneWay}" Width="86"/><DataGridTextColumn Header="FORMAT" Binding="{Binding VideoFormat}" Width="135"/><DataGridTextColumn Header="QC" Binding="{Binding QcStatus}" Width="70"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="78"/></DataGrid.Columns></DataGrid><Grid Grid.Row="2" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="One playlist item can contain multiple trim parts from the same source media." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding PlaylistDurationText, Mode=OneWay}" Style="{StaticResource TimecodeText}" VerticalAlignment="Center" Foreground="#A981FF"/></Grid></Grid></Border><GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" Background="#202830"/>
            <Border Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="10"><StackPanel><TextBlock Text="EVENT DETAILS" Style="{StaticResource SectionCaption}"/><TextBlock Text="{Binding SelectedItem.Title, TargetNullValue='—'}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/><Separator Margin="0,10"/><TextBlock Text="SOURCE" Style="{StaticResource SectionCaption}"/><TextBlock Text="{Binding SelectedItem.SourceDescription, TargetNullValue='—'}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="DURATION" Style="{StaticResource SectionCaption}" Margin="0,12,0,0"/><TextBlock Text="{Binding SelectedItem.DurationText, Mode=OneWay, TargetNullValue='--:--:--'}" Style="{StaticResource DigitalClockText}" FontSize="28" Foreground="#B792E7"/><TextBlock Text="MEDIA" Style="{StaticResource SectionCaption}" Margin="0,12,0,0"/><TextBlock Text="{Binding SelectedItem.MediaDetails, Mode=OneWay, TargetNullValue='—'}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="QC" Style="{StaticResource SectionCaption}" Margin="0,12,0,0"/><TextBlock Text="{Binding SelectedItem.QcStatus, TargetNullValue='—'}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedItem.QcSummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><Border Background="#15111C" BorderBrush="#352946" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,18,0,0"><TextBlock Text="MULTIPART WORKFLOW&#x0a;&#x0a;1. Select one media event.&#x0a;2. Open MULTIPART TRIM.&#x0a;3. Define as many IN/OUT ranges as needed.&#x0a;4. Save once.&#x0a;&#x0a;Playout treats all enabled parts as one continuous event." TextWrapping="Wrap" Foreground="#C7BBD5"/></Border></StackPanel></Border>
        </Grid>
        <Border Grid.Row="2" Background="#0D0F12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{StaticResource GoodBrush}"/><TextBlock Text="  Playlist validation and multipart playback enabled" Foreground="{StaticResource GoodBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="Kashtrix Playlist v3" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
</Window>
