<Window x:Class="BroadcastPlayout.Views.PlaylistItemPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rundown Item Properties" Width="980" Height="780" MinWidth="820" MinHeight="650"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" Background="{StaticResource Bg0Brush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0B1016" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0,5,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="RUNDOWN ITEM PROPERTIES" FontWeight="SemiBold"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding Item.Title}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="580"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource WindowControlButton}" Click="Minimize_Click"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button><Button Style="{StaticResource WindowControlButton}" Click="Maximize_Click"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button><Button Style="{StaticResource WindowCloseButton}" Click="Cancel_Click"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button></StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="12">
            <TabItem Header="GENERAL / LOOK">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="OPERATOR FIELDS" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Title" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox Text="{Binding Item.Title, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Category" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><ComboBox x:Name="CategoryCombo" IsEditable="True" Text="{Binding Item.Category, UpdateSourceTrigger=LostFocus}"><ComboBoxItem Content="Media"/><ComboBoxItem Content="Music"/><ComboBoxItem Content="News"/><ComboBoxItem Content="Commercial"/><ComboBoxItem Content="Graphics"/><ComboBoxItem Content="Live"/><ComboBoxItem Content="Control"/><ComboBoxItem Content="Signaling"/><ComboBoxItem Content="Captions/Subtitles"/><ComboBoxItem Content="Automation"/></ComboBox>
                        <TextBlock x:Name="ManagedCategoryHint" Text="For control events this category is assigned automatically from the event type." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="Event type" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><ComboBox x:Name="EventTypeCombo" IsEditable="True" Text="{Binding Item.EventType, UpdateSourceTrigger=LostFocus}"><ComboBoxItem Content="CLIP"/><ComboBoxItem Content="LIVE"/><ComboBoxItem Content="CG"/><ComboBoxItem Content="STOP"/><ComboBoxItem Content="PLAY"/><ComboBoxItem Content="PAUSE"/><ComboBoxItem Content="RESUME"/><ComboBoxItem Content="NEXT"/><ComboBoxItem Content="NOTE"/><ComboBoxItem Content="SCTE35"/><ComboBoxItem Content="SCTE104"/><ComboBoxItem Content="CAPTION608"/><ComboBoxItem Content="CAPTION708"/><ComboBoxItem Content="DVBSUB"/><ComboBoxItem Content="GPO"/><ComboBoxItem Content="RS422"/><ComboBoxItem Content="VDCP"/><ComboBoxItem Content="SNMP"/></ComboBox>
                        <TextBlock Text="Notes / description" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Item.Notes, UpdateSourceTrigger=PropertyChanged}" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                        <TextBlock Text="PLAYBACK LOOP &amp; BLOCK CONTROLS" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <CheckBox Content="Loop this item" IsChecked="{Binding Item.IsLoop, Mode=TwoWay}" Margin="0,0,16,0" Style="{StaticResource ToggleSwitch}"/>
                            <CheckBox Content="Loop entire block" IsChecked="{Binding Item.IsBlockLoop, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}"/>
                        </StackPanel>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Loop count (0 = ∞):" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBox Grid.Column="2" Text="{Binding Item.LoopCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="4" Text="Block Name:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBox Grid.Column="6" Text="{Binding Item.BlockName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PLAYLIST APPEARANCE" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Row color" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox Text="{Binding Item.RowColor, UpdateSourceTrigger=PropertyChanged}" ToolTip="#221C2E or #FF221C2E; blank uses category color"/>
                        <WrapPanel Margin="0,5,0,0"><Button Content="AUTO" Click="ColorAuto_Click"/><Button Content="MUSIC" Tag="#182F46" Click="ColorPreset_Click"/><Button Content="NEWS" Tag="#251A38" Click="ColorPreset_Click"/><Button Content="AD" Tag="#3A3019" Click="ColorPreset_Click"/><Button Content="LIVE" Tag="#3B1B20" Click="ColorPreset_Click"/></WrapPanel>
                        <TextBlock Text="Row text color" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Item.RowTextColor, UpdateSourceTrigger=PropertyChanged}" ToolTip="#D9DEE3; item-specific rundown text color"/>
                        <WrapPanel Margin="0,5,0,0"><Button Content="WHITE" Tag="#F4F6F8" Click="TextColorPreset_Click"/><Button Content="CYAN" Tag="#7ED9FF" Click="TextColorPreset_Click"/><Button Content="PINK" Tag="#FF72C7" Click="TextColorPreset_Click"/><Button Content="GOLD" Tag="#FFD166" Click="TextColorPreset_Click"/></WrapPanel>
                        <TextBlock Text="Thumbnail" Style="{StaticResource SectionCaption}" Margin="0,14,0,4"/><TextBox Text="{Binding Item.ThumbnailPath, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                        <TextBlock Text="Source / File" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox Text="{Binding Item.FilePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48"/>
                        <TextBlock Text="Format / QC" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Item.MediaDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/><TextBox Text="{Binding Item.QcSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="52" Margin="0,6,0,0"/>
                        <TextBlock Text="IN / OUT / Parts" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBlock><Run Text="{Binding Item.InPointText, Mode=OneWay}"/><Run Text="  →  "/><Run Text="{Binding Item.OutPointText, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Item.PartsSummary, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </Grid></ScrollViewer>
            </TabItem>

            <TabItem Header="AUDIO / VIDEO">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PER-ITEM AUDIO" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Channel conversion / routing" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/>
                        <ComboBox SelectedValue="{Binding Item.AudioChannelMode, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Auto Stereo"/><ComboBoxItem Content="Stereo"/><ComboBoxItem Content="Mono to Stereo"/><ComboBoxItem Content="Left to Stereo"/><ComboBoxItem Content="Right to Stereo"/><ComboBoxItem Content="Swap L/R"/><ComboBoxItem Content="Mono Sum"/><ComboBoxItem Content="Ch 3/4"/><ComboBoxItem Content="Ch 5/6"/><ComboBoxItem Content="Ch 7/8"/></ComboBox>
                        <TextBlock Text="Audio track index (-1 = Auto)" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox Text="{Binding Item.AudioTrackIndex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Audio delay (-5000…5000 ms)" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox Text="{Binding Item.AudioDelayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Volume level" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><Slider Minimum="0" Maximum="200" TickFrequency="5" Value="{Binding Item.AudioGainPercent, Mode=TwoWay}"/><TextBlock Text="{Binding Item.AudioGainPercent, StringFormat='{}{0}%'}" Foreground="{StaticResource MutedBrush}"/>
                        <CheckBox Content="Mute this item" IsChecked="{Binding Item.AudioMuted, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PER-ITEM VIDEO / DECODER" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Scale mode" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><ComboBox SelectedValue="{Binding Item.ScaleMode, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Fit"/><ComboBoxItem Content="Fill"/><ComboBoxItem Content="Stretch"/><ComboBoxItem Content="Original"/></ComboBox>
                        <TextBlock Text="Aspect ratio" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><ComboBox SelectedValue="{Binding Item.AspectRatioMode, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="16:9"/><ComboBoxItem Content="4:3"/><ComboBoxItem Content="1:1"/><ComboBoxItem Content="21:9"/><ComboBoxItem Content="Custom"/></ComboBox>
                        <TextBlock Text="Custom aspect (e.g. 16:9)" Style="{StaticResource SectionCaption}" Margin="0,8,0,4"/><TextBox Text="{Binding Item.CustomAspectRatio, Mode=TwoWay}"/>
                        <TextBlock Text="Interlace / field processing" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><ComboBox SelectedValue="{Binding Item.InterlaceMode, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="Progressive"/><ComboBoxItem Content="Deinterlace"/><ComboBoxItem Content="Top Field First"/><ComboBoxItem Content="Bottom Field First"/></ComboBox>
                        <TextBlock Text="File decoder" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><ComboBox SelectedValue="{Binding Item.DecoderPreference, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Auto (CPU+GPU)"/><ComboBoxItem Content="CPU"/><ComboBoxItem Content="GPU Preferred"/><ComboBoxItem Content="CPU+GPU Hybrid"/></ComboBox>
                        <TextBlock Text="Auto / GPU Preferred / Hybrid request hardware-accelerated decode when the installed graphics driver supports the media. Unsupported codecs or drivers fall back to the stable CPU decoder automatically." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="ACTIVE POLICY" Style="{StaticResource SectionCaption}" Margin="0,14,0,4"/><TextBlock Text="{Binding Item.MediaPropertiesSummary, Mode=OneWay}" Foreground="#C79BE8" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid></ScrollViewer>
            </TabItem>


            <TabItem Header="CONTROL / SIGNAL" x:Name="ControlSignalTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
                    <TextBlock Text="EVENT-SPECIFIC CONTROL PROPERTIES" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Only the property block matching this rundown event is shown. Control events trigger and immediately advance; they are excluded from editorial Now/Next graphics." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                    <Border x:Name="DtmfPanel" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DTMF 16-KEY PAD" FontWeight="SemiBold"/><UniformGrid Columns="4" Rows="4" Margin="0,9,0,0"><Button Content="1" Click="DtmfKey_Click"/><Button Content="2" Click="DtmfKey_Click"/><Button Content="3" Click="DtmfKey_Click"/><Button Content="A" Click="DtmfKey_Click"/><Button Content="4" Click="DtmfKey_Click"/><Button Content="5" Click="DtmfKey_Click"/><Button Content="6" Click="DtmfKey_Click"/><Button Content="B" Click="DtmfKey_Click"/><Button Content="7" Click="DtmfKey_Click"/><Button Content="8" Click="DtmfKey_Click"/><Button Content="9" Click="DtmfKey_Click"/><Button Content="C" Click="DtmfKey_Click"/><Button Content="*" Click="DtmfKey_Click"/><Button Content="0" Click="DtmfKey_Click"/><Button Content="#" Click="DtmfKey_Click"/><Button Content="D" Click="DtmfKey_Click"/></UniformGrid><Button Content="CLEAR SEQUENCE" Click="DtmfClear_Click" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Sequence" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.DtmfSequence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Tone duration (ms)" Style="{StaticResource SectionCaption}" Margin="0,10,0,3"/><TextBox Text="{Binding Item.DtmfToneMilliseconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Inter-digit gap (ms)" Style="{StaticResource SectionCaption}" Margin="0,10,0,3"/><TextBox Text="{Binding Item.DtmfGapMilliseconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Level (%)" Style="{StaticResource SectionCaption}" Margin="0,10,0,3"/><Slider Minimum="1" Maximum="100" Value="{Binding Item.DtmfLevelPercent, Mode=TwoWay}"/></StackPanel></Grid></Border>
                    <Border x:Name="DialTonePanel" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="DIAL TONE · 350 + 440 Hz" FontWeight="SemiBold"/><TextBlock Text="Duration (ms)" Style="{StaticResource SectionCaption}" Margin="0,10,0,3"/><TextBox Text="{Binding Item.DialToneMilliseconds, Mode=TwoWay}"/><TextBlock Text="Level (%)" Style="{StaticResource SectionCaption}" Margin="0,10,0,3"/><Slider Minimum="1" Maximum="100" Value="{Binding Item.DialToneLevelPercent, Mode=TwoWay}"/></StackPanel></Border>
                    <Border x:Name="TcpPanel" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TCP CONTROL" FontWeight="SemiBold"/><TextBlock Text="Host" Style="{StaticResource SectionCaption}" Margin="0,10,0,3"/><TextBox Text="{Binding Item.TcpHost, Mode=TwoWay}"/><TextBlock Text="Command" Style="{StaticResource SectionCaption}" Margin="0,10,0,3"/><TextBox Text="{Binding Item.TcpCommand, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Port" Style="{StaticResource SectionCaption}" Margin="0,29,0,3"/><TextBox Text="{Binding Item.TcpPort, Mode=TwoWay}"/></StackPanel></Grid></Border>
                    <Border x:Name="MosPanel" Style="{StaticResource PanelBorder}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MOS EVENT" FontWeight="SemiBold"/><TextBlock Text="Action" Style="{StaticResource SectionCaption}" Margin="0,10,0,3"/><ComboBox SelectedValue="{Binding Item.MosAction, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="CREATE"/><ComboBoxItem Content="UPDATE"/><ComboBoxItem Content="DELETE"/><ComboBoxItem Content="TAKE"/></ComboBox><TextBlock Text="Item / Object ID" Style="{StaticResource SectionCaption}" Margin="0,10,0,3"/><TextBox Text="{Binding Item.MosItemId, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Title / Slug" Style="{StaticResource SectionCaption}" Margin="0,29,0,3"/><TextBox Text="{Binding Item.MosTitle, Mode=TwoWay}" TextWrapping="Wrap"/></StackPanel></Grid></Border>
                    <Border x:Name="Scte35Panel" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="SCTE-35 SPLICE INSERT" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Binary splice_insert() is generated on the configured SCTE-35 PID. Event ID 0 allocates the next channel-local ID." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Splice operation" Style="{StaticResource SectionCaption}"/><ComboBox SelectedValue="{Binding Item.ScteSpliceType, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Start Normal"/><ComboBoxItem Content="Start Immediate"/><ComboBoxItem Content="End Normal"/><ComboBoxItem Content="End Immediate"/><ComboBoxItem Content="Cancel"/></ComboBox><TextBlock Text="Splice event ID (0 = Auto)" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.ScteEventId, Mode=TwoWay}"/><TextBlock Text="Pre-roll (ms)" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.SctePreRollMilliseconds, Mode=TwoWay}"/><TextBlock Text="Optional absolute PTS (90 kHz, 0 = current + pre-roll)" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.SctePts90k, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Break duration (seconds)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.ScteDurationSeconds, Mode=TwoWay}"/><CheckBox Content="AUTO RETURN" IsChecked="{Binding Item.ScteAutoReturn, Mode=TwoWay}" Margin="0,8,0,0"/><TextBlock Text="Unique program ID" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.ScteUniqueProgramId, Mode=TwoWay}"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Avail #" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.ScteAvailNum, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Avails expected" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.ScteAvailsExpected, Mode=TwoWay}"/></StackPanel></Grid></StackPanel></Grid></StackPanel></Border>

                    <Border x:Name="Scte104Panel" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="SCTE-104 SPLICE REQUEST / ANC" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Creates a multiple_operation_message with splice_request_data (opID 0x0101) and queues it as SCTE-104 ANC." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Splice operation" Style="{StaticResource SectionCaption}"/><ComboBox SelectedValue="{Binding Item.ScteSpliceType, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Start Normal"/><ComboBoxItem Content="Start Immediate"/><ComboBoxItem Content="End Normal"/><ComboBoxItem Content="End Immediate"/><ComboBoxItem Content="Cancel"/></ComboBox><TextBlock Text="Splice event ID (0 = Auto)" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.ScteEventId, Mode=TwoWay}"/><TextBlock Text="Pre-roll (ms)" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.SctePreRollMilliseconds, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Break duration (seconds)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.ScteDurationSeconds, Mode=TwoWay}"/><CheckBox Content="AUTO RETURN" IsChecked="{Binding Item.ScteAutoReturn, Mode=TwoWay}" Margin="0,8,0,0"/><TextBlock Text="Unique program ID" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.ScteUniqueProgramId, Mode=TwoWay}"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding Item.ScteAvailNum, Mode=TwoWay}" ToolTip="Avail number"/><TextBox Grid.Column="2" Text="{Binding Item.ScteAvailsExpected, Mode=TwoWay}" ToolTip="Avails expected"/></Grid></StackPanel></Grid></StackPanel></Border>

                    <Border x:Name="Caption608Panel" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="CEA-608 CAPTION EVENT" FontWeight="SemiBold" FontSize="15"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Caption text" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.CaptionText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxLength="256"/><TextBlock Text="Channel" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><ComboBox SelectedValue="{Binding Item.Caption608Channel, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="CC1"/><ComboBoxItem Content="CC2"/><ComboBoxItem Content="CC3"/><ComboBoxItem Content="CC4"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Display mode" Style="{StaticResource SectionCaption}"/><ComboBox SelectedValue="{Binding Item.Caption608Mode, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Pop-On"/><ComboBoxItem Content="Paint-On"/><ComboBoxItem Content="Roll-Up 2"/><ComboBoxItem Content="Roll-Up 3"/><ComboBoxItem Content="Roll-Up 4"/></ComboBox><TextBlock Text="Row (1–15)" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.Caption608Row, Mode=TwoWay}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><CheckBox Content="UNDERLINE" IsChecked="{Binding Item.Caption608Underline, Mode=TwoWay}"/><CheckBox Content="ITALICS" IsChecked="{Binding Item.Caption608Italics, Mode=TwoWay}" Margin="15,0,0,0"/></StackPanel><TextBlock Text="608 text is wrapped to the 32-character line limit and encoded as parity-correct command/text pairs." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Grid></StackPanel></Border>

                    <Border x:Name="Caption708Panel" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="CEA-708 / CDP CAPTION EVENT" FontWeight="SemiBold" FontSize="15"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Caption text" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.CaptionText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Service (1–63)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.Caption708ServiceNumber, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Window (0–7)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.Caption708Window, Mode=TwoWay}"/></StackPanel></Grid></StackPanel><StackPanel Grid.Column="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Row (0–14)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.Caption708Row, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Column (0–31)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.Caption708Column, Mode=TwoWay}"/></StackPanel></Grid><TextBlock Text="Justification" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><ComboBox SelectedValue="{Binding Item.Caption708Justification, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Left"/><ComboBoxItem Content="Center"/><ComboBoxItem Content="Right"/><ComboBoxItem Content="Full"/></ComboBox></StackPanel></Grid></StackPanel></Border>

                    <Border x:Name="DvbSubPanel" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="DVB SUBTITLE EVENT" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="The TS sender writes a subtitling_descriptor in the PMT and EN 300 743 page/region/object/end-of-display segments on the configured subtitle PID." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Subtitle text" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.CaptionText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/><TextBlock Text="ISO 639 language (3 letters)" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.DvbLanguage, Mode=TwoWay}" MaxLength="3"/><TextBlock Text="Page timeout (seconds)" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.DvbTimeoutSeconds, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Subtitling type (decimal 0–255)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.DvbSubtitlingType, Mode=TwoWay}"/><TextBlock Text="Composition page ID" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.DvbCompositionPageId, Mode=TwoWay}"/><TextBlock Text="Ancillary page ID" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.DvbAncillaryPageId, Mode=TwoWay}"/><TextBlock Text="When no ancillary page is used, set ancillary page ID equal to composition page ID." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Grid></StackPanel></Border>

                    <Border x:Name="GpoPanel" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="GPI/GPO OUTPUT EVENT" FontWeight="SemiBold" FontSize="15"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Output index" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.GpoOutput, Mode=TwoWay}"/><TextBlock Text="Action" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><ComboBox SelectedValue="{Binding Item.GpoAction, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Pulse"/><ComboBoxItem Content="Set High"/><ComboBoxItem Content="Set Low"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Pulse duration (ms)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.GpoPulseMilliseconds, Mode=TwoWay}"/><CheckBox Content="ACTIVE HIGH" IsChecked="{Binding Item.GpoActiveHigh, Mode=TwoWay}" Margin="0,10,0,0"/><TextBlock Text="Serial-GPIO adapter maps even/odd outputs to RTS/DTR; external GPIO hardware can replace the adapter behind the same event." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Grid></StackPanel></Border>

                    <Border x:Name="Rs422Panel" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="RS-422 DEVICE COMMAND" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Payload format" Style="{StaticResource SectionCaption}" Margin="0,10,0,3"/><ComboBox SelectedValue="{Binding Item.Rs422Mode, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Raw Hex"/><ComboBoxItem Content="ASCII"/></ComboBox><TextBlock Text="Raw hexadecimal bytes" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.Rs422Hex, Mode=TwoWay}" ToolTip="Example: 02 02 10 01 EF"/><TextBlock Text="ASCII payload" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.Rs422Ascii, Mode=TwoWay}" AcceptsReturn="True" MinHeight="58"/></StackPanel></Border>

                    <Border x:Name="VdcpPanel" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="VDCP VIDEO-SERVER COMMAND" FontWeight="SemiBold" FontSize="15"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Command" Style="{StaticResource SectionCaption}"/><ComboBox SelectedValue="{Binding Item.VdcpCommand, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="PLAY"/><ComboBoxItem Content="STOP"/><ComboBoxItem Content="CUE"/><ComboBoxItem Content="CUE WITH DATA"/><ComboBoxItem Content="PORT STATUS"/><ComboBoxItem Content="RAW HEX"/></ComboBox><TextBlock Text="Port / unit address (0–15)" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.VdcpPort, Mode=TwoWay}"/><TextBlock Text="Clip ID (max 8 ASCII)" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.VdcpClipId, Mode=TwoWay}" MaxLength="8"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Start timecode HH:MM:SS:FF" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.VdcpStartTimecode, Mode=TwoWay}"/><TextBlock Text="Duration timecode HH:MM:SS:FF" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.VdcpDurationTimecode, Mode=TwoWay}"/><TextBlock Text="Raw frame bytes (RAW HEX only)" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.VdcpHex, Mode=TwoWay}"/><TextBlock Text="PLAY/STOP/CUE frames are generated with STX, byte count, TYPE/UA, command, data and VDCP checksum." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Grid></StackPanel></Border>

                    <Border x:Name="SnmpPanel" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock Text="SNMPv2c TRAP EVENT" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Each trap contains the required sysUpTime.0 and snmpTrapOID.0 varbinds, followed by the event varbind configured here." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Destination host" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.SnmpHost, Mode=TwoWay}"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Port" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.SnmpPort, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Community" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.SnmpCommunity, Mode=TwoWay}"/></StackPanel></Grid><TextBlock Text="Trap OID" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.SnmpTrapOid, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Event varbind OID" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.SnmpVarbindOid, Mode=TwoWay}"/><TextBlock Text="Value type" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><ComboBox SelectedValue="{Binding Item.SnmpValueType, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="String"/><ComboBoxItem Content="Integer"/><ComboBoxItem Content="OID"/><ComboBoxItem Content="Counter32"/><ComboBoxItem Content="Gauge32"/><ComboBoxItem Content="TimeTicks"/></ComboBox><TextBlock Text="Value" Style="{StaticResource SectionCaption}" Margin="0,8,0,3"/><TextBox Text="{Binding Item.SnmpValue, Mode=TwoWay}" TextWrapping="Wrap"/></StackPanel></Grid></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="EPG METADATA">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PROGRAMME METADATA" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Original title" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox Text="{Binding Item.OriginalTitle, Mode=TwoWay}"/>
                        <TextBlock Text="Original description" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Item.OriginalDescription, Mode=TwoWay}" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                        <TextBlock Text="Episode title" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Item.EpisodeTitle, Mode=TwoWay}"/>
                        <TextBlock Text="Episode description" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Item.EpisodeDescription, Mode=TwoWay}" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Season" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.EpisodeSeason, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Episode No" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.EpisodeNumber, Mode=TwoWay}"/></StackPanel></Grid>
                        <TextBlock Text="Genre" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Item.Genre, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="EXTENDED EPG" FontSize="16" FontWeight="SemiBold"/>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Production year" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.ProductionYear, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Country" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Item.Country, Mode=TwoWay}"/></StackPanel></Grid>
                        <TextBlock Text="Director" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Item.Director, Mode=TwoWay}"/>
                        <TextBlock Text="Lead actors" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Item.LeadActors, Mode=TwoWay}"/>
                        <TextBlock Text="IMDB URL" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Item.ImdbUrl, Mode=TwoWay}"/>
                        <TextBlock Text="EPG image URL" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Item.ImageUrl, Mode=TwoWay}"/>
                        <TextBlock Text="Parental advisory" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Item.ParentalAdvisory, Mode=TwoWay}"/>
                        <CheckBox Content="Premiere" IsChecked="{Binding Item.Premiere, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid></ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#0B1016" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Per-item properties persist with the playlist and are applied during live playout." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="CANCEL" Click="Cancel_Click" Width="90"/><Button Content="APPLY" Click="Apply_Click" Width="100" Background="#321445" BorderBrush="{StaticResource PinkBrush}"/></StackPanel></Grid></Border>
    </Grid>
</Window>
