<Window x:Class="BroadcastPlayout.Views.ProgramLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Program Launcher" Width="1240" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{StaticResource Bg0Brush}" Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-playout.ico">
    <Window.Resources>
        <Style x:Key="LauncherCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="132"/><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="#0D141C"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Window.Resources>
    <Border BorderBrush="Transparent" BorderThickness="0" Background="#080B11"><Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
        <Border Background="#0C1018" BorderBrush="#30223F" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="14,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-playout.png" Width="34" Height="34" Margin="0,0,10,0"/><StackPanel><TextBlock Text="KASHTRIX APPLICATIONS" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Broadcast suite · every module has its own application identity" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel></StackPanel><Button Grid.Column="1" Content="×" Style="{StaticResource WindowCloseButton}" Click="Close_Click"/></Grid></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12"><UniformGrid Columns="4"><Button Style="{StaticResource LauncherCard}" Tag="CGEditor" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-cgeditor.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CG EDITOR" FontWeight="Bold" Foreground="#E6C4FF" FontSize="12"/><TextBlock Text="Design complete multi-layer CG templates and animations." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>
<Button Style="{StaticResource LauncherCard}" Tag="CGController" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-cgcontroller.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CG CONTROLLER" FontWeight="Bold" Foreground="#E6C4FF" FontSize="12"/><TextBlock Text="Preview and take complete CG compositions to Program." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>
<Button Style="{StaticResource LauncherCard}" Tag="Scheduler" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-scheduler.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="SCHEDULER" FontWeight="Bold" Foreground="#E6C4FF" FontSize="12"/><TextBlock Text="Schedule playlists, timed events and dayparts." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>
<Button Style="{StaticResource LauncherCard}" Tag="PlaylistEditor" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-playlisteditor.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="PLAYLIST EDITOR" FontWeight="Bold" Foreground="#E6C4FF" FontSize="12"/><TextBlock Text="Prepare rundowns, item metadata and media properties." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>
<Button Style="{StaticResource LauncherCard}" Tag="Multiview" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-multiview.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="MULTIVIEWER" FontWeight="Bold" Foreground="#E6C4FF" FontSize="12"/><TextBlock Text="Program, Preview, channels, CG, clocks and system monitoring." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>
<Button Style="{StaticResource LauncherCard}" Tag="ChannelController" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-channelcontroller.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CHANNEL CONTROLLER" FontWeight="Bold" Foreground="#E6C4FF" FontSize="12"/><TextBlock Text="Control and monitor multiple Kashtrix channels." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>
<Button Style="{StaticResource LauncherCard}" Tag="FileManager" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-filemanager.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="FILE MANAGER" FontWeight="Bold" Foreground="#E6C4FF" FontSize="12"/><TextBlock Text="Browse, preview, inspect and prepare media assets." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>
<Button Style="{StaticResource LauncherCard}" Tag="QCController" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-qc.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="QC PLAYER" FontWeight="Bold" Foreground="#E6C4FF" FontSize="12"/><TextBlock Text="Preset-based technical QC and confidence playback." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>
<Button Style="{StaticResource LauncherCard}" Tag="Settings" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-settings.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="SETTINGS" FontWeight="Bold" Foreground="#E6C4FF" FontSize="12"/><TextBlock Text="Channel, output, EPG, media, audio and performance settings." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>
<Button Style="{StaticResource LauncherCard}" Tag="IngestServer" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-ingest.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="INGEST SERVER" FontWeight="Bold" Foreground="#E6C4FF" FontSize="12"/><TextBlock Text="Multi-source capture with broadcast recording presets." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>
<Button Style="{StaticResource LauncherCard}" Tag="MAM" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-mam.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="MEDIA ASSET MANAGEMENT" FontWeight="Bold" Foreground="#E6C4FF" FontSize="12"/><TextBlock Text="Index, search, tag and manage production media." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>


<Button Style="{StaticResource LauncherCard}" Tag="MusicOnDemand" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#127925;" FontSize="38" Width="52" Height="52" TextAlignment="Center" VerticalAlignment="Center" Padding="0,4,0,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="MUSIC ON DEMAND" FontWeight="Bold" Foreground="#FFD700" FontSize="12"/><TextBlock Text="Music playlist automation, audio scheduling, jingle management and on-demand music playout." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>
<Button Style="{StaticResource LauncherCard}" Tag="MovieOnDemand" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#127916;" FontSize="38" Width="52" Height="52" TextAlignment="Center" VerticalAlignment="Center" Padding="0,4,0,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="MOVIE &amp; VOD ON DEMAND" FontWeight="Bold" Foreground="#FF8C42" FontSize="12"/><TextBlock Text="Movie &amp; series scheduling, VOD library management, trailer automation and on-demand video playout." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>
<Button Style="{StaticResource LauncherCard}" Tag="HAController" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-ha.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="HA / REDUNDANCY" FontWeight="Bold" Foreground="#E6C4FF" FontSize="12"/><TextBlock Text="1+1 hot standby, N+M coordinator, failover and output interlock." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>
<Button Style="{StaticResource LauncherCard}" Tag="ApiGateway" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-api.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="API GATEWAY / WEB MCR" FontWeight="Bold" Foreground="#E6C4FF" FontSize="12"/><TextBlock Text="REST, WebSocket, TCP, UDP and MCP control gateway." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button>
<Button Style="{StaticResource LauncherCard}" Tag="OutputEngine" Click="Launch_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-playout.png" Width="52" Height="52" Stretch="Uniform" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="OUTPUT ENGINE MASTER" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="12"/><TextBlock Text="DeckLink, NDI, Matrox, AJA, DVB-TS UDP, SRT, RTMP, HLS, MPD matrix with DVB &amp; SCTE-35." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="9.5"/></StackPanel></Grid></Button></UniformGrid><Border Style="{StaticResource PanelBorder}" Margin="6,8" Padding="12"><TextBlock Text="Audio Mixer is an integrated Playout master-bus tool and opens from Playout → Tools → Audio Mixer. Music On Demand and Movie VOD modules are optimized for entertainment channel automation." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></Border></StackPanel></ScrollViewer>
        <Border Grid.Row="2" Background="#080D12" BorderBrush="#30223F" BorderThickness="0,1,0,0"><Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready · choose an application" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="CLOSE" Click="Close_Click" Width="90" Margin="0,7"/></Grid></Border>
    </Grid></Border>
</Window>
