<Window x:Class="BroadcastPlayout.Views.QcControllerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix QC Controller" Width="1480" Height="850" MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" PreviewKeyDown="Window_PreviewKeyDown" Background="{StaticResource Bg0Brush}" Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-qc.ico">
    <Grid><Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#101216" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="KASHTRIX QC CONTROLLER" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Broadcast media validation · fast probe · deep decode" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="ClockText" Style="{StaticResource DigitalClockText}" FontSize="24" Foreground="#B792E7" Margin="0,0,18,0"/><Button Content="ADD FILES" Click="AddFiles_Click"/><Button Content="ADD FOLDER" Click="AddFolder_Click"/><Button Content="FAST QC" Click="FastQc_Click" Background="#20182B" BorderBrush="{StaticResource AccentBrush}"/><Button Content="DEEP QC" Click="DeepQc_Click"/><Button Content="CLEAR" Click="Clear_Click"/><Button Style="{StaticResource WindowControlButton}" Click="Minimize_Click"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;"/></Button><Button Style="{StaticResource WindowControlButton}" Click="Maximize_Click"><TextBlock x:Name="MaxGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE922;"/></Button><Button Style="{StaticResource WindowCloseButton}" Click="Close_Click"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;"/></Button></StackPanel></Grid></Border>
        <Grid Grid.Row="1" Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="14"><StackPanel><TextBlock Text="ACTIVE QC PRESET" Style="{StaticResource SectionCaption}"/><TextBlock Text="{Binding QcPreset.Name}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding QcPreset.Summary}" Foreground="#B792E7" TextWrapping="Wrap" Margin="0,5,0,0"/><Separator Margin="0,14"/><TextBlock Text="RASTER" Style="{StaticResource SectionCaption}"/><TextBlock><Run Text="{Binding QcPreset.Width, Mode=OneWay}"/><Run Text=" × "/><Run Text="{Binding QcPreset.Height, Mode=OneWay}"/></TextBlock><TextBlock Text="FRAME RATE" Style="{StaticResource SectionCaption}" Margin="0,12,0,0"/><TextBlock><Run Text="{Binding QcPreset.MinimumFrameRate, Mode=OneWay}"/><Run Text=" – "/><Run Text="{Binding QcPreset.MaximumFrameRate, Mode=OneWay}"/><Run Text=" fps"/></TextBlock><TextBlock Text="CODECS" Style="{StaticResource SectionCaption}" Margin="0,12,0,0"/><TextBlock Text="{Binding QcPreset.AllowedVideoCodecs}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><CheckBox Content="Require audio" IsChecked="{Binding QcPreset.RequireAudio}" IsEnabled="False" Margin="0,12,0,0"/><TextBlock Text="Preset changes are made only in Kashtrix Settings and automatically shared here." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,20,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions><Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="QC QUEUE / RESULTS" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Results.Count, StringFormat='{}{0} item(s)'}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" RowHeight="36" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="FILE" Binding="{Binding FileName, Mode=OneWay}" Width="2*"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status, Mode=OneWay}" Width="70"/><DataGridTextColumn Header="SUMMARY" Binding="{Binding Summary, Mode=OneWay}" Width="2*"/><DataGridTextColumn Header="CHECKED UTC" Binding="{Binding CheckedUtc, Mode=OneWay}" Width="150"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" Background="#0F1216" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MEDIATIME-STYLE DETAIL" Style="{StaticResource SectionCaption}"/><ScrollViewer Height="160" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding SelectedResult.Detail, TargetNullValue='Select a QC result to inspect details.'}" TextWrapping="Wrap" Margin="0,5,0,0" FontFamily="Consolas" FontSize="10"/></ScrollViewer></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="PROGRESS" Style="{StaticResource SectionCaption}"/><ProgressBar x:Name="QcProgress" Height="8" Minimum="0" Maximum="1" Margin="0,8,0,0"/><TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Grid></Border></Grid></Border>
        </Grid>
        <Border Grid.Row="2" Background="#0E1013" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Deep QC fully decodes video to detect stream corruption; fast QC validates metadata and preset conformance." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="OPEN SETTINGS" Click="OpenSettings_Click"/></Grid></Border>
    </Grid>
</Window>
