<Window x:Class="BroadcastPlayout.Views.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Scheduler" Width="1540" Height="900" MinWidth="1200" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-scheduler.ico">
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="180"/><RowDefinition Height="42"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#080D12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="KASHTRIX SCHEDULER" FontSize="20" FontWeight="Bold"/><TextBlock Text="24/7 channel automation" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="+ NEW" Click="Add_Click" Background="#321445" BorderBrush="{StaticResource PinkBrush}"/><Button Content="MEDIA" Click="InsertMedia_Click"/><Button Content="PLAYLIST" Click="InsertPlaylist_Click"/><Button Content="+ STOP" Click="AddStop_Click"/><Button Content="+ PLAY" Click="AddPlay_Click"/><Button Content="+ PAUSE" Click="AddPause_Click"/><Button Content="PREVIEW" Click="PreviewDay_Click"/><Button Content="DEMO" Click="LoadDemo_Click" Style="{StaticResource DemoActionButton}"/><Button Content="CHANNEL SCHEDULE" Click="ChannelSchedule_Click" Background="#321445" BorderBrush="{StaticResource PinkBrush}" ToolTip="Filler slots, programmes, movies, live, news, spot ads and CG ads"/></StackPanel></ScrollViewer><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="AUTO  " Foreground="{StaticResource GoodBrush}" VerticalAlignment="Center"/><Button Content="SAVE" Click="Save_Click"/><Button Content="PUBLISH" Click="Publish_Click" Background="#321445" BorderBrush="{StaticResource PinkBrush}"/><Button Click="Minimize_Click" Style="{StaticResource WindowControlButton}" ToolTip="Minimize"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button><Button Click="Maximize_Click" Style="{StaticResource WindowControlButton}" ToolTip="Maximize / Restore"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button><Button Click="Close_Click" Style="{StaticResource WindowCloseButton}" ToolTip="Close"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button></StackPanel></Grid></Border>

        <Grid Grid.Row="1" Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="SCHEDULE LIBRARY" FontWeight="SemiBold" Margin="5"/><ListBox Grid.Row="1" ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" DisplayMemberPath="Name"/><StackPanel Grid.Row="2"><TextBlock Text="FILTERS" Style="{StaticResource SectionCaption}" Margin="5,8,5,3"/><ComboBox><ComboBoxItem Content="All Events"/><ComboBoxItem Content="Programs"/><ComboBoxItem Content="Live Events"/><ComboBoxItem Content="Filler"/></ComboBox><CheckBox Content="Show filler events" IsChecked="True" Margin="5"/></StackPanel></Grid></Border>

            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="210"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource PanelBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource PanelHeader}"><Grid><TextBlock Text="DAY TIMELINE · 00:00 — 24:00" FontWeight="SemiBold"/><TextBlock Text="Current time" HorizontalAlignment="Right" Foreground="{StaticResource OnAirBrush}"/></Grid></Border><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Schedules}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="205" Height="130" Margin="7" Padding="10" CornerRadius="4" BorderThickness="1" BorderBrush="#61328F" Background="#1D122B"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding EventType}" Foreground="{StaticResource PinkBrush}" Margin="0,5,0,0"/><TextBlock Text="{Binding StartAt, StringFormat=HH:mm:ss}" FontFamily="Digital-7, DSEG7 Classic, Consolas" FontSize="16" Margin="0,9,0,0"/><TextBlock Text="{Binding DurationText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource GoodBrush}" FontSize="9" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
                <Border Grid.Row="2" Style="{StaticResource PanelBorder}"><DataGrid x:Name="ScheduleGrid" ItemsSource="{Binding Schedules}" AllowDrop="True" PreviewMouseLeftButtonDown="ScheduleGrid_PreviewMouseLeftButtonDown" PreviewMouseMove="ScheduleGrid_PreviewMouseMove" Drop="ScheduleGrid_Drop" SelectedItem="{Binding SelectedSchedule, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" CanUserAddRows="False" RowHeight="34"><DataGrid.Columns><DataGridCheckBoxColumn Header="ON" Binding="{Binding Enabled}" Width="45"/><DataGridTextColumn Header="#" Binding="{Binding Id}" Width="80"/><DataGridTextColumn Header="START" Binding="{Binding StartAt, StringFormat=HH:mm:ss}" Width="80"/><DataGridTextColumn Header="TITLE" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="TYPE" Binding="{Binding EventType}" Width="100"/><DataGridTextColumn Header="DURATION" Binding="{Binding DurationText, Mode=OneWay}" Width="95"/><DataGridTextColumn Header="SOURCE" Binding="{Binding SourceLabel}" Width="180"/><DataGridTextColumn Header="REPEAT" Binding="{Binding Repeat}" Width="90"/><DataGridTextColumn Header="MODE" Binding="{Binding StartMode}" Width="90"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status, Mode=OneWay}" Width="85"/></DataGrid.Columns></DataGrid></Border>
            </Grid>

            <Border Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="EVENT EDITOR" FontSize="16" FontWeight="Bold"/><TextBlock Text="Title" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox Text="{Binding SelectedSchedule.Name, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Start" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding SelectedSchedule.StartAt, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=yyyy-MM-dd HH:mm:ss, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Repeat" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><ComboBox ItemsSource="{Binding ScheduleRepeats}" SelectedItem="{Binding SelectedSchedule.Repeat, RelativeSource={RelativeSource AncestorType=Window}}"/><TextBlock Text="Custom days (Monday,Tuesday...)" Style="{StaticResource SectionCaption}" Margin="0,7,0,4"/><TextBox Text="{Binding SelectedSchedule.CustomDaysCsv, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Event / control type" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><ComboBox IsEditable="True" Text="{Binding SelectedSchedule.EventType, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}"><ComboBoxItem Content="Playlist"/><ComboBoxItem Content="Program"/><ComboBoxItem Content="STOP"/><ComboBoxItem Content="PLAY"/><ComboBoxItem Content="NEXT"/><ComboBoxItem Content="PAUSE"/><ComboBoxItem Content="RESUME"/></ComboBox><TextBlock Text="Start mode" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding SelectedSchedule.StartMode, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"><ComboBoxItem Content="Hard Start"/><ComboBoxItem Content="Soft Start"/><ComboBoxItem Content="Follow Mode"/></ComboBox><TextBlock Text="Priority" Style="{StaticResource SectionCaption}" Margin="0,8,0,4"/><TextBox Text="{Binding SelectedSchedule.Priority, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Playlist / media package" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SelectedSchedule.PlaylistPath, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap"/><Button Grid.Column="2" Content="BROWSE..." Click="BrowseMediaOrPlaylist_Click" Padding="8,2" ToolTip="Choose media or playlist file"/></Grid><TextBlock Text="IF NO SCHEDULED PROGRAM" Style="{StaticResource SectionCaption}" Margin="0,14,0,4"/><TextBlock Text="Play filler from configured folder" Foreground="{StaticResource GoodBrush}"/><Button Content="INSERT SELECTED INTO PLAYOUT NOW" Click="InsertIntoPlayout_Click" Margin="0,16,0,0" Background="#321445" BorderBrush="{StaticResource PinkBrush}"/></StackPanel></ScrollViewer></Border>
        </Grid>

        <Grid Grid.Row="2" Margin="10,0,10,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource PanelBorder}" Padding="12"><StackPanel><TextBlock Text="SCHEDULER SUMMARY" FontWeight="SemiBold"/><TextBlock Text="Schedules" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Text="{Binding Schedules.Count}" FontSize="24" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Hard-start and recurring events persist in the local database." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="12"><StackPanel><TextBlock Text="CONFLICTS &amp; WARNINGS" FontWeight="SemiBold"/><TextBlock Text="No blocking conflicts detected by the current validation pass." Foreground="{StaticResource GoodBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/><Button Content="VALIDATE SCHEDULE" Click="Validate_Click" Width="160" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border><Border Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="12"><StackPanel><TextBlock Text="FILLER FOLDER STATUS" FontWeight="SemiBold"/><TextBlock Text="{Binding FillerFolder}" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/><TextBlock Text="When the schedule has a gap, the channel can automatically run filler until the next event." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></Grid>

        <Border Grid.Row="3" Background="#080D12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><Grid Margin="12,0"><TextBlock Text="Scheduler is linked to the same local channel database used by Playout and Playlist Editor." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
</Window>
