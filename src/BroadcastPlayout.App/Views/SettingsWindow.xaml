                    </Grid>
                    <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,14,0,0">
                        <DataGrid ItemsSource="{Binding Categories}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="36" Background="Transparent" Foreground="#D9DEE3" BorderThickness="0" HorizontalGridLinesBrush="#222C38">
