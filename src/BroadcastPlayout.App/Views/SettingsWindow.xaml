                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="CONTROLLER"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="CHANNEL / CG CONTROLLER CONNECTION" FontSize="20" FontWeight="SemiBold"/><Border Style="{StaticResource PanelBorder}" Padding="18" Margin="0,12,0,0"><StackPanel><CheckBox Content="Connect this playout to Channel Controller" IsChecked="{Binding ConnectToController}" Style="{StaticResource ToggleSwitch}"/><TextBlock Text="HOST" Style="{StaticResource SectionCaption}" Margin="0,14,0,4"/><TextBox Text="{Binding ControllerHost, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="PORT" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox Text="{Binding ControllerPort, UpdateSourceTrigger=LostFocus}"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="OPEN CHANNEL CONTROLLER" Click="OpenChannelController_Click"/><Button Content="OPEN CG CONTROLLER" Click="OpenCgController_Click"/><Button Content="OPEN CG DESIGNER" Click="OpenCg_Click"/></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>

                <TabItem Header="PRO I/O / HA"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="PROFESSIONAL I/O / REDUNDANCY" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="ST 2110 · 2022-7 · PTP · NMOS · SCTE/ANC · captions · serial/GPIO/SNMP · licensed Dolby adapter · 1+1 / N+M HA" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    <Border Style="{StaticResource PanelBorder}" Padding="18" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
