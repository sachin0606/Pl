                        </StackPanel>
                    </Grid></Border>
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="VIDEO PROCESSING"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="FINAL OUTPUT VIDEO PROCESSING" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Brightness · contrast · saturation · gamma · hue · exposure · temperature · tint · levels · sharpness · RGB gains. Processing is applied after CG/logo compositing and before every Program output." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/><Border Style="{StaticResource PanelBorder}" Padding="18" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="STATUS" Style="{StaticResource SectionCaption}"/><TextBlock Text="{Binding VideoProcessingStatus}" Foreground="#C99AEA" FontFamily="Consolas" FontSize="15" Margin="0,7,0,0"/><CheckBox Content="Enable final output processing" IsChecked="{Binding EnableVideoProcessing}" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"/></StackPanel><Button Grid.Column="1" Content="OPEN VIDEO PROCESSOR" Click="OpenVideoProcessor_Click" Height="44" VerticalAlignment="Center"/></Grid></Border></StackPanel></ScrollViewer></TabItem>
                <TabItem Header="ABOUT"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="KASHTRIX BROADCAST SUITE" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Separate applications: Playout · Playlist Editor · Scheduler · CG Editor · CG Controller · Multiview · Channel Controller · File Manager · QC Controller · Ingest Server · MAM · Settings · NRCS · Prompter · HA / Redundancy · API Gateway / Web MCR." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="All on-screen clocks use the Digital-7 family when installed, with DSEG7/Consolas fallback." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></ScrollViewer></TabItem>
            </TabControl>
        </Grid>
        <Border Grid.Row="2" Background="#0E1013" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Settings are shared by all Kashtrix applications." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ChannelName}" Foreground="#B792E7" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
    </Border>
