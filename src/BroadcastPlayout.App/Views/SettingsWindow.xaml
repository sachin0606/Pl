                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridCheckBoxColumn Header="AUTO CG" Binding="{Binding EnableAutoCg, Mode=TwoWay}" Width="75"/>
