                        <TextBlock Text="NOW/NEXT EVERY (MIN)" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Settings.Epg.NowNextEveryMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="NOW/NEXT REPEATS BEFORE PROMO" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Settings.Epg.NowNextRepeatsBeforePromo, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
