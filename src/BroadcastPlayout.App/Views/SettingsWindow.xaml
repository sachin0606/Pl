                                                <Border Height="18" Background="{Binding TextColor}" BorderBrush="#59636F" BorderThickness="1" CornerRadius="2"/>
                                                <TextBox Grid.Column="1" Text="{Binding TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
