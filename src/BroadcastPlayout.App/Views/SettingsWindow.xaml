<Window x:Class="BroadcastPlayout.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Settings" Width="1460" Height="880" MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Icon="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-settings.ico">
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Bg0Brush}">
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#101216" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="KASHTRIX SETTINGS" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Channel preset · output · audio · QC · automation" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="SAVE" Click="Save_Click" Background="#251B31" BorderBrush="{StaticResource AccentBrush}"/><Button Click="Minimize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button><Button Click="Maximize_Click" Style="{StaticResource WindowControlButton}"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button><Button Click="Close_Click" Style="{StaticResource WindowCloseButton}"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button></StackPanel></Grid></Border>
        <Grid Grid.Row="1" Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="7"><ListBox x:Name="NavList" SelectedIndex="0" SelectionChanged="NavList_SelectionChanged"><ListBoxItem Content="GENERAL / CHANNEL"/><ListBoxItem Content="CHANNEL PRESET"/><ListBoxItem Content="INPUT SOURCES / I/O"/><ListBoxItem Content="MASTER AUDIO"/><ListBoxItem Content="QC / MEDIA IMPORT"/><ListBoxItem Content="AUTOMATION / FILLER"/><ListBoxItem Content="EPG / AUTO GRAPHICS"/><ListBoxItem Content="CATEGORIES MANAGEMENT"/><ListBoxItem Content="CONTROLLER"/><ListBoxItem Content="PROFESSIONAL I/O / HA"/><ListBoxItem Content="DATABASE / RECOVERY"/><ListBoxItem Content="MAM / INGEST"/><ListBoxItem Content="VIDEO PROCESSING"/><ListBoxItem Content="ABOUT"/></ListBox></Border>
            <TabControl x:Name="SettingsTabs" Grid.Column="2" TabStripPlacement="Top">
                <TabItem Header="GENERAL"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="GENERAL / CHANNEL" FontSize="20" FontWeight="SemiBold"/><Border Style="{StaticResource PanelBorder}" Padding="18" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CHANNEL NAME" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding ChannelName, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,14"/><TextBlock Text="CHANNEL ID" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding ChannelId, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,14"/><TextBlock Text="PLAYOUT PRESET" Style="{StaticResource SectionCaption}"/><ComboBox SelectedValue="{Binding PlayoutPreset, Mode=TwoWay}" SelectedValuePath="Content" Margin="0,5,0,0"><ComboBoxItem Content="2160p50"/><ComboBoxItem Content="2160p25"/><ComboBoxItem Content="1080p59.94"/><ComboBoxItem Content="1080p50"/><ComboBoxItem Content="1080p30"/><ComboBoxItem Content="1080p29.97"/><ComboBoxItem Content="1080p25"/><ComboBoxItem Content="1080p24"/><ComboBoxItem Content="1080p23.976"/><ComboBoxItem Content="1080i59.94"/><ComboBoxItem Content="1080i50"/><ComboBoxItem Content="720p59.94"/><ComboBoxItem Content="720p50"/><ComboBoxItem Content="720p30"/><ComboBoxItem Content="720p25"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="STARTUP / RECOVERY" FontWeight="SemiBold"/><CheckBox Content="Keep engine running when operator UI closes" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding KeepEngineRunningInTray}" Margin="0,14,0,0"/><CheckBox Content="Restore last playlist on startup" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RestoreLastPlaylist}" Margin="0,12,0,0"/><Button Content="RUN FIRST-RUN WIZARD AGAIN" Click="RunWizard_Click" Margin="0,22,0,0"/><Button Content="LOAD DEMO WORKSPACE" Click="LoadDemo_Click" Margin="0,6,0,0"/><Separator Margin="0,18,0,12"/><TextBlock Text="OPERATOR RUNDOWN UI" FontWeight="SemiBold"/><CheckBox Content="Mark played items as Completed" IsChecked="{Binding MarkPlayedItemsCompleted}" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/><CheckBox Content="Dim completed rows" IsChecked="{Binding DimCompletedItems}" Style="{StaticResource ToggleSwitch}" Margin="0,8,0,0"/><CheckBox Content="Auto-remove played items (except looped blocks)" IsChecked="{Binding AutoRemovePlayedItems}" Style="{StaticResource ToggleSwitch}" Margin="0,8,0,0" ToolTip="Automatically remove items after they complete playback. Never removes items belonging to a looping block."/><CheckBox Content="Hide played items in rundown" IsChecked="{Binding HidePlayedItems}" Style="{StaticResource ToggleSwitch}" Margin="0,8,0,0" ToolTip="Hide completed items from playlist display"/><TextBlock Text="PLAYLIST ROW HEIGHT" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><Slider Minimum="22" Maximum="96" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding PlaylistRowHeight, Mode=TwoWay}"/><TextBlock Text="{Binding PlaylistRowHeight, StringFormat='{}{0} px'}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="PLAYLIST FONT SIZE" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><Slider Minimum="8" Maximum="28" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding PlaylistFontSize, Mode=TwoWay}"/><TextBlock Text="{Binding PlaylistFontSize, StringFormat='{}{0:0.0} pt'}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="GLOBAL ROW COLOR (blank = category colors)" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><ComboBox ItemsSource="{Binding PlaylistRowColorOptions}" SelectedItem="{Binding PlaylistDefaultRowColor, Mode=TwoWay}"/><TextBox Text="{Binding PlaylistDefaultRowColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="#AARRGGBB or #RRGGBB · blank uses category colors" Margin="0,4,0,0"/><TextBlock Text="GLOBAL TEXT COLOR" Style="{StaticResource SectionCaption}" Margin="0,8,0,4"/><ComboBox ItemsSource="{Binding PlaylistTextColorOptions}" SelectedItem="{Binding PlaylistDefaultTextColor, Mode=TwoWay}"/><TextBox Text="{Binding PlaylistDefaultTextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="#AARRGGBB or #RRGGBB" Margin="0,4,0,0"/><CheckBox Content="Show playlist thumbnails" IsChecked="{Binding ShowPlaylistThumbnails}" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/><TextBlock Text="DEFAULT DECODER" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding DecoderPreferences}" SelectedItem="{Binding DefaultDecoderPreference}"/><TextBlock Text="Auto/GPU/Hybrid request the best available Windows hardware decoder and fall back to CPU automatically when the codec or graphics driver cannot accelerate the item. CPU mode always uses software decode." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Grid></Border></StackPanel></ScrollViewer></TabItem>

                <TabItem Header="PRESET"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="CHANNEL PRESET" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Export/import the channel name, channel ID, playout format, output profiles, QC policy and virtual-output state as one portable preset." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/><Border Style="{StaticResource PanelBorder}" Padding="18" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ACTIVE CHANNEL" Style="{StaticResource SectionCaption}"/><TextBlock Text="{Binding ChannelName}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding ChannelId}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding PlayoutPreset}" Foreground="#B792E7" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="IMPORT PRESET…" Click="ImportPreset_Click" Height="42" VerticalAlignment="Center"/><Button Grid.Column="2" Content="EXPORT PRESET…" Click="ExportPreset_Click" Height="42" VerticalAlignment="Center"/></Grid></Border></StackPanel></ScrollViewer></TabItem>

                <TabItem Header="INPUT SOURCES / I/O">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#181122" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="KASHTRIX OUTPUT ENGINE" FontWeight="Bold" FontSize="13" Foreground="#B78BE7"/>
                                        <Border Background="#2C1A3F" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="CENTRALIZED BROADCAST OUTPUT MATRIX" FontSize="9" FontWeight="SemiBold" Foreground="#D7B8F9"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="DeckLink SDI/HDMI cards, NDI, RTMP, SRT, HLS, UDP and virtual multichannel outputs are managed directly in Kashtrix Output Engine." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="LAUNCH OUTPUT ENGINE" Click="LaunchOutputEngine_Click" Height="34" Padding="16,0" Background="#3E2359" BorderBrush="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="INPUT SOURCES" FontSize="18" FontWeight="SemiBold"/>
                                        <Button Grid.Column="1" Content="CONFIGURE / PREVIEW INPUTS" Click="OpenInputs_Click" Height="30" Padding="12,0"/>
                                    </Grid>
                                    <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,10,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Capture cards, DirectShow devices, desktop capture, RTSP, RTMP, HLS, SRT, UDP, HTTP and custom network/media inputs are configured from the Input Source dialog." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <Border Background="#10131A" BorderBrush="#222A36" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="Supported Playout Ingest &amp; Live Sources:" FontWeight="SemiBold" FontSize="11" Foreground="#D9DEE3" Margin="0,0,0,6"/>
                                                    <TextBlock Text="• Blackmagic Design DeckLink / UltraStudio SDI &amp; HDMI Capture" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,2"/>
                                                    <TextBlock Text="• DirectShow Video &amp; Audio Capture Hardware (USB, PCIe)" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,2"/>
                                                    <TextBlock Text="• Low-Latency SRT Caller / Listener / Rendezvous Feeds" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,2"/>
                                                    <TextBlock Text="• UDP / RTP Multicast &amp; Unicast TS Broadcast Streams" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,2"/>
                                                    <TextBlock Text="• RTSP Security &amp; Studio IP Cameras (TCP / UDP)" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,2"/>
                                                    <TextBlock Text="• RTMP / HLS Live Streams &amp; Network Streams" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,2"/>
                                                    <TextBlock Text="• Windows Desktop / Display Area Capture" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,2"/>
                                                </StackPanel>
                                            </Border>
                                            <Button Content="OPEN INPUT SOURCES MANAGER" Click="OpenInputs_Click" Height="36" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer Grid.Column="2">
                                <StackPanel>
                                    <TextBlock Text="OUTPUT ROUTING" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="All hardware and network destinations are configured in Kashtrix Output Engine. This Settings app only manages input sources and local confidence display." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="PLAYOUT PROGRAM and CG PROGRAM are separate source buses." FontWeight="SemiBold" Foreground="#D7B8F9" TextWrapping="Wrap"/>
                                            <TextBlock Text="Open Output Engine to select a source bus, then route it to DeckLink, NDI, SRT, RTMP, UDP, HLS, or another destination." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,10"/>
                                            <Button Content="OPEN OUTPUT ENGINE" Click="LaunchOutputEngine_Click" Height="34"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="PLAYOUT ENGINE OUTPUTS (LIVE)" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                    <TextBlock Text="These switches drive the Playout process's own SDI and NDI senders directly." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="DECKLINK / SDI" FontWeight="SemiBold"/><CheckBox Grid.Column="1" Content="ENABLE" IsChecked="{Binding DeckLinkEnabled, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}"/></Grid>
                                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding OutputPresets}" SelectedItem="{Binding DeckLinkProfile.Preset}" ToolTip="Output raster"/><ComboBox Grid.Column="2" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding DeckLinkProfile.FramesPerSecond}" ToolTip="Frame rate"/></Grid>
                                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="SCAN / FIELD ORDER" Style="{StaticResource SectionCaption}" VerticalAlignment="Center"/><ComboBox Grid.Column="2" ItemsSource="{Binding ScanModes}" SelectedItem="{Binding DeckLinkProfile.ScanMode}"/></Grid>
                                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><TextBlock Text="DECKLINK CARD" Style="{StaticResource SectionCaption}" VerticalAlignment="Center"/><ComboBox Grid.Column="2" ItemsSource="{Binding DeckLinkDevices}" DisplayMemberPath="Label" SelectedValuePath="Index" SelectedValue="{Binding DeckLinkDeviceIndex, Mode=TwoWay}" ToolTip="Hardware card/port name discovered from Blackmagic Desktop Video"/><Button Grid.Column="4" Content="REFRESH" Click="RefreshDeckLinkDevices_Click" Padding="7,4"/></Grid>
                                            <TextBlock Text="{Binding DeckLinkBuildStatus, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="NDI PROGRAM" FontWeight="SemiBold"/><CheckBox Grid.Column="1" Content="ENABLE" IsChecked="{Binding NdiEnabled, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}"/></Grid>
                                            <TextBox Text="{Binding NdiName}" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding NdiStatus, Mode=OneWay, StringFormat='STATUS · {0}'}" Foreground="{StaticResource GoodBrush}" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding NdiDiagnosticsText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="9" Margin="0,4,0,0"/>
                                            <Button Content="REFRESH NDI DIAGNOSTICS" Click="RefreshOutputDiagnostics_Click" HorizontalAlignment="Left" Margin="0,7,0,0"/>
                                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding OutputPresets}" SelectedItem="{Binding NdiProfile.Preset}"/><ComboBox Grid.Column="2" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding NdiProfile.FramesPerSecond}"/></Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource PanelBorder}" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="FULLSCREEN DISPLAY" FontWeight="SemiBold"/>
                                            <ComboBox ItemsSource="{Binding Displays}" DisplayMemberPath="Label" SelectedValuePath="Index" SelectedValue="{Binding FullscreenMonitorIndex}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="AUDIO"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="AUDIO ROUTING / MASTER" FontSize="20" FontWeight="SemiBold"/><Border Style="{StaticResource PanelBorder}" Padding="18" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PROGRAM AUDIO DEVICE" Style="{StaticResource SectionCaption}"/><ComboBox ItemsSource="{Binding AudioDevices}" DisplayMemberPath="Label" SelectedValuePath="DeviceNumber" SelectedValue="{Binding ProgramAudioDeviceNumber, Mode=TwoWay}" Margin="0,5,0,14"/><TextBlock Text="PREVIEW / AUDITION AUDIO DEVICE" Style="{StaticResource SectionCaption}"/><ComboBox ItemsSource="{Binding AudioDevices}" DisplayMemberPath="Label" SelectedValuePath="DeviceNumber" SelectedValue="{Binding PreviewAudioDeviceNumber, Mode=TwoWay}" Margin="0,5,0,14"/><CheckBox Content="Enable local program audio" IsChecked="{Binding LocalAudioEnabled}" Style="{StaticResource ToggleSwitch}"/><CheckBox Content="Enable master output volume processing" IsChecked="{Binding EnableMasterOutputVolume}" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/><TextBlock Text="MASTER LEVEL" Style="{StaticResource SectionCaption}" Margin="0,14,0,5"/><Slider Minimum="0" Maximum="200" Value="{Binding MasterOutputVolumePercent, Mode=TwoWay}"/><TextBlock Text="{Binding MasterOutputVolumeText}" Style="{StaticResource DigitalClockText}" FontSize="28" Foreground="#B792E7"/><CheckBox Content="MASTER MUTE" IsChecked="{Binding MasterOutputMuted}" Style="{StaticResource ToggleSwitch}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="KEYBOARD SHORTCUTS" FontWeight="SemiBold"/><TextBlock Text="Mute / unmute" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox Text="{Binding MasterMuteShortcut, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Volume up (+5%)" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox Text="{Binding MasterVolumeUpShortcut, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Volume down (-5%)" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox Text="{Binding MasterVolumeDownShortcut, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Program and Preview can use different Windows audio hardware. Preview AUDITION never changes Program routing." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Grid></Border></StackPanel></ScrollViewer></TabItem>

                <TabItem Header="QC"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="QC / MEDIA IMPORT POLICY" FontSize="20" FontWeight="SemiBold"/><Border Style="{StaticResource PanelBorder}" Padding="18" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><CheckBox Content="Run QC automatically when media is imported" IsChecked="{Binding EnableQcOnImport}" Style="{StaticResource ToggleSwitch}"/><TextBlock Text="QC PRESET NAME" Style="{StaticResource SectionCaption}" Margin="0,16,0,4"/><TextBox Text="{Binding QcPreset.Name}"/><TextBlock Text="ALLOWED VIDEO CODECS" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox Text="{Binding QcPreset.AllowedVideoCodecs}"/><CheckBox Content="Require audio" IsChecked="{Binding QcPreset.RequireAudio}" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"/><CheckBox Content="Require exact raster" IsChecked="{Binding QcPreset.RequireExactRaster}" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/></StackPanel><Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="WIDTH" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding QcPreset.Width}" Margin="0,4,0,12"/><TextBlock Text="MIN FPS" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding QcPreset.MinimumFrameRate}" Margin="0,4,0,12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="HEIGHT" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding QcPreset.Height}" Margin="0,4,0,12"/><TextBlock Text="MAX FPS" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding QcPreset.MaximumFrameRate}" Margin="0,4,0,12"/></StackPanel></Grid></Grid></Border><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="OPEN QC CONTROLLER" Click="OpenQc_Click" Width="190"/><Button Content="OPEN FILE MANAGER" Click="OpenFileManager_Click" Width="190"/></StackPanel></StackPanel></ScrollViewer></TabItem>

                <TabItem Header="AUTOMATION"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="AUTOMATION / FILLER / AUTO CG" FontSize="20" FontWeight="SemiBold"/><Border Style="{StaticResource PanelBorder}" Padding="18" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><CheckBox Content="Enable filler when channel is idle" IsChecked="{Binding FillerEnabled}" Style="{StaticResource ToggleSwitch}"/><TextBlock Text="FILLER FOLDER" Style="{StaticResource SectionCaption}" Margin="0,14,0,4"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox Text="{Binding FillerFolder, UpdateSourceTrigger=LostFocus}"/><Button Grid.Column="1" Content="BROWSE" Click="BrowseFiller_Click"/></Grid><Button Content="OPEN SCHEDULER" Click="OpenScheduler_Click" HorizontalAlignment="Left" Width="170" Margin="0,16,0,0"/><Button Content="EPG / AUTO GRAPHICS OUTPUT" Click="OpenEpgSettings_Click" HorizontalAlignment="Left" Width="220" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="2"><CheckBox Content="Enable category-aware automatic CG" IsChecked="{Binding EnableAutoCg}" Style="{StaticResource ToggleSwitch}"/><TextBlock Text="PROGRAM NOW PLAYING DELAY (SEC)" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox Text="{Binding ProgramNowPlayingDelaySeconds, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="PROGRAM COMING UP BEFORE END (SEC)" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding ProgramComingUpBeforeEndSeconds, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="MUSIC NOW PLAYING DELAY (SEC)" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding MusicNowPlayingDelaySeconds, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="MUSIC COMING UP BEFORE END (SEC)" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding MusicComingUpBeforeEndSeconds, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="NEWS NOW PLAYING DELAY (SEC)" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding NewsNowPlayingDelaySeconds, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="NEWS COMING UP BEFORE END (SEC)" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding NewsComingUpBeforeEndSeconds, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="AUTO GRAPHIC ON-AIR HOLD (SEC)" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding AutoCgHoldSeconds, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Music filename format: Song Name - Artist Name - Extra" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel></Grid></Border></StackPanel></ScrollViewer></TabItem>

                <TabItem Header="EPG / GRAPHICS"><ScrollViewer><StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Kashtrix.Playout;component/Branding/kashtrix-epg.png" Width="40" Height="40" Margin="0,0,12,0"/><StackPanel><TextBlock Text="EPG OUTPUT / AUTO GRAPHICS" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Channel XMLTV metadata, Now/Next and title-template policy" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel>
                    <Border Style="{StaticResource PanelBorder}" Padding="18" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="EPG HEADER" FontWeight="SemiBold"/><TextBlock Text="PROVIDER NAME" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><TextBox Text="{Binding Settings.Epg.ProviderInfoName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="PROVIDER URL" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Settings.Epg.ProviderInfoUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="TIME FORMAT" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><ComboBox SelectedValue="{Binding Settings.Epg.TimeFormat, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="XMLTV UTC Offset"/><ComboBoxItem Content="UTC Z"/><ComboBoxItem Content="Local Compact"/><ComboBoxItem Content="Human Readable"/></ComboBox>
                        <TextBlock Text="PROGRAMME KEY ORDER" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><ComboBox SelectedValue="{Binding Settings.Epg.ProgrammeKeyOrder, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Time - Channel"/><ComboBoxItem Content="Channel - Time"/></ComboBox>
                        <CheckBox Content="Display language attribute" IsChecked="{Binding Settings.Epg.DisplayLanguageAttribute, Mode=TwoWay}" Margin="0,10,0,0"/><TextBox Text="{Binding Settings.Epg.Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Two-letter language code" Margin="0,5,0,0"/>
