                        <TextBlock Text="VIDEO A DESTINATION" Style="{StaticResource SectionCaption}" Margin="0,14,0,4"/><TextBox Text="{Binding Settings.ProfessionalBroadcast.St2110VideoDestinationA, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="VIDEO B DESTINATION" Style="{StaticResource SectionCaption}" Margin="0,8,0,4"/><TextBox Text="{Binding Settings.ProfessionalBroadcast.St2110VideoDestinationB, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="NMOS HTTP PORT" Style="{StaticResource SectionCaption}" Margin="0,8,0,4"/><TextBox Text="{Binding Settings.ProfessionalBroadcast.NmosHttpPort, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        <Separator Margin="0,14"/><TextBlock Text="DEVICE / CONTROL" FontWeight="SemiBold"/><CheckBox Content="GPIO" IsChecked="{Binding Settings.ProfessionalBroadcast.EnableGpio, Mode=TwoWay}"/><TextBox Text="{Binding Settings.ProfessionalBroadcast.GpioComPort, Mode=TwoWay}" ToolTip="GPIO COM port" Margin="0,4,0,7"/><CheckBox Content="RS-422" IsChecked="{Binding Settings.ProfessionalBroadcast.EnableRs422, Mode=TwoWay}"/><TextBox Text="{Binding Settings.ProfessionalBroadcast.Rs422ComPort, Mode=TwoWay}" ToolTip="RS-422 COM port" Margin="0,4,0,7"/><CheckBox Content="VDCP" IsChecked="{Binding Settings.ProfessionalBroadcast.EnableVdcp, Mode=TwoWay}"/><CheckBox Content="SNMP v2c" IsChecked="{Binding Settings.ProfessionalBroadcast.EnableSnmp, Mode=TwoWay}" Margin="0,7,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="1+1 / N+M HIGH AVAILABILITY" FontWeight="SemiBold"/><CheckBox Content="Output manually armed" IsChecked="{Binding ProfessionalOutputArmed, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/><CheckBox Content="Use HA coordinator" IsChecked="{Binding Settings.ProfessionalBroadcast.HaUseCoordinator, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" Margin="0,8,0,0"/><TextBlock Text="NODE MODE" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><ComboBox SelectedValue="{Binding Settings.ProfessionalBroadcast.HaMode, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Standalone"/><ComboBoxItem Content="Primary"/><ComboBoxItem Content="Backup"/><ComboBoxItem Content="Pool"/></ComboBox><TextBlock Text="NODE ID" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Settings.ProfessionalBroadcast.HaNodeId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="PRIORITY" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Settings.ProfessionalBroadcast.HaPriority, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="N+M CAPACITY" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Settings.ProfessionalBroadcast.HaCapacity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="HA MULTICAST" Style="{StaticResource SectionCaption}" Margin="0,10,0,4"/><TextBox Text="{Binding Settings.ProfessionalBroadcast.HaMulticastAddress, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HEARTBEAT PORT" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Settings.ProfessionalBroadcast.HaHeartbeatPort, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CONTROL PORT" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Settings.ProfessionalBroadcast.HaControlPort, Mode=TwoWay}"/></StackPanel></Grid><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HEARTBEAT MS" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Settings.ProfessionalBroadcast.HaHeartbeatMilliseconds, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="FAILOVER MS" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Settings.ProfessionalBroadcast.HaFailoverMilliseconds, Mode=TwoWay}"/></StackPanel></Grid><TextBlock Text="DOLBY MODE" Style="{StaticResource SectionCaption}" Margin="0,12,0,4"/><ComboBox SelectedValue="{Binding Settings.ProfessionalBroadcast.DolbyMode, Mode=TwoWay}" SelectedValuePath="Content"><ComboBoxItem Content="Off"/><ComboBoxItem Content="Passthrough"/><ComboBoxItem Content="LicensedAdapter"/></ComboBox><TextBlock Text="LicensedAdapter requires a separately licensed adapter. Kashtrix never reports a codec as available when the adapter is missing." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="OPEN HA CONTROLLER" Click="OpenHaController_Click"/><Button Content="OPEN API GATEWAY" Click="OpenApiGateway_Click"/><Button Content="OPEN NRCS" Click="OpenNrcs_Click"/><Button Content="OPEN PROMPTER" Click="OpenPrompter_Click"/></StackPanel></StackPanel>
                    </Grid></Border></StackPanel></ScrollViewer></TabItem>

                <TabItem Header="DATABASE"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="DATABASE / RECOVERY" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding DatabasePathText}" Foreground="#B792E7" Margin="0,12,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding DatabaseStatus}" Foreground="{StaticResource GoodBrush}" Margin="0,7,0,0"/><Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="CACHE / CLEAN START" FontWeight="SemiBold"/><TextBlock Text="Clear CG browser cache and generated thumbnails on the next launch, or reset local configuration/database and force the setup wizard again. Build binaries are preserved." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/><StackPanel Orientation="Horizontal"><Button Content="OPEN AUDIT LOG" Click="OpenAuditLog_Click" BorderBrush="{StaticResource PinkBrush}"/><Button Content="EXPORT AS-RUN CSV" Click="ExportAsRun_Click" BorderBrush="{StaticResource GoodBrush}"/><Button Content="USER / API MANAGEMENT" Click="OpenUserManagement_Click" BorderBrush="{StaticResource AccentBrush}"/><Button Content="CLEAR CACHE ON RESTART" Click="ClearCache_Click"/><Button Content="FACTORY RESET + SETUP WIZARD" Click="FactoryReset_Click" BorderBrush="#A34A58"/></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
                <TabItem Header="MAM / INGEST"><ScrollViewer><StackPanel Margin="16">
                    <TextBlock Text="ENTERPRISE MAM / INGEST" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Shared asset database, proxy/archive policy, post-ingest verification/QC, replication and low-disk protection. Empty paths use Kashtrix defaults." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Border Style="{StaticResource PanelBorder}" Padding="18" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MAM DATABASE (.DB)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Settings.MamDatabasePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,9" ToolTip="Blank = %LocalAppData%\KashtrixPlayout\mam.db"/>
                            <TextBlock Text="PROXY ROOT" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Settings.MamProxyRoot, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,9"/>
                            <TextBlock Text="ARCHIVE ROOT" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Settings.MamArchiveRoot, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,9"/>
                            <CheckBox Content="SHA-256 verify completed ingest automatically" IsChecked="{Binding Settings.MamAutoVerifyIngest, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" Margin="0,7,0,0"/>
                            <CheckBox Content="Run QC on completed ingest automatically" IsChecked="{Binding Settings.MamAutoQcIngest, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" Margin="0,9,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="INGEST REPLICATION ROOT" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Settings.IngestReplicationFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,9" ToolTip="Blank disables replication. Completed master/proxy files are copied into a date folder."/>
                            <TextBlock Text="EMERGENCY FREE SPACE (GB)" Style="{StaticResource SectionCaption}"/><TextBox Text="{Binding Settings.IngestMinimumFreeSpaceGb, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,9"/>
                            <TextBlock Text="The Ingest Server has persistent scheduled start/stop, compliance segmentation, simultaneous master+proxy and fragmented growing-file modes. On completion it can register, verify, QC and replicate automatically." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/>
