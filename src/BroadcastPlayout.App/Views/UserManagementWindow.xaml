<Window x:Class="BroadcastPlayout.Views.UserManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kashtrix User Management" Width="1180" Height="760" WindowStartupLocation="CenterOwner" Background="{StaticResource Bg0Brush}">
<Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="USER / API ACCESS MANAGEMENT" FontSize="22" FontWeight="Bold" Foreground="#E6C4FF"/>
<TabControl Grid.Row="1" Margin="0,12,0,0"><TabItem Header="USERS"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="UsersGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="*"/><DataGridTextColumn Header="DISPLAY" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="110"/><DataGridCheckBoxColumn Header="ENABLED" Binding="{Binding Enabled}" Width="80"/><DataGridTextColumn Header="LAST LOGIN" Binding="{Binding LastLoginUtc}" Width="170"/></DataGrid.Columns></DataGrid><StackPanel Grid.Column="2"><TextBlock Text="CREATE / UPDATE USER" FontWeight="Bold"/><TextBlock Text="Username" Margin="0,10,0,3"/><TextBox x:Name="UsernameBox"/><TextBlock Text="Display name" Margin="0,8,0,3"/><TextBox x:Name="DisplayNameBox"/><TextBlock Text="Role" Margin="0,8,0,3"/><ComboBox x:Name="RoleBox" SelectedIndex="1"><ComboBoxItem Content="ADMIN"/><ComboBoxItem Content="OPERATOR"/><ComboBoxItem Content="JOURNALIST"/><ComboBoxItem Content="VIEWER"/></ComboBox><TextBlock Text="ADMIN · full system / users / API   OPERATOR · playout + CG + newsroom   JOURNALIST · NRCS + CG read   VIEWER · read-only monitoring" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/><CheckBox x:Name="EnabledCheck" Content="Enabled" IsChecked="True" Margin="0,10,0,0"/><TextBlock Text="New/reset password" Margin="0,8,0,3"/><PasswordBox x:Name="PasswordBox"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="CREATE" Click="CreateUser_Click"/><Button Content="SAVE ROLE/STATE" Click="SaveUser_Click"/><Button Content="RESET PASSWORD" Click="ResetPassword_Click"/></StackPanel><TextBlock Text="Passwords are stored as salted PBKDF2-SHA256 hashes, never plaintext or reversible encrypted passwords." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Grid></TabItem>
<TabItem Header="API USERS / TOKENS"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><DataGrid x:Name="ApiGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="USER" Binding="{Binding Username}" Width="130"/><DataGridTextColumn Header="SCOPES" Binding="{Binding Scopes}" Width="2*"/><DataGridCheckBoxColumn Header="ENABLED" Binding="{Binding Enabled}" Width="80"/><DataGridTextColumn Header="LAST USED" Binding="{Binding LastUsedUtc}" Width="170"/></DataGrid.Columns></DataGrid><StackPanel Grid.Column="2"><TextBlock Text="CREATE API TOKEN" FontWeight="Bold"/><TextBlock Text="Client name" Margin="0,10,0,3"/><TextBox x:Name="ApiNameBox" Text="Automation Client"/><TextBlock Text="Username / owner" Margin="0,8,0,3"/><TextBox x:Name="ApiUserBox" Text="api"/><TextBlock Text="Scopes (comma separated)" Margin="0,8,0,3"/><TextBox x:Name="ScopesBox" Text="playout:read,playout:write,cg:read,cg:write,mam:read,mam:write,nrcs:read,nrcs:write,prompter:read,ha:read,mcp:access" TextWrapping="Wrap" AcceptsReturn="True" Height="90"/><Button Content="CREATE TOKEN" Click="CreateApi_Click" Margin="0,12,0,0"/><Button Content="REVOKE SELECTED" Click="RevokeApi_Click"/><TextBlock x:Name="TokenText" TextWrapping="Wrap" Foreground="#B8F5C8" Margin="0,12,0,0"/><TextBlock Text="Token is shown once. Only its SHA-256 hash is stored in security.db." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Grid></TabItem></TabControl></Grid></Window>
