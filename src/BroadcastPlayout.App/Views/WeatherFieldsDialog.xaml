<Window x:Class="BroadcastPlayout.Views.WeatherFieldsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WEATHER FIELDS"
        Width="380" Height="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="WeatherCheckStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#B78BE7"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DayRadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource Bg0Brush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- Custom Chrome Header Bar -->
            <Border Grid.Row="0" Background="#181122" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="WEATHER FIELDS" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✕" Width="28" Height="24" Click="Close_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Two Columns for Weather Fields -->
            <Grid Grid.Row="1" Margin="24,18,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0">
                    <CheckBox x:Name="TemperatureCheck" Content="Temperature" IsChecked="True" Style="{StaticResource WeatherCheckStyle}"/>
                    <CheckBox x:Name="TempMinCheck" Content="Temp Min" Style="{StaticResource WeatherCheckStyle}"/>
                    <CheckBox x:Name="TempMaxCheck" Content="Temp Max" Style="{StaticResource WeatherCheckStyle}"/>
                    <CheckBox x:Name="FeelsLikeCheck" Content="Feels Like" Style="{StaticResource WeatherCheckStyle}"/>
                    <CheckBox x:Name="WindSpeedCheck" Content="Wind Speed" Style="{StaticResource WeatherCheckStyle}"/>
                    <CheckBox x:Name="CityNameCheck" Content="City Name" Style="{StaticResource WeatherCheckStyle}"/>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <CheckBox x:Name="ConditionCheck" Content="Condition" IsChecked="True" Style="{StaticResource WeatherCheckStyle}"/>
                    <CheckBox x:Name="PressureCheck" Content="Pressure" Style="{StaticResource WeatherCheckStyle}"/>
                    <CheckBox x:Name="HumidityCheck" Content="Humidity" Style="{StaticResource WeatherCheckStyle}"/>
                    <CheckBox x:Name="CloudsCheck" Content="Clouds (%)" Style="{StaticResource WeatherCheckStyle}"/>
                    <CheckBox x:Name="WeatherImageCheck" Content="Weather Image" Style="{StaticResource WeatherCheckStyle}"/>
                    <CheckBox x:Name="DateCheck" Content="Date" Style="{StaticResource WeatherCheckStyle}"/>
                    <CheckBox x:Name="DayCheck" Content="Day" Style="{StaticResource WeatherCheckStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Multi-Day Section matching attachment -->
            <StackPanel Grid.Row="2" Margin="24,0,24,14">
                <CheckBox x:Name="MultiDayCheck" Content="Add Multiple Days Weather Single City" IsChecked="True"
                          Style="{StaticResource WeatherCheckStyle}" Margin="0,0,0,10"/>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,2,0,0">
                    <RadioButton x:Name="Days2Radio" Content="2" GroupName="WeatherDays" Style="{StaticResource DayRadioStyle}"/>
                    <RadioButton x:Name="Days3Radio" Content="3" GroupName="WeatherDays" IsChecked="True" Style="{StaticResource DayRadioStyle}"/>
                    <RadioButton x:Name="Days4Radio" Content="4" GroupName="WeatherDays" Style="{StaticResource DayRadioStyle}"/>
                    <RadioButton x:Name="Days5Radio" Content="5" GroupName="WeatherDays" Style="{StaticResource DayRadioStyle}"/>
                    <TextBlock Text="days" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="-6,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Bottom Action Bar with SELECT ALL and APPLY -->
            <Border Grid.Row="3" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="APPLY &amp; SAVE" Click="Apply_Click" Width="120" Height="30" HorizontalAlignment="Left"
                            Background="#3E2359" BorderBrush="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Cursor="Hand"/>

                    <Button Grid.Column="1" Content="SELECT ALL" Click="SelectAll_Click" Width="110" Height="30"
                            Background="#251B31" BorderBrush="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
