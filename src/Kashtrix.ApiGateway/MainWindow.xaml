<Window x:Class="Kashtrix.ApiGateway.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kashtrix API Gateway / Web MCR" Width="1320" Height="800" MinWidth="980" MinHeight="620" Background="{StaticResource Bg0Brush}" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
<Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource PanelBorder}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="KASHTRIX API GATEWAY / WEB MCR" FontSize="22" FontWeight="Bold" Foreground="#E6C4FF"/><TextBlock Text="REST · realtime WebSocket · TCP JSONL · UDP · MCP · common command bus" Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="START" Click="Start_Click"/><Button Content="STOP" Click="Stop_Click" Margin="8,0,0,0"/><Button Content="OPEN WEB MCR" Click="OpenWeb_Click" Margin="8,0,0,0"/></StackPanel></Grid></Border>
<Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="12" Margin="0,12"><UniformGrid Columns="4"><StackPanel><TextBlock Text="REST / WEBSOCKET"/><TextBlock x:Name="HttpText" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="TCP JSONL"/><TextBlock x:Name="TcpText" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="UDP"/><TextBlock x:Name="UdpText" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="MCP"/><TextBlock x:Name="McpText" FontWeight="Bold"/></StackPanel></UniformGrid></Border>
<Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Top" Text="GATEWAY EVENT LOG" FontWeight="Bold" Margin="4"/><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="Wrap"/></DockPanel></Border></Grid></Window>
