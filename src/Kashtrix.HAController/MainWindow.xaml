<Window x:Class="Kashtrix.HAController.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kashtrix HA Controller" Width="1500" Height="850" MinWidth="1100" MinHeight="650" Background="{StaticResource Bg0Brush}" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
<Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Style="{StaticResource PanelBorder}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="KASHTRIX REDUNDANCY / HA CONTROLLER" FontSize="22" FontWeight="Bold" Foreground="#E6C4FF"/><TextBlock Text="1+1 hot standby · N+M shared backup coordinator · output interlock · warm state synchronization" Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="CoordinatorCheck" Content="AUTO N+M COORDINATOR" IsChecked="True" Click="CoordinatorCheck_Click"/><Button Content="REFRESH" Margin="12,0,0,0" Click="Refresh_Click"/></StackPanel></Grid></Border>
<Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,12"><DataGrid x:Name="NodeGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="CHANNEL" Binding="{Binding ChannelId}" Width="170"/><DataGridTextColumn Header="NODE" Binding="{Binding NodeId}" Width="200"/><DataGridTextColumn Header="MODE" Binding="{Binding ConfiguredMode}" Width="100"/><DataGridTextColumn Header="ROLE" Binding="{Binding RuntimeRole}" Width="100"/><DataGridTextColumn Header="PRIORITY" Binding="{Binding Priority}" Width="90"/><DataGridTextColumn Header="CAPACITY" Binding="{Binding Capacity}" Width="90"/><DataGridCheckBoxColumn Header="OUTPUT" Binding="{Binding OutputArmed}" Width="80"/><DataGridTextColumn Header="ITEM" Binding="{Binding CurrentItemId}" Width="*"/><DataGridTextColumn Header="POSITION" Binding="{Binding PositionSeconds}" Width="100"/><DataGridTextColumn Header="LAST SEEN" Binding="{Binding SeenUtc,StringFormat=HH:mm:ss.fff}" Width="130"/></DataGrid.Columns></DataGrid></Border>
<Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Listening for HA heartbeats..." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="FORCE SELECTED ACTIVE" Click="ForceActive_Click"/><Button Content="RELEASE CHANNEL TO AUTO" Margin="8,0,0,0" Click="Release_Click"/><Button Content="INHIBIT SELECTED OUTPUT" Margin="8,0,0,0" Click="Inhibit_Click"/><Button Content="ARM SELECTED OUTPUT" Margin="8,0,0,0" Click="Arm_Click"/></StackPanel></Grid></Border>
</Grid></Window>
