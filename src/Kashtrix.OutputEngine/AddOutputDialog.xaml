<Window x:Class="Kashtrix.OutputEngine.AddOutputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Master Broadcast Output Destination"
        Width="540" Height="650"
        WindowStartupLocation="CenterOwner"
        Icon="/Branding/kashtrix-outputengine.ico"
        Background="{DynamicResource Bg0Brush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Border Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0,4,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="/Branding/kashtrix-outputengine.png" Width="26" Height="26" Margin="0,0,9,0" Stretch="Uniform"/>
                <TextBlock Grid.Column="1" Text="KASHTRIX OUTPUT ENGINE  •  ADD OUTPUT" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Click="Cancel_Click" Style="{StaticResource WindowCloseButton}" ToolTip="Close"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button>
            </Grid>
        </Border>
    <Grid Grid.Row="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="NEW BROADCAST OUTPUT STREAM / HARDWARE" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Provision DeckLink, NDI, Matrox, AJA, DVB-TS UDP, SRT, RTMP, HLS or MPD" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,0">
                <!-- Name -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Channel / Feed Name:" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="NameTextBox" Background="{DynamicResource Bg1Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineStrongBrush}" Padding="6" Text="AUX-Output-Stream"/>
                </StackPanel>

                <!-- Protocol -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Output Type / Protocol:" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ProtocolComboBox" Background="{DynamicResource Bg1Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineStrongBrush}" Padding="6" SelectionChanged="ProtocolComboBox_SelectionChanged">
                        <ComboBoxItem Content="Blackmagic DeckLink (SDI / HDMI)" Tag="DeckLink" IsSelected="True"/>
                        <ComboBoxItem Content="Virtual DirectShow Output (Kashtrix Virtual Camera / .ax)" Tag="VirtualOutput"/>
                        <ComboBoxItem Content="NDI Network Video (NDI HX / Full)" Tag="NDI"/>
                        <ComboBoxItem Content="Matrox DSX Video Hardware" Tag="Matrox"/>
                        <ComboBoxItem Content="AJA Kona / Corvid SDI" Tag="AJA"/>
                        <ComboBoxItem Content="DVB-TS UDP Multicast (DVB-C/S2/T2 Compliant)" Tag="UDP_DVB"/>
                        <ComboBoxItem Content="UDP Unicast (IP Transport)" Tag="UDP_UNICAST"/>
                        <ComboBoxItem Content="SRT Secure Reliable Transport (Caller/Listener)" Tag="SRT"/>
                        <ComboBoxItem Content="RTMP → YouTube Live" Tag="RTMP_YouTube"/>
                        <ComboBoxItem Content="RTMP → Facebook Live" Tag="RTMP_Facebook"/>
                        <ComboBoxItem Content="RTMP → Twitch Live" Tag="RTMP_Twitch"/>
                        <ComboBoxItem Content="RTMP → TikTok Live" Tag="RTMP_TikTok"/>
                        <ComboBoxItem Content="RTMP Custom CDN / Server" Tag="RTMP"/>
                        <ComboBoxItem Content="DVB-Compliant HLS OTT Stream" Tag="HLS"/>
                        <ComboBoxItem Content="MPEG-DASH / MPD Broadcast Profile" Tag="MPD"/>
                        <ComboBoxItem Content="RTSP Surveillance / Master Ingest" Tag="RTSP"/>
                    </ComboBox>
                </StackPanel>

                <!-- The bus being routed is independent from the destination protocol. -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Input Source / Program Bus:" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="InputSourceComboBox" Background="{DynamicResource Bg1Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineStrongBrush}" Padding="6" SelectionChanged="InputSourceComboBox_SelectionChanged">
                        <ComboBoxItem Content="Playout Program Bus (Default)" Tag="PlayoutProgram" IsSelected="True"/>
                        <ComboBoxItem Content="CG Controller Program Bus (Alpha / Fill + Key)" Tag="CgProgram"/>
                        <ComboBoxItem Content="Manual Input Source..." Tag="Manual"/>
                    </ComboBox>
                    <TextBox x:Name="ManualInputSourceTextBox" Visibility="Collapsed" Margin="0,6,0,0" Background="{DynamicResource Bg1Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineStrongBrush}" Padding="6" ToolTip="NDI source name, capture-device name, URL, or shared source identifier"/>
                    <TextBlock Text="Choose content here; choose DeckLink, NDI, SRT, RTMP, etc. separately as the output type." Foreground="{DynamicResource MutedBrush}" FontSize="9.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Destination / Device URI -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock x:Name="DestinationLabel" Text="Destination Device / URL / Multicast IP:" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="DestinationTextBox" Background="{DynamicResource Bg1Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineStrongBrush}" Padding="6" Text="DeckLink Duo (2) [Subdevice 1]"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Resolution -->
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="ResolutionLabel" Text="Format / Resolution:" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ResolutionComboBox" Background="{DynamicResource Bg1Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineStrongBrush}" Padding="6" SelectionChanged="ResolutionComboBox_SelectionChanged">
                            <ComboBoxItem Content="Auto Detect (From Card Hardware)" IsSelected="True"/>
                            <ComboBoxItem Content="1080p50 (1920x1080 @ 50.00 fps)"/>
                            <ComboBoxItem Content="1080i50 (Broadcast standard 25.00 fps)"/>
                            <ComboBoxItem Content="1080p59.94 (1920x1080 @ 59.94 fps)"/>
                            <ComboBoxItem Content="1080p60 (1920x1080 @ 60.00 fps)"/>
                            <ComboBoxItem Content="2160p50 (4K UHD 3840x2160 @ 50.00 fps)"/>
                            <ComboBoxItem Content="2160p59.94 (4K UHD 3840x2160 @ 59.94 fps)"/>
                            <ComboBoxItem Content="2160p60 (4K UHD 3840x2160 @ 60.00 fps)"/>
                            <ComboBoxItem Content="720p50 (HD 1280x720 @ 50.00 fps)"/>
                            <ComboBoxItem Content="720p59.94 (HD 1280x720 @ 59.94 fps)"/>
                            <ComboBoxItem Content="1080p25 (1920x1080 @ 25.00 fps)"/>
                            <ComboBoxItem Content="1080p29.97 (1920x1080 @ 29.97 fps)"/>
                            <ComboBoxItem Content="1080p24 (1920x1080 @ 24.00 fps)"/>
                            <ComboBoxItem Content="Custom (User Defined)..."/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Target FPS -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Target FPS:" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="FpsComboBox" Background="{DynamicResource Bg1Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineStrongBrush}" Padding="6" SelectionChanged="FpsComboBox_SelectionChanged">
                            <ComboBoxItem Content="50.00" IsSelected="True"/>
                            <ComboBoxItem Content="59.94"/>
                            <ComboBoxItem Content="60.00"/>
                            <ComboBoxItem Content="25.00"/>
                            <ComboBoxItem Content="29.97"/>
                            <ComboBoxItem Content="24.00"/>
                            <ComboBoxItem Content="23.98"/>
                            <ComboBoxItem Content="Custom..."/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Custom Resolution & Dimensions Panel (shown when Custom is selected) -->
                <Grid x:Name="CustomResolutionPanel" Visibility="Collapsed" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Custom Width (px):" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="CustomWidthTextBox" Background="{DynamicResource Bg1Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineStrongBrush}" Padding="5" Text="1920"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Custom Height (px):" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="CustomHeightTextBox" Background="{DynamicResource Bg1Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineStrongBrush}" Padding="5" Text="1080"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Custom FPS:" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="CustomFpsTextBox" Background="{DynamicResource Bg1Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineStrongBrush}" Padding="5" Text="50.0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Target Bitrate -->
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="BitrateLabel" Text="Bitrate (Mbps):" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="BitrateTextBox" Background="{DynamicResource Bg1Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineStrongBrush}" Padding="6" Text="1500.0"/>
                        <Border x:Name="BitrateBasebandNotice" Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="3" Padding="6,5" Margin="0,2,0,0" Visibility="Collapsed">
                            <TextBlock Text="⚡ Direct Baseband (Uncompressed Hardware DMA)" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- GPU Encoder / Raw Hardware Output -->
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="EncoderLabel" Text="Video Processing / Encoder:" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="GpuEncoderComboBox" Visibility="Collapsed" Background="{DynamicResource Bg1Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineStrongBrush}" Padding="6">
                            <ComboBoxItem Content="NVENC H.264 (CUDA)" IsSelected="True"/>
                            <ComboBoxItem Content="NVENC H.265/HEVC (CUDA)"/>
                            <ComboBoxItem Content="Intel QSV H.264"/>
                            <ComboBoxItem Content="Intel QSV H.265/HEVC"/>
                            <ComboBoxItem Content="AMD AMF H.264 (VCE)"/>
                            <ComboBoxItem Content="AMD AMF H.265/HEVC"/>
                            <ComboBoxItem Content="Software x264 (CPU)"/>
                            <ComboBoxItem Content="Software x265 (CPU)"/>
                        </ComboBox>
                        <Border x:Name="CardHardwareNotice" Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource GoodBrush}" BorderThickness="1" CornerRadius="3" Padding="6,5" VerticalAlignment="Center">
                            <TextBlock Text="⚡ Direct Uncompressed (Raw PCIe DMA - No NVENC needed)" Foreground="{DynamicResource GoodBrush}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>


                <!-- DVB / SCTE & Custom PIDs -->
                <Border Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="DVB SI/PSI &amp; SCTE-35 TS PARAMETERS" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="DvbCompliantCheckBox" Content="Enforce DVB SI/PSI Specs" IsChecked="True" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" x:Name="Scte35CheckBox" Content="Inject SCTE-35 Splices" IsChecked="True" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SERVICE ID" Foreground="{DynamicResource MutedBrush}" FontSize="9"/>
                                <TextBox x:Name="ServiceIdTextBox" Background="{DynamicResource Bg2Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineBrush}" Padding="3" Text="101" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PMT PID" Foreground="{DynamicResource MutedBrush}" FontSize="9"/>
                                <TextBox x:Name="PmtPidTextBox" Background="{DynamicResource Bg2Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineBrush}" Padding="3" Text="256" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="VIDEO PID" Foreground="{DynamicResource MutedBrush}" FontSize="9"/>
                                <TextBox x:Name="VideoPidTextBox" Background="{DynamicResource Bg2Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineBrush}" Padding="3" Text="257" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="AUDIO PID" Foreground="{DynamicResource MutedBrush}" FontSize="9"/>
                                <TextBox x:Name="AudioPidTextBox" Background="{DynamicResource Bg2Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineBrush}" Padding="3" Text="258" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="PCR PID" Foreground="{DynamicResource MutedBrush}" FontSize="9"/>
                                <TextBox x:Name="PcrPidTextBox" Background="{DynamicResource Bg2Brush}" Foreground="#FFFFFF" BorderBrush="{DynamicResource LineBrush}" Padding="3" Text="257" FontSize="10"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Background="{DynamicResource LineBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource LineBrush}" Padding="16,8" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="Create Output Channel" Click="Create_Click" Background="#522B70" BorderBrush="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" Padding="20,8" Cursor="Hand"/>
        </StackPanel>
    </Grid>
    </Grid>
    </Border>
</Window>
