<Window x:Class="Kashtrix.OutputEngine.InspectOutputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Broadcast Output Inspector &amp; Diagnostics"
        Width="850" Height="620"
        WindowStartupLocation="CenterOwner"
        Icon="/Branding/kashtrix-outputengine.ico"
        Background="{DynamicResource Bg0Brush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="{DynamicResource LineStrongBrush}"
        BorderThickness="1">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Border Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="5">
    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Margin="-16,0,-16,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0,4,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="/Branding/kashtrix-outputengine.png" Width="26" Height="26" Margin="0,0,9,0" Stretch="Uniform"/>
                <TextBlock Grid.Column="1" Text="KASHTRIX OUTPUT ENGINE  •  OUTPUT INSPECTOR" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Click="Close_Click" Style="{StaticResource WindowCloseButton}" ToolTip="Close"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button>
            </Grid>
        </Border>

        <!-- Header -->
        <Border Grid.Row="1" Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{Binding StatusColorBrush}" CornerRadius="10" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DestinationUri}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="22,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{Binding StatusColorBrush}" CornerRadius="3" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusBadgeText}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Bg1Brush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Grid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Real-Time Stream Parameters & Health -->
            <Border Grid.Column="0" Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource Bg3Brush}" BorderThickness="1" CornerRadius="4" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="REALTIME CADENCE &amp; STREAM METRICS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                        
                        <!-- Alert Box (if present) -->
                        <Border Visibility="{Binding HasAlert, Converter={StaticResource BoolToVis}}" Background="#332200" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="⚠ ACTIVE SYSTEM ALERT" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding AlertMessage}" TextWrapping="Wrap" Foreground="#FDE68A" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RUNNING FPS" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding FormattedFps}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource GoodBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TARGET FPS" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding TargetFps, StringFormat={}{0:0.00} fps}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="FRAMES SENT" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding FormattedFrames}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DROPPED FRAMES" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding DroppedFrames, StringFormat={}{0:N0}}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource OnAirBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="OUTPUT BITRATE" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding FormattedBitrate}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PCR JITTER" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding PcrJitterNs, StringFormat={}{0:0.0} ns}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="HARDWARE DMA BUFFER HEALTH" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,3"/>
                        <ProgressBar Value="{Binding BufferPercent, Mode=OneWay}" Height="12" Foreground="{DynamicResource GoodBrush}" Background="{DynamicResource Bg3Brush}" BorderThickness="0"/>
                        <TextBlock Text="{Binding BufferPercent, StringFormat={}{0}% Full}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" Margin="0,2,0,8"/>

                        <Separator Background="{DynamicResource Bg3Brush}" Margin="0,6"/>

                        <TextBlock Text="DVB TRANSPORT STREAM PIDS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,6"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Service ID:" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding ServiceId}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="PMT PID:" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding PmtPid, StringFormat={}0x{0:X4} ({0})}" Foreground="{DynamicResource TextBrush}" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Video PID:" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding VideoPid, StringFormat={}0x{0:X4} ({0})}" Foreground="{DynamicResource TextBrush}" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Audio PID:" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding AudioPid, StringFormat={}0x{0:X4} ({0})}" Foreground="{DynamicResource TextBrush}" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="PCR PID:" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding PcrPid, StringFormat={}0x{0:X4} ({0})}" Foreground="{DynamicResource TextBrush}" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="SCTE-35 PID:" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="{Binding Scte35Pid, StringFormat={}0x{0:X4} ({0})}" Foreground="{DynamicResource TextBrush}" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: SCTE-35 / MOS / Direct Live Log -->
            <Border Grid.Column="2" Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource Bg3Brush}" BorderThickness="1" CornerRadius="4" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="SIGNALING &amp; REALTIME EVENT LOG" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>

                    <!-- Action Controls for this Output -->
                    <Border Grid.Row="1" Background="#261A35" BorderBrush="#3E2A54" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,10">
                        <WrapPanel>
                            <Button Content="SEND MOS CUE" Click="SendMos_Click" Background="{DynamicResource Bg3Brush}" Foreground="{DynamicResource TextBrush}" Height="26" Padding="10,0" Margin="0,0,8,0"/>
                            <Button Content="CLEAR ALERTS" Click="ClearAlert_Click" Background="{DynamicResource Bg3Brush}" Foreground="{DynamicResource TextBrush}" Height="26" Padding="10,0"/>
                        </WrapPanel>
                    </Border>

                    <!-- Real-Time Output Log List -->
                    <ListBox Grid.Row="2" x:Name="LogListBox" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource Bg3Brush}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{Binding LevelColorBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="10.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <Grid>
                <TextBlock Text="ETSI TR 101 290 Priority 1/2/3 Verification: PASS · DVB-TS / SCTE-35 / MOS 2.8.4 Compliant" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <Button Content="CLOSE INSPECTOR" HorizontalAlignment="Right" Width="140" Height="28" Background="{DynamicResource Bg3Brush}" Foreground="{DynamicResource TextBrush}" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
