<Window x:Class="Kashtrix.OutputEngine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Kashtrix.OutputEngine.Models"
        Title="Kashtrix Output Engine - Master Multi-Protocol Broadcast &amp; Streaming Center"
        Height="880" Width="1400"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="/Branding/kashtrix-outputengine.ico"
        Background="{DynamicResource Bg0Brush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#38264A"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Bg0Brush}">
        <Grid.RowDefinitions>
            <!-- Top Bar: Title & Stats summary -->
            <RowDefinition Height="Auto"/>
            <!-- KPI Status Metrics Strip -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content: Outputs Grid & Detail/Log Split -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Bg2Brush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Width="36" Height="36" Margin="0,0,12,0" Padding="3">
                        <Image Source="/Branding/kashtrix-outputengine.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="KASHTRIX" FontWeight="Black" FontSize="17" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text=" OUTPUT ENGINE" FontWeight="Bold" FontSize="17" Foreground="{DynamicResource AccentBrush}"/>
                            <Border Background="#251B31" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Text="DVB SI/PSI COMPLIANT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource GoodBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Hardware Baseband (DeckLink, Matrox, AJA) &amp; Multi-Protocol Streaming (NDI, DVB-TS UDP, SRT, RTMP, HLS, MPD, RTSP)" 
                                   FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button Content="＋ Add Output" Click="AddOutput_Click" Style="{StaticResource ActionButtonStyle}" Background="#522B70" BorderBrush="{DynamicResource AccentBrush}" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                    <Button Content="▶ Start All" Click="StartAll_Click" Style="{StaticResource ActionButtonStyle}" Background="#173324" BorderBrush="{DynamicResource GoodBrush}" Foreground="{DynamicResource GoodBrush}" Margin="0,0,8,0"/>
                    <Button Content="⏹ Stop All" Click="StopAll_Click" Style="{StaticResource ActionButtonStyle}" Background="#3D2111" BorderBrush="#C76E2A" Foreground="{DynamicResource TextBrush}" Margin="0,0,8,0"/>
                    <Button Content="🗑 Clear Logs" Click="ClearLogs_Click" Style="{StaticResource ActionButtonStyle}" Background="#20262C" BorderBrush="#3A444D" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <!-- Window Chrome Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="Minimize_Click" Style="{StaticResource WindowControlButton}" ToolTip="Minimize"><TextBlock Style="{StaticResource WindowMinimizeGlyph}"/></Button>
                    <Button Click="Maximize_Click" Style="{StaticResource WindowControlButton}" ToolTip="Maximize / Restore"><TextBlock Style="{StaticResource WindowMaximizeGlyph}"/></Button>
                    <Button Click="Close_Click" Style="{StaticResource WindowCloseButton}" ToolTip="Close"><TextBlock Style="{StaticResource WindowCloseGlyph}"/></Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI SUMMARY STRIP -->
        <Border Grid.Row="1" Background="{DynamicResource Bg1Brush}" Padding="12,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Active Feeds -->
                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE OUTPUTS" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ActiveOutputsText" Text="10 / 10 ONLINE" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource GoodBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Bitrate -->
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="AGGREGATE EGRESS" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AggregateBitrateText" Text="55.80 Mbps" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Frames -->
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTAL FRAMES TRANSMITTED" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalFramesText" Text="142,500 f" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Dropped Frames -->
                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="DROPPED FRAMES (QoS)" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DroppedFramesText" Text="0 f (0.00%)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource GoodBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- DVB SI/PSI State -->
                <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="DVB SI/PSI &amp; PCR STATUS" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DvbStatusText" Text="LOCKED &lt;1.8ms" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource GoodBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- SCTE-35 / MOS Engine -->
                <Border Grid.Column="5" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="SCTE-35 / MOS STATUS" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ScteStatusText" Text="READY (DPI Enabled)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN SPLIT: OUTPUTS MATRIX & LOGS -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- TOP HALF: OUTPUTS MATRIX -->
            <Border Grid.Row="0" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource Bg3Brush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Outputs Header Strip -->
                    <Border Grid.Row="0" Background="{DynamicResource Bg3Brush}" Padding="12,8" CornerRadius="5,5,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="BROADCAST OUTPUT STREAMS &amp; HARDWARE CHANNELS" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" FontSize="13"/>
                            <Border Grid.Column="1" Width="360" Height="202" HorizontalAlignment="Right" Margin="12,0" Background="#05080C" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="4" ClipToBounds="True" ToolTip="Program confidence monitor from Kashtrix Playout virtual output">
                                <Grid>
                                    <Image x:Name="ProgramPreviewImage" Stretch="Uniform"/>
                                    <!-- Live Badge Top-Left -->
                                    <Border x:Name="ProgramLiveBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#374151" CornerRadius="2" Padding="5,1" Margin="6,5,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ProgramLiveDot" Width="6" Height="6" Fill="#9CA3AF" Margin="0,0,4,0"/>
                                            <TextBlock x:Name="ProgramLiveText" Text="PGM STANDBY" FontSize="8.5" FontWeight="Black" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Bottom Label -->
                                    <Border VerticalAlignment="Bottom" Background="#CC090D11" Padding="0,2">
                                        <TextBlock x:Name="ProgramMonitorLabel" Text="PLAYOUT PROGRAM BUS · CONFIDENCE MONITOR" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="8" FontWeight="SemiBold" Foreground="#DCC7F0"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="2" Text="Click '!' icon for real-time channel diagnostics" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Outputs DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="OutputsDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Background="{DynamicResource Bg1Brush}"
                              RowBackground="{DynamicResource Bg1Brush}"
                              AlternatingRowBackground="#1D1629"
                              Foreground="{DynamicResource TextBrush}"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource Bg3Brush}"
                              HeadersVisibility="Column"
                              FontSize="12"
                              RowHeight="36">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Alert Icon Column (!) -->
                            <DataGridTemplateColumn Header="ALERT" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:OutputChannel">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Click="InspectAlert_Click"
                                                    Cursor="Hand"
                                                    Width="26" Height="26"
                                                    BorderThickness="0"
                                                    ToolTip="{Binding AlertMessage}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="AlertBorder" CornerRadius="13" Background="{DynamicResource LineStrongBrush}">
                                                                        <TextBlock Text="!" FontWeight="Black" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding HasAlert}" Value="True">
                                                                            <Setter TargetName="AlertBorder" Property="Background" Value="{DynamicResource OnAirBrush}"/>
                                                                            <Setter TargetName="AlertBorder" Property="Effect">
                                                                                <Setter.Value>
                                                                                    <DropShadowEffect Color="{DynamicResource Red}" BlurRadius="6" ShadowDepth="0"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Opacity" Value="0.8"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Channel Name -->
                            <DataGridTemplateColumn Header="CHANNEL FEED" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:OutputChannel">
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding DestinationUri}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="INPUT SOURCE" Width="155">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:OutputChannel">
                                        <TextBlock Text="{Binding InputSourceDisplayName}" FontWeight="SemiBold" FontSize="10" Foreground="#D7B8F9" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Protocol Badge -->
                            <DataGridTemplateColumn Header="PROTOCOL / TYPE" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:OutputChannel">
                                        <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource Bg3Brush}">
                                            <TextBlock Text="{Binding ProtocolDisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- State -->
                            <DataGridTemplateColumn Header="STATUS" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:OutputChannel">
                                        <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource LineStrongBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Online">
                                                            <Setter Property="Background" Value="#065F46"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                            <Setter Property="Background" Value="#854D0E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter Property="Background" Value="#991B1B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Starting">
                                                            <Setter Property="Background" Value="#0E7490"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- FPS -->
                            <DataGridTemplateColumn Header="FPS (ACT / TGT)" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:OutputChannel">
                                        <TextBlock Text="{Binding FormattedFps}" FontWeight="Bold" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Total Frames -->
                            <DataGridTextColumn Header="FRAMES SENT" Binding="{Binding FormattedFrames, Mode=OneWay}" Width="105"/>

                            <!-- Dropped Frames -->
                            <DataGridTemplateColumn Header="DROPPED" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:OutputChannel">
                                        <TextBlock Text="{Binding DroppedFrames, StringFormat={}{0:N0}}" VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DroppedFrames, ConverterParameter=0}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource OnAirBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Bitrate -->
                            <DataGridTextColumn Header="BITRATE" Binding="{Binding FormattedBitrate, Mode=OneWay}" Width="150"/>

                            <!-- PCR Jitter -->
                            <DataGridTextColumn Header="PCR JITTER" Binding="{Binding PcrJitterNs, StringFormat={}{0:F1} ns}" Width="95"/>

                            <!-- Features: DVB / SCTE-35 -->
                            <DataGridTemplateColumn Header="STANDARDS" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:OutputChannel">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="2" Padding="4,1" Margin="0,0,4,0" Background="#3E2359">
                                                <TextBlock Text="DVB" FontSize="10" FontWeight="Bold" Foreground="#DCC7F0"/>
                                            </Border>
                                            <Border CornerRadius="2" Padding="4,1" Background="#581C87">
                                                <TextBlock Text="SCTE-35" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PinkBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Controls -->
                            <DataGridTemplateColumn Header="ACTIONS" Width="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="models:OutputChannel">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="START" Click="StartChannel_Click" Style="{StaticResource ActionButtonStyle}" Padding="7,2" Margin="0,0,3,0" FontSize="10"/>
                                            <Button Content="STOP" Click="StopChannel_Click" Style="{StaticResource ActionButtonStyle}" Padding="7,2" Margin="0,0,3,0" FontSize="10"/>
                                            <Button Content="RESTART" Click="RestartChannel_Click" Style="{StaticResource ActionButtonStyle}" Padding="7,2" Margin="0,0,3,0" FontSize="10"/>
                                            <Button Content="DELETE" Click="DeleteChannel_Click" Style="{StaticResource ActionButtonStyle}" Background="#4A1717" Padding="7,2" Margin="0,0,3,0" FontSize="10"/>
                                            <Button Content="INSPECT" Click="InspectAlert_Click" Style="{StaticResource ActionButtonStyle}" Background="{DynamicResource LineStrongBrush}" Padding="7,2" FontSize="10"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource Bg3Brush}" Cursor="SizeNS"/>

            <!-- BOTTOM HALF: LOGS & SCTE-35 / MOS MONITOR -->
            <Border Grid.Row="2" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource Bg3Brush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Log Filter Tabs -->
                    <Border Grid.Row="0" Background="{DynamicResource Bg3Brush}" Padding="12,6" CornerRadius="5,5,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="TELEMETRY &amp; STANDARDS LOGS:" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <RadioButton x:Name="TabAll" Content="All Output Events" Checked="Filter_Changed" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton x:Name="TabDvb" Content="DVB SI/PSI &amp; UDP" Checked="Filter_Changed" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton x:Name="TabScte35" Content="SCTE-35 Splice Triggers" Checked="Filter_Changed" Foreground="{DynamicResource PinkBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton x:Name="TabMos" Content="MOS 2.8.4 Gateway" Checked="Filter_Changed" Foreground="{DynamicResource GoodBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton x:Name="TabHlsMpd" Content="HLS / MPD Segments" Checked="Filter_Changed" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" x:Name="LogCountText" Text="Events: 0" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Realtime Log List -->
                    <ListBox Grid.Row="1" x:Name="LogListBox"
                             Background="{DynamicResource Bg0Brush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderThickness="0"
                             FontFamily="Consolas, Courier New, monospace"
                             FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:BroadcastEventLog">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <!-- Timestamp -->
                                    <TextBlock Text="{Binding Timestamp, StringFormat={}[{0:HH:mm:ss.fff}]}" Foreground="{DynamicResource MutedBrush}" Width="100"/>
                                    <!-- Category Badge -->
                                    <Border CornerRadius="2" Padding="4,1" Margin="0,0,8,0" Width="80">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Bg3Brush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="DVB">
                                                        <Setter Property="Background" Value="#0369A1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="SCTE-35">
                                                        <Setter Property="Background" Value="#6D28D9"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="MOS">
                                                        <Setter Property="Background" Value="#047857"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="HLS/MPD">
                                                        <Setter Property="Background" Value="#B45309"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="ALERT">
                                                        <Setter Property="Background" Value="#B91C1C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    </Border>
                                    <!-- Channel -->
                                    <TextBlock Text="{Binding ChannelName}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" Width="160" TextTrimming="CharacterEllipsis"/>
                                    <!-- Log Message -->
                                    <TextBlock Text="{Binding Message}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource OnAirBrush}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource Bg3Brush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="ENGINE: " FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="Kashtrix Broadcast Engine v4.9H Multi-Protocol Out" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text=" | DVB-SI Tables: PAT(0x00) PMT(0x100) SDT(0x11) NIT(0x10) TDT(0x14)" FontSize="11" Foreground="{DynamicResource GoodBrush}" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Timecode: " FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock x:Name="MasterTimecodeText" Text="00:00:00:00" FontSize="11" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
