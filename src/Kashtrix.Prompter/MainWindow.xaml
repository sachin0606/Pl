<Window x:Class="Kashtrix.Prompter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kashtrix Prompter" Width="1760" Height="980" MinWidth="1240" MinHeight="760"
        Background="#05070A" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseWheel="Window_PreviewMouseWheel" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>

        <Border Background="#0B0F16" BorderBrush="#39204D" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="380"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="KASHTRIX PROMPTER · OPERATOR" FontSize="23" FontWeight="Bold" Foreground="#E6C4FF"/>
                    <TextBlock x:Name="StoryHeader" Text="No story selected" Foreground="#AAB2BD"/>
                </StackPanel>
                <ComboBox Grid.Column="1" x:Name="RundownBox" DisplayMemberPath="Name" SelectionChanged="RundownBox_SelectionChanged" VerticalAlignment="Center" Margin="10"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="FollowLiveCheck" Content="FOLLOW NRCS LIVE" IsChecked="True" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="REFRESH" Click="Refresh_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="—" Width="34" Height="28" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Content="□" Width="34" Height="28" Click="Maximize_Click" ToolTip="Maximize / Restore"/>
                    <Button Content="✕" Width="34" Height="28" Click="Close_Click" Foreground="#FF8D8D" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>

            <Border Background="#0B0F16" BorderBrush="#30223F" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="RUN ORDER" Foreground="White" FontWeight="Bold" FontSize="15"/>
                        <TextBlock x:Name="RunOrderStatusText" Foreground="#AAB2BD" FontSize="11"/>
                    </StackPanel>
                    <DataGrid x:Name="StoryList" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="StoryList_SelectionChanged" Background="#05070A">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="38"/>
                            <DataGridTextColumn Header="SLUG" Binding="{Binding Slug}" Width="*"/>
                            <DataGridTextColumn Header="DUR" Binding="{Binding DurationSeconds}" Width="55"/>
                            <DataGridCheckBoxColumn Header="SKIP" Binding="{Binding IsSkipped}" Width="48"/>
                            <DataGridCheckBoxColumn Header="LIVE" Binding="{Binding IsLive}" Width="45"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#020305" BorderBrush="#39204D" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                <Grid>
                    <ContentControl x:Name="PreviewHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#8039204D" BorderThickness="1" IsHitTestVisible="False">
                        <TextBlock x:Name="PreviewModeText" Text="OPERATOR PREVIEW" Foreground="#90AAB2BD" Padding="8,4"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#0B0F16" BorderBrush="#30223F" BorderThickness="1" CornerRadius="4" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="OUTPUT / PROMPT ENGINE" Foreground="#E6C4FF" FontSize="17" FontWeight="Bold"/>

                        <TextBlock Text="MODE" Foreground="#AAB2BD" Margin="0,12,0,4"/>
                        <ComboBox x:Name="PromptModeBox" SelectionChanged="PromptSetting_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="CARD ◀" Width="90" Click="PreviousCard_Click"/>
                            <Button Content="CARD ▶" Width="90" Margin="8,0,0,0" Click="NextCard_Click"/>
                            <TextBlock x:Name="CardStatusText" Foreground="#AAB2BD" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="LOCAL DISPLAY" Foreground="#AAB2BD" Margin="0,14,0,4"/>
                        <ComboBox x:Name="DisplayBox"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="OPEN / UPDATE DISPLAY" Click="OpenDisplay_Click"/><Button Content="CLOSE DISPLAY" Click="CloseDisplay_Click" Margin="8,0,0,0"/></StackPanel>

                        <TextBlock Text="NDI OUTPUT NAME" Foreground="#AAB2BD" Margin="0,14,0,4"/>
                        <TextBox x:Name="NdiNameBox" Text="KASHTRIX-PROMPTER-01"/>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="RESOLUTION" Foreground="#AAB2BD"/><ComboBox x:Name="ResolutionBox"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="FPS" Foreground="#AAB2BD"/><ComboBox x:Name="FpsBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="SAFE MARGIN" Foreground="#AAB2BD"/><TextBox x:Name="SafeMarginBox" Text="80"/></StackPanel></Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="NdiToggleButton" Content="START NDI" Click="ToggleNdi_Click"/><TextBlock x:Name="NdiStatusText" Text="NDI OFF" Foreground="#AAB2BD" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/></StackPanel>

                        <TextBlock Text="SDI / DECKLINK OUTPUT" Foreground="#AAB2BD" Margin="0,14,0,4"/>
                        <ComboBox x:Name="DeckLinkBox" DisplayMemberPath="Label"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="DeckLinkToggleButton" Content="START SDI" Click="ToggleDeckLink_Click"/><TextBlock x:Name="DeckLinkStatusText" Text="SDI OFF" Foreground="#AAB2BD" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/></StackPanel>

                        <TextBlock Text="PRESENTER PROFILE" Foreground="#AAB2BD" Margin="0,14,0,4"/>
                        <StackPanel Orientation="Horizontal"><Button Content="APPLY PROFILE" Click="ApplyPresenterProfile_Click"/><Button Content="SAVE PROFILE" Click="SavePresenterProfile_Click" Margin="8,0,0,0"/></StackPanel>

                        <TextBlock Text="REMOTE CONTROL (UDP)" Foreground="#AAB2BD" Margin="0,14,0,4"/>
                        <StackPanel Orientation="Horizontal"><TextBox x:Name="RemotePortBox" Text="7788" Width="80"/><Button x:Name="RemoteToggleButton" Content="START REMOTE" Click="ToggleRemote_Click" Margin="8,0,0,0"/><TextBlock x:Name="RemoteStatusText" Text="OFF" Foreground="#AAB2BD" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>

                        <Border Background="#10141B" BorderBrush="#4B286A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="STORY PRODUCTION / MOS" Foreground="#F0C8FF" FontWeight="Bold"/>
                                <TextBlock Text="WinPlus-style live context: story, graphics, layers, media and automation stay visible while prompting." Foreground="#7F8A98" FontSize="9.5" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                <TextBlock Text="PLAYOUT CHANNEL" Foreground="#AAB2BD"/><ComboBox x:Name="ChannelBox" DisplayMemberPath="ChannelName" Margin="0,3,0,6"/>
                                <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="CG TEMPLATE" Foreground="#8E9AA6"/><TextBlock Grid.Column="1" x:Name="CgTemplateText" Text="—" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Text="CG LAYER" Foreground="#8E9AA6"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="CgLayerText" Text="—" Foreground="#F0C8FF"/>
                                    <TextBlock Grid.Row="2" Text="MEDIA" Foreground="#8E9AA6"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="MediaPathText" Text="—" Foreground="#D5DAE0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                    <TextBlock Grid.Row="3" Text="MOS DATA" Foreground="#8E9AA6"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="MosDataText" Text="—" Foreground="#9EC7FF" TextWrapping="Wrap" MaxHeight="58"/>
                                </Grid>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="CG PREVIEW" Click="TriggerCgPreview_Click"/>
                                    <Button Content="CG PROGRAM" Click="TriggerCgProgram_Click" Margin="6,0,0,0"/>
                                    <Button Content="PLAY STORY" Click="PlayStory_Click" Margin="6,0,0,0"/>
                                    <Button Content="NEXT" Click="PlayoutNext_Click" Margin="6,0,0,0"/>
                                    <Button Content="STOP" Click="PlayoutStop_Click" Margin="6,0,0,0"/>
                                </WrapPanel>
                                <CheckBox x:Name="AutoMosCheck" Content="TAKE LIVE triggers story playout + PROGRAM CG" IsChecked="True" Foreground="#E8D8F4" Margin="0,7,0,0"/>
                                <TextBlock x:Name="ProductionStatusText" Text="Automation idle" Foreground="#8EA0AE" FontSize="9.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SHOW SAFETY / OPERATOR TOOLS" Foreground="#AAB2BD" Margin="0,14,0,4"/>
                        <WrapPanel>
                            <Button Content="LOAD EMERGENCY TXT / RTF" Click="LoadEmergencyScript_Click"/>
                            <Button Content="RETURN TO NRCS" Click="ReturnToNrcs_Click" Margin="6,0,0,0"/>
                            <Button Content="EXPORT SRT / CC" Click="ExportSrt_Click" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,7,0,0">
                            <Button Content="+ BOOKMARK" Click="AddBookmark_Click"/>
                            <Button Content="BOOKMARK ◀" Click="PreviousBookmark_Click" Margin="6,0,0,0"/>
                            <Button Content="BOOKMARK ▶" Click="NextBookmark_Click" Margin="6,0,0,0"/>
                            <TextBlock x:Name="BookmarkStatusText" Text="0 bookmarks" Foreground="#AAB2BD" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </WrapPanel>
                        <TextBlock x:Name="OfflineStatusText" Text="NRCS SCRIPT MODE" Foreground="#7F8A98" FontSize="10" Margin="0,6,0,0"/>

                        <Separator Margin="0,14"/>
                        <TextBlock Text="PRESENTER VIEW" Foreground="#E6C4FF" FontWeight="Bold"/>
                        <CheckBox x:Name="MirrorCheck" Content="Horizontal mirror (beamsplitter)" Foreground="White" Margin="0,8,0,0" Checked="PromptSetting_Changed" Unchecked="PromptSetting_Changed"/>
                        <CheckBox x:Name="FlipCheck" Content="Vertical flip" Foreground="White" Margin="0,6,0,0" Checked="PromptSetting_Changed" Unchecked="PromptSetting_Changed"/>
                        <CheckBox x:Name="InvertCheck" Content="Invert black/white" Foreground="White" Margin="0,6,0,0" Checked="PromptSetting_Changed" Unchecked="PromptSetting_Changed"/>
                        <CheckBox x:Name="RtlCheck" Content="Right-to-left script layout" Foreground="White" Margin="0,6,0,0" Checked="PromptSetting_Changed" Unchecked="PromptSetting_Changed"/>
                        <CheckBox x:Name="HeaderCheck" Content="Show story/presenter header" Foreground="White" Margin="0,6,0,0" Checked="PromptSetting_Changed" Unchecked="PromptSetting_Changed"/>
                        <CheckBox x:Name="ClockCheck" Content="Show clock" Foreground="White" Margin="0,6,0,0" Checked="PromptSetting_Changed" Unchecked="PromptSetting_Changed"/>
                        <CheckBox x:Name="TimerCheck" Content="Show elapsed timer" Foreground="White" Margin="0,6,0,0" Checked="PromptSetting_Changed" Unchecked="PromptSetting_Changed"/>
                        <CheckBox x:Name="BlankCheck" Content="BLANK OUTPUT" Foreground="#FFB8B8" FontWeight="Bold" Margin="0,8,0,0" Checked="PromptSetting_Changed" Unchecked="PromptSetting_Changed"/>

                        <TextBlock Text="ON-SCREEN MESSAGE" Foreground="#AAB2BD" Margin="0,12,0,4"/>
                        <TextBox x:Name="MessageBox" TextChanged="MessageBox_TextChanged"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="CLEAR MESSAGE" Click="ClearMessage_Click"/><Button Content="RESET TIMER" Click="ResetTimer_Click" Margin="8,0,0,0"/></StackPanel>

                        <Separator Margin="0,14"/>
                        <TextBlock Text="FONT SIZE" Foreground="#AAB2BD"/><Slider x:Name="FontSlider" Minimum="28" Maximum="120" Value="58" ValueChanged="PromptSetting_Changed"/>
                        <TextBlock Text="LINE SPACING" Foreground="#AAB2BD" Margin="0,8,0,0"/><Slider x:Name="LineSpacingSlider" Minimum="1.0" Maximum="1.8" Value="1.30" ValueChanged="PromptSetting_Changed"/>
                        <TextBlock Text="SCROLL SPEED" Foreground="#AAB2BD" Margin="0,8,0,0"/><Slider x:Name="SpeedSlider" Minimum="0.1" Maximum="8" Value="1.4"/>
                        <TextBlock Text="Mouse wheel / Up-Down changes speed · Space starts/stops · PageUp/PageDown changes story" Foreground="#7F8A98" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0B0F16" BorderBrush="#39204D" BorderThickness="0,1,0,0">
            <Grid Margin="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Content="◀ PREVIOUS STORY" Width="150" Click="Previous_Click"/>
                <Button Grid.Column="1" x:Name="StartStopButton" Content="START PROMPT" Width="145" Margin="8,0" Click="StartStop_Click"/>
                <Button Grid.Column="2" Content="NEXT STORY ▶" Width="150" Click="Next_Click"/>
                <Button Grid.Column="3" Content="TAKE THIS LIVE" Width="135" Margin="8,0,0,0" Click="TakeLive_Click"/>
                <Button Grid.Column="4" x:Name="CloakButton" Content="CLOAK / UNCLOAK" Width="135" Margin="8,0,0,0" Click="ToggleCloak_Click"/>
                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="SCROLL " Foreground="#AAB2BD"/><TextBlock x:Name="ScrollStatusText" Foreground="White" FontWeight="Bold"/></StackPanel>
                <TextBlock Grid.Column="6" x:Name="OutputStatusText" Text="Preview ready" Foreground="#AAB2BD" VerticalAlignment="Center" TextAlignment="Right" MaxWidth="420" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
